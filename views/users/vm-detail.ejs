<%- include('../components/header', { title: 'Virtual Machine Details' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Area -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    
    <!-- Top Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Virtual Machines', href: '/vms' },
      { label: 'VM #' + vmId }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      
      <!-- VM Header Area -->
      <div id="vmHeaderContainer" class="al-card p-4 sm:p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Title & Status -->
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background:var(--theme-bg-secondary, #212121); border:1px solid var(--theme-border, rgba(255,255,255,0.1)); color:var(--theme-accent, #fafafa)">
            <%- icon('server', { class: 'w-5 h-5' }) %>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2.5">
              <h1 id="headerVMName" class="text-lg font-semibold tracking-tight truncate" style="color:var(--theme-text-strong, #fafafa)">
                Loading VM...
              </h1>
              <div id="headerStatusBadge">
                <span class="al-badge-offline"><span class="al-dot-offline"></span>Checking</span>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-1 text-xs" style="color:var(--theme-text-muted, #8a8a8a)">
              <span class="font-mono text-[11px]" id="headerVMId">#<%= vmId %></span>
              <span>•</span>
              <span id="headerOSType">Virtual Instance</span>
              <span>•</span>
              <span class="flex items-center gap-1 font-mono text-[11px]" id="headerPort">Port —</span>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="flex items-center gap-2 flex-wrap" id="headerActionButtons">
          <a href="/vm/<%= vmId %>/console" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('terminal', { class: 'w-3.5 h-3.5' }) %>
            <span>Console</span>
          </a>
          <a href="/vm/<%= vmId %>/ssh" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('hash', { class: 'w-3.5 h-3.5' }) %>
            <span>SSH</span>
          </a>
          <button id="btnStart" onclick="doAction('start')" class="al-btn-success text-xs flex items-center gap-1.5 py-1.5 px-3 hidden">
            <%- icon('play', { class: 'w-3.5 h-3.5' }) %>
            <span>Start</span>
          </button>
          <button id="btnStop" onclick="doAction('stop')" class="al-btn-danger text-xs flex items-center gap-1.5 py-1.5 px-3 hidden">
            <%- icon('square', { class: 'w-3.5 h-3.5' }) %>
            <span>Stop</span>
          </button>
          <button id="btnRestart" onclick="doAction('restart')" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3 hidden">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5' }) %>
            <span>Restart</span>
          </button>
        </div>
      </div>

      <!-- Quick Metrics Row -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="al-card p-3.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Processor</span>
            <%- icon('cpu', { class: 'w-3.5 h-3.5', style: 'color:var(--theme-text-muted)' }) %>
          </div>
          <p id="metricCores" class="text-xl font-semibold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <p id="metricCpuDetail" class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">Virtual cores</p>
        </div>

        <div class="al-card p-3.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Memory</span>
            <%- icon('layers', { class: 'w-3.5 h-3.5', style: 'color:var(--theme-text-muted)' }) %>
          </div>
          <p id="metricRAM" class="text-xl font-semibold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <p id="metricRAMDetail" class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">Dedicated RAM</p>
        </div>

        <div class="al-card p-3.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Disk Storage</span>
            <%- icon('hard-drive', { class: 'w-3.5 h-3.5', style: 'color:var(--theme-text-muted)' }) %>
          </div>
          <p id="metricDisk" class="text-xl font-semibold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <p id="metricDiskDetail" class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">Primary volume</p>
        </div>

        <div class="al-card p-3.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">IPv4 Address</span>
            <%- icon('globe', { class: 'w-3.5 h-3.5', style: 'color:var(--theme-text-muted)' }) %>
          </div>
          <p id="metricIP" class="text-base font-semibold mt-2 tabular-nums truncate" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <p id="metricNetworkType" class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">Network</p>
        </div>
      </div>

      <!-- Tabbed Information Panel -->
      <div class="al-card overflow-hidden">
        <!-- Tab navigation bar -->
        <div class="flex items-center gap-1 px-4 pt-3 border-b overflow-x-auto" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
          <button type="button" onclick="switchTab('overview')" id="tabBtn-overview"
                  class="px-3.5 py-2 text-xs font-medium border-b-2 border-[var(--theme-accent, #fafafa)] text-[var(--theme-text-strong, #fafafa)] transition-colors flex items-center gap-1.5">
            <%- icon('layout-dashboard', { class: 'w-3.5 h-3.5' }) %>
            <span>Overview</span>
          </button>
          <button type="button" onclick="switchTab('network')" id="tabBtn-network"
                  class="px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-[var(--theme-text-muted, #8a8a8a)] hover:text-[var(--theme-text-strong)] transition-colors flex items-center gap-1.5">
            <%- icon('network', { class: 'w-3.5 h-3.5' }) %>
            <span>Network</span>
          </button>
          <button type="button" onclick="switchTab('hardware')" id="tabBtn-hardware"
                  class="px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-[var(--theme-text-muted, #8a8a8a)] hover:text-[var(--theme-text-strong)] transition-colors flex items-center gap-1.5">
            <%- icon('cpu', { class: 'w-3.5 h-3.5' }) %>
            <span>Hardware</span>
          </button>
          <button type="button" onclick="switchTab('snapshots')" id="tabBtn-snapshots"
                  class="px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-[var(--theme-text-muted, #8a8a8a)] hover:text-[var(--theme-text-strong)] transition-colors flex items-center gap-1.5">
            <%- icon('camera', { class: 'w-3.5 h-3.5' }) %>
            <span>Snapshots</span>
          </button>
          <button type="button" onclick="switchTab('danger')" id="tabBtn-danger"
                  class="px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-red-400 hover:text-red-300 transition-colors flex items-center gap-1.5 ml-auto">
            <%- icon('alert-triangle', { class: 'w-3.5 h-3.5' }) %>
            <span>Danger Zone</span>
          </button>
        </div>

        <!-- Tab contents -->
        <div class="p-4 sm:p-5">
          <!-- Overview Tab -->
          <div id="tabContent-overview" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h3 class="text-xs font-medium uppercase tracking-wider mb-3 text-[var(--theme-text-muted)]">Instance Details</h3>
                <dl class="divide-y divide-[var(--theme-border-subtle)] text-xs">
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">VM Name</dt><dd class="font-medium text-[var(--theme-text-strong)]" id="detailVMName">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Identifier</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="detailVMId">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">OS Template</dt><dd class="font-medium text-[var(--theme-text-strong)]" id="detailOSType">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Hostname</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="detailHostname">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Host Node</dt><dd class="text-[var(--theme-text-strong)]" id="detailNode">Localhost</dd></div>
                </dl>
              </div>

              <div>
                <h3 class="text-xs font-medium uppercase tracking-wider mb-3 text-[var(--theme-text-muted)]">Access & Connectivity</h3>
                <dl class="divide-y divide-[var(--theme-border-subtle)] text-xs">
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">SSH User</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="detailUsername">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">SSH Port</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="detailSSHPort">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Network Type</dt><dd class="text-[var(--theme-text-strong)]" id="detailNetType">—</dd></div>
                  <div class="py-2 flex justify-between"><dt class="text-[var(--theme-text-muted)]">KVM Acceleration</dt><dd id="detailKVM">—</dd></div>
                </dl>
              </div>
            </div>

            <!-- Quick SSH Command Box -->
            <div class="mt-4 p-3.5 rounded-xl border" style="background:var(--theme-bg-secondary, #1e1e1e); border-color:var(--theme-border, rgba(255,255,255,0.1));">
              <span class="text-[11px] font-medium block mb-1.5" style="color:var(--theme-text-muted, #8a8a8a)">Quick SSH Connection</span>
              <div class="flex items-center justify-between gap-3 font-mono text-xs p-2 rounded-lg" style="background:var(--theme-bg, #161616);">
                <span id="sshCommandText" class="truncate text-[var(--theme-text-strong)]">ssh root@localhost -p 2222</span>
                <button type="button" onclick="copySSH()" class="al-btn-secondary py-1 px-2 text-xs shrink-0 flex items-center gap-1">
                  <%- icon('copy', { class: 'w-3 h-3' }) %>
                  <span id="copyBtnText">Copy</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Network Tab -->
          <div id="tabContent-network" class="space-y-4 hidden">
            <div class="max-w-xl">
              <dl class="divide-y divide-[var(--theme-border-subtle)] text-xs">
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">IPv4 Address</dt><dd class="font-mono font-medium text-[var(--theme-text-strong)]" id="netIPv4">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">MAC Address</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="netMAC">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Network Type</dt><dd class="text-[var(--theme-text-strong)]" id="netMode">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">DNS Primary</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="netDNS1">8.8.8.8</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">DNS Secondary</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="netDNS2">1.1.1.1</dd></div>
              </dl>
            </div>
          </div>

          <!-- Hardware Tab -->
          <div id="tabContent-hardware" class="space-y-4 hidden">
            <div class="max-w-xl">
              <dl class="divide-y divide-[var(--theme-border-subtle)] text-xs">
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">CPU Model</dt><dd class="font-mono font-medium text-[var(--theme-text-strong)]" id="hwCPUModel">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Topology</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="hwTopology">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Machine Type</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="hwMachine">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">RAM Size</dt><dd class="font-medium text-[var(--theme-text-strong)]" id="hwRAM">—</dd></div>
                <div class="py-2.5 flex justify-between"><dt class="text-[var(--theme-text-muted)]">Disk Image</dt><dd class="font-mono text-[var(--theme-text-strong)]" id="hwDisk">qcow2</dd></div>
              </dl>
            </div>
          </div>

          <!-- Snapshots Tab -->
          <div id="tabContent-snapshots" class="space-y-4 hidden">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-medium uppercase tracking-wider text-[var(--theme-text-muted)]">VM Snapshots</h3>
              <button type="button" onclick="openSnapshotModal()" class="al-btn-secondary text-xs flex items-center gap-1 py-1 px-2.5">
                <%- icon('camera', { class: 'w-3.5 h-3.5' }) %>
                <span>Create Snapshot</span>
              </button>
            </div>
            <div id="snapshotsListContainer" class="space-y-2">
              <p class="text-xs text-[var(--theme-text-muted)]">Loading snapshots...</p>
            </div>
          </div>

          <!-- Danger Zone Tab -->
          <div id="tabContent-danger" class="space-y-4 hidden">
            <div class="p-4 rounded-xl border border-red-500/20 bg-red-500/5 space-y-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <h4 class="text-xs font-semibold text-red-400">Restart VM</h4>
                  <p class="text-[11px] text-[var(--theme-text-muted)]">Gracefully restart the virtual machine OS.</p>
                </div>
                <button type="button" onclick="doAction('restart')" class="al-btn-secondary text-xs py-1.5 px-3">
                  Restart
                </button>
              </div>

              <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
              <div class="pt-3 border-t border-red-500/20 flex items-center justify-between gap-4">
                <div>
                  <h4 class="text-xs font-semibold text-red-400">Delete Virtual Machine</h4>
                  <p class="text-[11px] text-[var(--theme-text-muted)]">Permanently erase this instance, storage disks, and network allocations.</p>
                </div>
                <button type="button" onclick="deleteVM()" class="al-btn-danger text-xs py-1.5 px-3">
                  Delete VM
                </button>
              </div>
              <% } %>
            </div>
          </div>

        </div>
      </div>

    </main>
  </div>
</div>

<!-- Snapshot Modal -->
<div id="snapshotModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden">
  <div class="al-card max-w-md w-full p-5 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Create Snapshot</h3>
      <button type="button" onclick="closeSnapshotModal()" class="text-[var(--theme-text-muted)] hover:text-white">✕</button>
    </div>
    <form onsubmit="handleCreateSnapshot(event)" class="space-y-3">
      <div>
        <label class="al-label text-xs">Snapshot Name</label>
        <input type="text" id="snapshotName" required class="al-input text-xs" placeholder="Before-Upgrade-01">
      </div>
      <div>
        <label class="al-label text-xs">Description (Optional)</label>
        <input type="text" id="snapshotDesc" class="al-input text-xs" placeholder="Stable state before update">
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeSnapshotModal()" class="al-btn-secondary text-xs py-1.5 px-3">Cancel</button>
        <button type="submit" id="btnSubmitSnapshot" class="al-btn-primary text-xs py-1.5 px-3">Create</button>
      </div>
    </form>
  </div>
</div>

<script>
  const vmId = <%= vmId %>;
  let currentVM = null;

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function switchTab(tab) {
    const tabs = ['overview', 'network', 'hardware', 'snapshots', 'danger'];
    tabs.forEach(t => {
      const btn = document.getElementById('tabBtn-' + t);
      const content = document.getElementById('tabContent-' + t);
      if (!btn || !content) return;

      if (t === tab) {
        btn.className = t === 'danger'
          ? 'px-3.5 py-2 text-xs font-medium border-b-2 border-red-500 text-red-400 transition-colors flex items-center gap-1.5 ml-auto'
          : 'px-3.5 py-2 text-xs font-medium border-b-2 border-[var(--theme-accent, #fafafa)] text-[var(--theme-text-strong, #fafafa)] transition-colors flex items-center gap-1.5';
        content.classList.remove('hidden');
      } else {
        btn.className = t === 'danger'
          ? 'px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-red-400 hover:text-red-300 transition-colors flex items-center gap-1.5 ml-auto'
          : 'px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-[var(--theme-text-muted, #8a8a8a)] hover:text-[var(--theme-text-strong)] transition-colors flex items-center gap-1.5';
        content.classList.add('hidden');
      }
    });
  }

  async function loadVMDetails() {
    try {
      const res = await fetch('/api/vms/' + vmId);
      if (!res.ok) throw new Error('VM not found');
      currentVM = await res.json();
      renderVMDetails(currentVM);
      loadSnapshots();
    } catch (err) {
      console.error(err);
      document.getElementById('headerVMName').textContent = 'Error Loading VM';
    }
  }

  function renderVMDetails(vm) {
    const isRunning = (vm.status || '').toLowerCase() === 'running';

    // Header
    document.getElementById('headerVMName').textContent = vm.vm_name || vm.name || 'VM #' + vmId;
    document.getElementById('headerVMId').textContent = '#' + vmId;
    document.getElementById('headerOSType').textContent = vm.os_type || vm.template_name || 'Standard Linux';
    const port = vm.ssh_port || vm.ssh_port_static || 2222;
    document.getElementById('headerPort').textContent = 'Port ' + port;

    const badge = document.getElementById('headerStatusBadge');
    if (isRunning) {
      badge.innerHTML = `<span class="al-badge-online"><span class="al-dot-online"></span>Online</span>`;
      document.getElementById('btnStart').classList.add('hidden');
      document.getElementById('btnStop').classList.remove('hidden');
      document.getElementById('btnRestart').classList.remove('hidden');
    } else {
      badge.innerHTML = `<span class="al-badge-offline"><span class="al-dot-offline"></span>Offline</span>`;
      document.getElementById('btnStart').classList.remove('hidden');
      document.getElementById('btnStop').classList.add('hidden');
      document.getElementById('btnRestart').classList.add('hidden');
    }

    // Metrics
    const cores = vm.cpu_cores || vm.cpus || vm.cores || 1;
    document.getElementById('metricCores').textContent = cores + ' vCPU';
    document.getElementById('metricCpuDetail').textContent = (vm.cpu_model || 'Host CPU') + ' architecture';

    const ram = vm.memory_mb || vm.memory || 1024;
    document.getElementById('metricRAM').textContent = ram >= 1024 ? (ram / 1024).toFixed(1) + ' GB' : ram + ' MB';

    const disk = vm.disk_size || vm.storage || '20 GB';
    document.getElementById('metricDisk').textContent = disk;

    const ip = vm.ipv4_address || (vm.network_type === 'nat' ? '127.0.0.1 (NAT)' : 'DHCP');
    document.getElementById('metricIP').textContent = ip;
    document.getElementById('metricNetworkType').textContent = vm.network_type === 'nat' ? 'User-Mode NAT' : 'Bridged IPv4';

    // Overview Tab Details
    document.getElementById('detailVMName').textContent = vm.vm_name || vm.name || 'VM #' + vmId;
    document.getElementById('detailVMId').textContent = '#' + vmId;
    document.getElementById('detailOSType').textContent = vm.os_type || vm.template_name || 'Generic';
    document.getElementById('detailHostname').textContent = vm.hostname || (vm.vm_name ? vm.vm_name.toLowerCase().replace(/[^a-z0-9]/g, '-') : 'vm-' + vmId);
    document.getElementById('detailUsername').textContent = vm.username || 'root';
    document.getElementById('detailSSHPort').textContent = port;
    document.getElementById('detailNetType').textContent = vm.network_type === 'nat' ? 'User Mode NAT' : 'Static Public / Bridge';
    document.getElementById('detailKVM').innerHTML = vm.enable_kvm ? '<span class="text-emerald-400">Enabled</span>' : '<span class="text-gray-400">Disabled</span>';

    // Quick SSH Command
    const user = vm.username || 'root';
    document.getElementById('sshCommandText').textContent = `ssh ${user}@localhost -p ${port}`;

    // Hardware Tab
    document.getElementById('hwCPUModel').textContent = vm.cpu_model || 'host';
    document.getElementById('hwTopology').textContent = `${vm.cpu_sockets || 1} Socket(s), ${cores} Core(s)`;
    document.getElementById('hwMachine').textContent = vm.machine_type || 'pc (i440fx)';
    document.getElementById('hwRAM').textContent = ram + ' MB';

    // Network Tab
    document.getElementById('netIPv4').textContent = ip;
    document.getElementById('netMAC').textContent = vm.mac_address || 'Auto-generated';
    document.getElementById('netMode').textContent = vm.network_type === 'nat' ? 'NAT' : 'Bridge';
    if (vm.dns_primary) document.getElementById('netDNS1').textContent = vm.dns_primary;
    if (vm.dns_secondary) document.getElementById('netDNS2').textContent = vm.dns_secondary;
  }

  function copySSH() {
    const text = document.getElementById('sshCommandText').textContent;
    navigator.clipboard.writeText(text);
    const btn = document.getElementById('copyBtnText');
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  }

  async function doAction(action) {
    try {
      const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
      const data = await res.json();
      if (res.ok && data.success) {
        setTimeout(loadVMDetails, 1000);
      } else {
        alert(data.error || 'Action failed');
      }
    } catch (err) {
      alert('Network error executing power action');
    }
  }

  async function deleteVM() {
    if (!confirm('Are you sure you want to permanently delete this virtual machine? This cannot be undone.')) return;
    try {
      const res = await fetch(`/api/vms/${vmId}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.href = '/vms';
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to delete VM');
      }
    } catch (err) {
      alert('Delete request failed: ' + err.message);
    }
  }

  async function loadSnapshots() {
    const container = document.getElementById('snapshotsListContainer');
    try {
      const res = await fetch(`/api/vms/${vmId}/snapshots`);
      if (!res.ok) throw new Error('Failed');
      const snaps = await res.json();
      if (!snaps || snaps.length === 0) {
        container.innerHTML = '<p class="text-xs text-[var(--theme-text-muted)]">No snapshots created yet.</p>';
        return;
      }
      container.innerHTML = snaps.map(s => `
        <div class="flex items-center justify-between p-3 rounded-lg border text-xs" style="background:var(--theme-bg-secondary); border-color:var(--theme-border);">
          <div>
            <span class="font-medium text-[var(--theme-text-strong)]">${escapeHtml(s.snapshot_name)}</span>
            <p class="text-[11px] text-[var(--theme-text-muted)] mt-0.5">${new Date(s.created_at).toLocaleString()}</p>
          </div>
          <span class="text-[11px] font-mono text-[var(--theme-text-muted)]">${s.size_gb ? s.size_gb + ' GB' : ''}</span>
        </div>
      `).join('');
    } catch (_) {
      container.innerHTML = '<p class="text-xs text-[var(--theme-text-muted)]">Snapshot feature not active on this node.</p>';
    }
  }

  function openSnapshotModal() {
    document.getElementById('snapshotModal').classList.remove('hidden');
  }

  function closeSnapshotModal() {
    document.getElementById('snapshotModal').classList.add('hidden');
  }

  async function handleCreateSnapshot(e) {
    e.preventDefault();
    const name = document.getElementById('snapshotName').value.trim();
    const desc = document.getElementById('snapshotDesc').value.trim();
    const btn = document.getElementById('btnSubmitSnapshot');

    btn.disabled = true;
    try {
      const res = await fetch(`/api/vms/${vmId}/snapshots`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ snapshot_name: name, description: desc })
      });
      if (res.ok) {
        closeSnapshotModal();
        loadSnapshots();
      } else {
        alert('Failed to create snapshot');
      }
    } catch (err) {
      alert('Snapshot request failed');
    } finally {
      btn.disabled = false;
    }
  }

  loadVMDetails();
</script>