<%- include('../components/header', { title: 'Dashboard' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    
    <!-- Top Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [{ label: 'Dashboard' }] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
            Virtual Machine Dashboard
          </h1>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Overview of your deployed virtualization instances and runtime metrics.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
            <a href="/admin/vm/create" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
              <%- icon('plus', { class: 'w-3.5 h-3.5' }) %>
              <span>Deploy VM</span>
            </a>
          <% } %>

          <button type="button" id="refreshBtn" onclick="loadDashboardVMs()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5', id: 'refreshIcon' }) %>
            <span>Refresh</span>
          </button>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="al-card p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Total VMs</span>
            <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a)">
              <%- icon('server', { class: 'w-3.5 h-3.5' }) %>
            </div>
          </div>
          <p id="statTotalVMs" class="text-2xl font-semibold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">-</p>
          <span class="text-[10px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">All provisioned instances</span>
        </div>

        <div class="al-card p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Active / Running</span>
            <div class="w-7 h-7 rounded-lg flex items-center justify-center text-emerald-400" style="background:rgba(16, 185, 129, 0.1)">
              <%- icon('play', { class: 'w-3.5 h-3.5' }) %>
            </div>
          </div>
          <p id="statRunningVMs" class="text-2xl font-semibold mt-2 tabular-nums text-emerald-400">-</p>
          <span class="text-[10px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">Online and healthy</span>
        </div>

        <div class="al-card p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Stopped</span>
            <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a)">
              <%- icon('square', { class: 'w-3.5 h-3.5' }) %>
            </div>
          </div>
          <p id="statStoppedVMs" class="text-2xl font-semibold mt-2 tabular-nums" style="color:var(--theme-text-muted, #8a8a8a)">-</p>
          <span class="text-[10px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">Powered off</span>
        </div>

        <div class="al-card p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Allocated Memory</span>
            <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a)">
              <%- icon('cpu', { class: 'w-3.5 h-3.5' }) %>
            </div>
          </div>
          <p id="statTotalRAM" class="text-2xl font-semibold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">-</p>
          <span class="text-[10px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">RAM allocation</span>
        </div>
      </div>

      <!-- VM Listing Section -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-medium tracking-tight" style="color:var(--theme-text-strong, #fafafa)">Instances</h2>
          <span id="liveBadge" class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-0.5 rounded-full"
                style="background:rgba(16, 185, 129, 0.1); color:#10B981; border:1px solid rgba(16, 185, 129, 0.2);">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Auto-refresh (30s)
          </span>
        </div>

        <!-- VM Grid Container -->
        <div id="vmGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
          <!-- Skeleton Loader -->
          <div class="al-card p-4 animate-pulse space-y-3">
            <div class="flex items-center justify-between">
              <div class="h-4 w-32 bg-[var(--theme-bg-secondary)] rounded"></div>
              <div class="h-4 w-16 bg-[var(--theme-bg-secondary)] rounded-full"></div>
            </div>
            <div class="h-3 w-48 bg-[var(--theme-bg-secondary)] rounded"></div>
            <div class="h-8 w-full bg-[var(--theme-bg-secondary)] rounded-lg"></div>
          </div>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="al-card p-8 text-center hidden">
          <div class="w-12 h-12 rounded-xl mx-auto flex items-center justify-center mb-3" style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a)">
            <%- icon('server', { class: 'w-6 h-6' }) %>
          </div>
          <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">No Virtual Machines Found</h3>
          <p class="text-xs max-w-sm mx-auto mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            You do not currently have any virtual machines deployed on this host.
          </p>
          <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
            <div class="mt-4">
              <a href="/admin/vm/create" class="al-btn-primary text-xs inline-flex items-center gap-1.5 py-1.5 px-3">
                <%- icon('plus', { class: 'w-3.5 h-3.5' }) %>
                <span>Deploy First VM</span>
              </a>
            </div>
          <% } %>
        </div>

      </div>

    </main>
  </div>
</div>

<script>
  let allVMs = [];

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function getStatusBadge(status) {
    const s = (status || 'stopped').toLowerCase();
    if (s === 'running') {
      return `<span class="al-badge-online"><span class="al-dot-online"></span>Running</span>`;
    }
    if (s === 'paused') {
      return `<span class="al-badge-warning"><span class="al-dot-warning"></span>Paused</span>`;
    }
    return `<span class="al-badge-offline"><span class="al-dot-offline"></span>Stopped</span>`;
  }

  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 MB';
    const mb = bytes / (1024 * 1024);
    if (mb >= 1024) return (mb / 1024).toFixed(1) + ' GB';
    return Math.round(mb) + ' MB';
  }

  async function loadDashboardVMs() {
    const icon = document.getElementById('refreshIcon');
    if (icon) icon.classList.add('animate-spin');

    try {
      const res = await fetch('/api/vms');
      if (!res.ok) throw new Error('Failed to fetch VMs');
      allVMs = await res.json();

      updateStats(allVMs);
      renderGrid(allVMs);
    } catch (err) {
      console.error('Error loading VMs:', err);
    } finally {
      if (icon) icon.classList.remove('animate-spin');
    }
  }

  function updateStats(vms) {
    const total = vms.length;
    const running = vms.filter(v => (v.status || '').toLowerCase() === 'running').length;
    const stopped = total - running;
    const totalRamMB = vms.reduce((acc, v) => acc + (parseInt(v.memory_mb || v.memory) || 0), 0);

    document.getElementById('statTotalVMs').textContent = total;
    document.getElementById('statRunningVMs').textContent = running;
    document.getElementById('statStoppedVMs').textContent = stopped;
    document.getElementById('statTotalRAM').textContent = totalRamMB >= 1024 ? (totalRamMB / 1024).toFixed(1) + ' GB' : totalRamMB + ' MB';
  }

  function renderGrid(vms) {
    const grid = document.getElementById('vmGrid');
    const empty = document.getElementById('emptyState');

    if (!vms || vms.length === 0) {
      grid.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    grid.innerHTML = vms.map(vm => {
      const isRunning = (vm.status || '').toLowerCase() === 'running';
      const vmId = vm.vm_id || vm.id;
      const ram = vm.memory_mb || vm.memory || '—';
      const cpu = vm.cpu_cores || vm.cores || 1;
      const sshPort = vm.ssh_port || vm.ssh_port_static || 2222;

      return `
        <div class="al-card p-4 flex flex-col justify-between hover:border-[var(--theme-border-accent)] transition-all group">
          <div>
            <!-- Header -->
            <div class="flex items-start justify-between gap-2">
              <a href="/vm/${escapeHtml(vmId)}" class="font-medium text-sm truncate text-[var(--theme-text-strong)] group-hover:text-[var(--theme-accent)] transition-colors">
                ${escapeHtml(vm.name || vm.vm_name || 'VM-' + vmId)}
              </a>
              <div>${getStatusBadge(vm.status)}</div>
            </div>

            <!-- Meta details -->
            <div class="mt-2.5 flex items-center gap-3 text-[11px] text-[var(--theme-text-muted)]">
              <span class="flex items-center gap-1 font-mono">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
                ${cpu} vCPU
              </span>
              <span>•</span>
              <span class="flex items-center gap-1">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/></svg>
                ${ram} MB
              </span>
              <span>•</span>
              <span class="font-mono">Port ${sshPort}</span>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="mt-4 pt-3 border-t border-[var(--theme-border-subtle)] flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <a href="/vm/${escapeHtml(vmId)}/console" class="al-btn-secondary py-1 px-2.5 text-[11px] flex items-center gap-1" title="Console">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                <span>Console</span>
              </a>
              <a href="/vm/${escapeHtml(vmId)}/ssh" class="al-btn-secondary py-1 px-2.5 text-[11px] flex items-center gap-1" title="SSH">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
                <span>SSH</span>
              </a>
            </div>

            <div class="flex items-center gap-1">
              ${isRunning ? `
                <button onclick="powerAction('${escapeHtml(vmId)}', 'stop')" class="al-btn-danger py-1 px-2 text-[11px]" title="Stop VM">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12"/></svg>
                </button>
                <button onclick="powerAction('${escapeHtml(vmId)}', 'restart')" class="al-btn-secondary py-1 px-2 text-[11px]" title="Restart VM">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                </button>
              ` : `
                <button onclick="powerAction('${escapeHtml(vmId)}', 'start')" class="al-btn-success py-1 px-2 text-[11px]" title="Start VM">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                </button>
              `}
              <a href="/vm/${escapeHtml(vmId)}" class="al-btn-ghost py-1 px-2 text-[11px]" title="Manage VM">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  async function powerAction(vmId, action) {
    try {
      const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
      const data = await res.json();
      if (res.ok && data.success) {
        loadDashboardVMs();
      } else {
        alert(data.error || 'Action failed');
      }
    } catch (err) {
      alert('Network error executing power action');
    }
  }

  // Initial load and periodic auto-refresh (30s)
  loadDashboardVMs();
  setInterval(loadDashboardVMs, 30000);
</script>