<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'KineticMesh Control Plane' %></title>
  <link rel="icon" href="<%= typeof siteLogo !== 'undefined' ? siteLogo : 'https://i.imgur.com/0DmkSi4.png' %>" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/dist/assets/index.css">
  <script>
    window.__INITIAL_DATA__ = {
      title: "<%= typeof title !== 'undefined' ? title : '' %>",
      currentPage: "<%= typeof currentPage !== 'undefined' ? currentPage : '' %>",
      siteLogo: "<%= typeof siteLogo !== 'undefined' ? siteLogo : '' %>",
      siteName: "<%= typeof siteName !== 'undefined' ? siteName : '' %>",
      vmId: "<%= typeof vmId !== 'undefined' ? vmId : '' %>",
      userId: "<%= typeof userId !== 'undefined' ? userId : '' %>"
    };
  </script>
</head>
<body class="bg-background text-foreground antialiased selection:bg-muted selection:text-foreground">
  <div id="root"></div>
  <script type="module" src="/dist/assets/index.js"></script>
</body>
</html>
