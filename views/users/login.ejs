<!DOCTYPE html>
<html class="h-full dark" lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0a0a0a">
  <title><%= typeof title !== 'undefined' ? title : 'Sign In - KineticMesh' %></title>
  <link rel="icon" href="<%= typeof siteLogo !== 'undefined' ? siteLogo : '/public/images/logo.png' %>" type="image/png">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/styles/motion.css">
  <link rel="stylesheet" href="/themes/default-dark.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

  <style>
    body, html { height: 100%; margin: 0; background: var(--theme-bg, #161616); color: var(--theme-text, #e0e0e0); font-family: 'Inter', sans-serif; }
    .auth-split { display: flex; min-height: 100vh; }
    .auth-panel {
      width: 100%; max-width: 440px; flex-shrink: 0;
      display: flex; flex-direction: column; justify-content: center;
      padding: 48px 40px;
      background: var(--theme-bg-card, #212121);
      border-right: 1px solid var(--theme-border, rgba(255,255,255,0.13));
      position: relative; z-index: 1;
    }
    .auth-image {
      flex: 1;
      background: linear-gradient(135deg, rgba(22,22,22,0.95), rgba(30,30,30,0.85)), url('/public/images/logo.png') center/contain no-repeat;
      background-color: var(--theme-bg, #161616);
    }
    @media (max-width: 768px) {
      .auth-split { position: relative; display: block; min-height: 100vh; }
      .auth-image { display: none; }
      .auth-panel {
        max-width: 100%; border-right: none; padding: 40px 24px; min-height: 100vh;
        background: var(--theme-bg-card, #212121);
      }
    }
    .auth-input {
      width: 100%; padding: 10px 14px; border-radius: 12px;
      border: 1px solid var(--theme-border-input, rgba(255,255,255,0.16)); 
      background: var(--theme-bg-input, rgba(255,255,255,0.09));
      font-size: 14px; color: var(--theme-text-strong, #fafafa); outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      box-sizing: border-box; font-family: inherit;
    }
    .auth-input:focus {
      border-color: var(--theme-border-accent, rgba(255,255,255,0.3));
      box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
    }
    .auth-input::placeholder { color: var(--theme-text-placeholder, #9ca3af); }
    .auth-label { display: block; font-size: 12px; font-weight: 500; color: var(--theme-text-muted, #8a8a8a); margin-bottom: 6px; }
    .auth-submit {
      width: 100%; padding: 10px 14px; border-radius: 12px;
      background: var(--theme-accent, #ffffff); color: var(--theme-accent-text, #0a0a0a);
      font-size: 14px; font-weight: 600;
      border: 1px solid var(--theme-btn-border, rgba(255,255,255,0.13)); 
      cursor: pointer; transition: opacity 0.15s;
      font-family: inherit; display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .auth-submit:hover:not(:disabled) { opacity: 0.9; }
    .auth-submit:disabled { opacity: 0.5; cursor: default; }
    .pw-wrapper { position: relative; }
    .pw-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; padding: 0;
      color: var(--theme-text-muted, #8a8a8a); line-height: 0;
    }
    .pw-toggle:hover { color: var(--theme-text-strong, #fafafa); }
    .shake { animation: shake 0.4s ease; }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }
  </style>
</head>
<body>

<div class="auth-split">
  <div class="auth-panel" id="authPanel">

    <div class="mb-8">
      <img src="<%= typeof siteLogo !== 'undefined' ? siteLogo : '/public/images/logo.png' %>"
           alt="Logo"
           class="h-10 w-10 rounded-xl object-contain mb-5 p-1"
           style="background:var(--theme-logo-bg, rgba(255,255,255,0.06)); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.1));">
      <h1 class="text-2xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">Sign in</h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted, #8a8a8a)">to <%= typeof siteName !== 'undefined' ? siteName : 'KineticMesh' %></p>
    </div>

    <!-- Alert / Error message -->
    <div id="loginAlert" class="rounded-xl px-4 py-3 mb-5 hidden" style="background:var(--theme-danger-bg, rgba(248,113,113,0.1)); border:1px solid var(--theme-danger, #f87171)" role="alert">
      <p id="loginAlertText" class="text-sm font-medium" style="color:var(--theme-danger, #f87171)"></p>
    </div>

    <form id="loginForm" onsubmit="handleLogin(event)" autocomplete="on" novalidate>
      <div class="space-y-4">
        <div>
          <label class="auth-label" for="username">Username</label>
          <input id="username" name="username" type="text" autocomplete="username"
            required spellcheck="false" autocapitalize="none" autofocus
            class="auth-input" placeholder="admin">
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="auth-label !mb-0" for="password">Password</label>
          </div>
          <div class="pw-wrapper">
            <input id="password" name="password" type="password" autocomplete="current-password"
              required class="auth-input" placeholder="••••••••">
            <button type="button" class="pw-toggle" onclick="togglePassword()" aria-label="Toggle password visibility">
              <svg id="pwEyeIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" id="loginBtn" class="auth-submit">
            <span>Sign in</span>
          </button>
        </div>

        <!-- Optional Discord OAuth Button -->
        <button type="button" id="discordLoginBtn" onclick="loginWithDiscord()"
                class="w-full py-2.5 px-4 rounded-xl text-sm font-medium transition-colors hidden items-center justify-center gap-2 border"
                style="background: #5865F2; color: #ffffff; border-color: #4752C4;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Continue with Discord</span>
        </button>
      </div>
    </form>

    <div class="mt-8 pt-6 border-t text-xs text-center" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06)); color:var(--theme-text-muted, #8a8a8a);">
      KineticMesh Virtualization Platform
    </div>

  </div>

  <div class="auth-image hidden md:block"></div>
</div>

<script>
  function togglePassword() {
    const pwd = document.getElementById('password');
    const eye = document.getElementById('pwEyeIcon');
    if (pwd.type === 'password') {
      pwd.type = 'text';
      eye.innerHTML = '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>';
    } else {
      pwd.type = 'password';
      eye.innerHTML = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
    }
  }

  function showAlert(msg) {
    const alert = document.getElementById('loginAlert');
    const text = document.getElementById('loginAlertText');
    text.textContent = msg;
    alert.classList.remove('hidden');
  }

  async function handleLogin(e) {
    e.preventDefault();
    const btn = document.getElementById('loginBtn');
    const panel = document.getElementById('authPanel');
    const username = document.getElementById('username').value.trim();
    const password = document.getElementById('password').value;

    if (!username || !password) {
      showAlert('Please enter both username and password.');
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<span>Signing in...</span>';

    try {
      const res = await fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        btn.innerHTML = '<span>Success! Redirecting...</span>';
        setTimeout(() => {
          window.location.href = (data.user && data.user.role === 'admin') ? '/admin/dashboard' : '/dashboard';
        }, 400);
      } else {
        panel.classList.add('shake');
        setTimeout(() => panel.classList.remove('shake'), 400);
        showAlert(data.error || data.message || 'Invalid username or password');
        btn.disabled = false;
        btn.innerHTML = '<span>Sign in</span>';
      }
    } catch (err) {
      panel.classList.add('shake');
      setTimeout(() => panel.classList.remove('shake'), 400);
      showAlert('Connection error. Please try again.');
      btn.disabled = false;
      btn.innerHTML = '<span>Sign in</span>';
    }
  }

  // Check if Discord OAuth is enabled
  (async function checkDiscord() {
    try {
      const res = await fetch('/api/discord-enabled');
      if (res.ok) {
        const data = await res.json();
        if (data.enabled) {
          const btn = document.getElementById('discordLoginBtn');
          if (btn) btn.classList.remove('hidden'), btn.classList.add('flex');
        }
      }
    } catch (_) {}
  })();

  async function loginWithDiscord() {
    try {
      const res = await fetch('/api/discord-auth-url');
      if (res.ok) {
        const data = await res.json();
        if (data.url) window.location.href = data.url;
      }
    } catch (err) {
      showAlert('Discord authentication unavailable.');
    }
  }
</script>

</body>
</html>
