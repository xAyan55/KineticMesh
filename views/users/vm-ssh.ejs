<%- include('../components/header', { title: 'SSH Terminal #' + vmId }) %>

<!-- xterm.js CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css">

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Virtual Machines', href: '/vms' },
      { label: 'VM #' + vmId, href: '/vm/' + vmId },
      { label: 'SSH Terminal' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto flex flex-col space-y-4">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
              SSH Terminal <span id="vmNameLabel" class="text-sm font-normal" style="color:var(--theme-text-muted, #8a8a8a)"></span>
            </h1>
            <span id="statusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium"
              style="background:rgba(113, 113, 122, 0.12); color:#a1a1aa; border:1px solid rgba(113, 113, 122, 0.2);">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
              <span id="statusText">Disconnected</span>
            </span>
          </div>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Secure Shell session connected via xterm.js emulation.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/vm/<%= vmId %>" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('arrow-left', { class: 'w-3.5 h-3.5' }) %>
            <span>Back to VM</span>
          </a>
          <button type="button" id="connectBtn" onclick="openModal()" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('link', { class: 'w-3.5 h-3.5' }) %>
            <span>Connect</span>
          </button>
          <button type="button" id="disconnectBtn" onclick="disconnect()" class="al-btn-danger text-xs hidden items-center gap-1.5 py-1.5 px-3">
            <%- icon('unlink', { class: 'w-3.5 h-3.5' }) %>
            <span>Disconnect</span>
          </button>
        </div>
      </div>

      <!-- Terminal Surface -->
      <div class="al-card flex-1 flex flex-col min-h-[540px] rounded-xl overflow-hidden shadow-lg"
           style="border:1px solid var(--theme-border, rgba(255,255,255,0.1)); background:#09090b;">
        
        <!-- Terminal Header Bar -->
        <div class="flex items-center justify-between px-4 py-2.5 shrink-0 border-b"
             style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border, rgba(255,255,255,0.1));">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            <span class="ml-2 text-xs font-mono select-none" style="color:var(--theme-text-muted, #8a8a8a)">xterm.js @ VM #<%= vmId %></span>
          </div>
          <div class="text-[11px] font-mono" style="color:var(--theme-text-muted, #8a8a8a)">
            Shortcuts: Ctrl+O Connect, Ctrl+L Clear
          </div>
        </div>

        <!-- xterm Wrapper -->
        <div class="flex-1 w-full p-2 overflow-hidden" id="terminalContainer" style="background:#09090b; min-height:460px;"></div>
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<!-- Airlink SSH Connection Modal -->
<div id="modalBackdrop" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4">
  <div class="al-card w-full max-w-md rounded-2xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150"
       style="background:var(--theme-bg-card, #141414); border:1px solid var(--theme-border, rgba(255,255,255,0.12));">
    
    <div class="flex items-center justify-between px-5 py-4 border-b"
         style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border, rgba(255,255,255,0.08));">
      <div class="flex items-center gap-2.5">
        <div class="p-2 rounded-xl" style="background:rgba(99, 102, 241, 0.12); color:var(--theme-primary, #6366f1)">
          <%- icon('terminal', { class: 'w-4 h-4' }) %>
        </div>
        <div>
          <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">SSH Connection</h2>
          <p class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Authenticate to guest instance</p>
        </div>
      </div>
      <button type="button" onclick="closeModal()" class="text-zinc-400 hover:text-white p-1 rounded-lg transition-colors">
        <%- icon('x', { class: 'w-4 h-4' }) %>
      </button>
    </div>

    <div class="p-5 space-y-3.5">
      <div class="grid grid-cols-3 gap-3">
        <div class="col-span-2 space-y-1">
          <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Host / IP Address</label>
          <input type="text" id="inputHost" placeholder="192.168.1.100 or localhost" class="al-input text-xs w-full">
        </div>
        <div class="space-y-1">
          <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Port</label>
          <input type="number" id="inputPort" value="22" min="1" max="65535" class="al-input text-xs w-full">
        </div>
      </div>

      <div class="space-y-1">
        <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Username</label>
        <input type="text" id="inputUsername" placeholder="root or ubuntu" class="al-input text-xs w-full">
      </div>

      <div class="space-y-1">
        <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Password</label>
        <input type="password" id="inputPassword" placeholder="••••••••" class="al-input text-xs w-full">
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 px-5 py-3.5 border-t"
         style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border, rgba(255,255,255,0.08));">
      <button type="button" onclick="closeModal()" class="al-btn-secondary text-xs px-3.5 py-1.5">Cancel</button>
      <button type="button" id="connectModalBtn" onclick="connect()" class="al-btn-primary text-xs px-4 py-1.5 flex items-center gap-1.5">
        <%- icon('play', { class: 'w-3 h-3' }) %>
        <span>Connect</span>
      </button>
    </div>
  </div>
</div>

<style>
  .xterm {
    height: 100%;
    padding: 10px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
  }
  .xterm-viewport::-webkit-scrollbar { width: 6px; }
  .xterm-viewport::-webkit-scrollbar-track { background: #09090b; }
  .xterm-viewport::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }
</style>

<!-- xterm.js Library -->
<script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-web-links@0.7.0/lib/xterm-addon-web-links.min.js"></script>

<script>
// ============= GLOBAL STATE =============
const vmId = <%= vmId %>;
const userId = <%= userId %>;
let ws = null;
let isConnected = false;
let term = null;
const fitAddon = new FitAddon.FitAddon();

// ============= TERMINAL INITIALIZATION =============
function initTerminal() {
  const container = document.getElementById('terminalContainer');
  
  term = new Terminal({
    cols: 120,
    rows: 30,
    theme: {
      background: '#09090b',
      foreground: '#e4e4e7',
      cursor: '#6366f1',
      cursorAccent: '#09090b',
      black: '#18181b',
      red: '#ef4444',
      green: '#10b981',
      yellow: '#f59e0b',
      blue: '#3b82f6',
      magenta: '#a855f7',
      cyan: '#06b6d4',
      white: '#f4f4f5',
      brightBlack: '#71717a',
      brightRed: '#f87171',
      brightGreen: '#34d399',
      brightYellow: '#fbbf24',
      brightBlue: '#60a5fa',
      brightMagenta: '#c084fc',
      brightCyan: '#22d3ee',
      brightWhite: '#ffffff'
    },
    fontSize: 13,
    fontFamily: "'JetBrains Mono', 'Fira Code', 'Courier New', monospace",
    lineHeight: 1.25,
    cursorStyle: 'block',
    cursorBlink: true,
    scrollback: 5000
  });
  
  term.loadAddon(fitAddon);
  term.loadAddon(new WebLinksAddon.WebLinksAddon());
  term.open(container);
  fitAddon.fit();
  
  window.addEventListener('resize', () => {
    try {
      fitAddon.fit();
    } catch (e) {
      console.error('[Terminal] Resize error:', e);
    }
  });
  
  term.onData(data => {
    if (ws && ws.readyState === WebSocket.OPEN && isConnected) {
      ws.send(JSON.stringify({
        type: 'input',
        data: data
      }));
    }
  });
}

// ============= CONNECTION FUNCTIONS =============
function setConnected(state) {
  isConnected = state;
  const badge = document.getElementById('statusBadge');
  const statusText = document.getElementById('statusText');
  const connectBtn = document.getElementById('connectBtn');
  const disconnectBtn = document.getElementById('disconnectBtn');
  
  if (state) {
    badge.style.cssText = 'background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);';
    badge.firstElementChild.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
    statusText.textContent = 'Connected';
    connectBtn.classList.add('hidden');
    connectBtn.classList.remove('flex');
    disconnectBtn.classList.remove('hidden');
    disconnectBtn.classList.add('flex');
    if (term) term.focus();
  } else {
    badge.style.cssText = 'background: rgba(113, 113, 122, 0.12); color: #a1a1aa; border: 1px solid rgba(113, 113, 122, 0.2);';
    badge.firstElementChild.className = 'w-1.5 h-1.5 rounded-full bg-zinc-400';
    statusText.textContent = 'Disconnected';
    connectBtn.classList.remove('hidden');
    connectBtn.classList.add('flex');
    disconnectBtn.classList.add('hidden');
    disconnectBtn.classList.remove('flex');
  }
}

// ============= MODAL FUNCTIONS =============
function openModal() {
  const modal = document.getElementById('modalBackdrop');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  document.getElementById('inputHost')?.focus();
}

function closeModal() {
  const modal = document.getElementById('modalBackdrop');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

// ============= SSH CONNECTION =============
function connect() {
  const host = document.getElementById('inputHost').value.trim();
  const port = document.getElementById('inputPort').value.trim();
  const username = document.getElementById('inputUsername').value.trim();
  const password = document.getElementById('inputPassword').value;
  
  if (!host || !port || !username) {
    alert('Please fill in Host, Port, and Username');
    return;
  }
  
  const connectBtn = document.getElementById('connectModalBtn');
  connectBtn.disabled = true;
  const originalHTML = connectBtn.innerHTML;
  connectBtn.innerHTML = 'Connecting...';
  
  closeModal();
  
  if (term) {
    term.clear();
    term.write('\r\n\u001b[1;36m┌─────────────────────────────────────────┐\u001b[0m\r\n');
    term.write('\u001b[1;36m│  🔐 Connecting to SSH Host...           │\u001b[0m\r\n');
    term.write('\u001b[1;36m└─────────────────────────────────────────┘\u001b[0m\r\n');
    term.write(`\r\n\u001b[33m[*]\u001b[0m Connecting to ${username}@${host}:${port}...\r\n`);
  }
  
  const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const wsUrl = proto + '//' + window.location.host + '/ssh-terminal';
  
  try {
    ws = new WebSocket(wsUrl);
    ws.binaryType = 'arraybuffer';
  } catch (e) {
    if (term) term.write('\r\n\u001b[1;31m✗ Error: Failed to create WebSocket connection\u001b[0m\r\n');
    connectBtn.disabled = false;
    connectBtn.innerHTML = originalHTML;
    return;
  }
  
  ws.onopen = function() {
    const message = {
      type: 'connect',
      vmId: vmId,
      host: host,
      port: parseInt(port),
      username: username,
      password: password
    };
    ws.send(JSON.stringify(message));
  };
  
  ws.onmessage = function(event) {
    try {
      if (event.data instanceof ArrayBuffer) {
        const uint8Array = new Uint8Array(event.data);
        const text = String.fromCharCode.apply(null, uint8Array);
        if (term) term.write(text);
      } else {
        const message = JSON.parse(event.data);
        if (message.type === 'connected') {
          setConnected(true);
          if (term) term.write('\r\n\u001b[1;32m✓ SSH Connection Established\u001b[0m\r\n\r\n');
          connectBtn.disabled = false;
          connectBtn.innerHTML = originalHTML;
        } else if (message.type === 'closed') {
          if (term) term.write('\r\n\r\n\u001b[1;31m⛔ SSH Connection Closed\u001b[0m\r\n');
          setConnected(false);
        } else if (message.type === 'error') {
          if (term) term.write('\r\n\u001b[1;31m✗ Error: ' + message.message + '\u001b[0m\r\n');
          setConnected(false);
          connectBtn.disabled = false;
          connectBtn.innerHTML = originalHTML;
        }
      }
    } catch (e) {
      if (event.data instanceof Blob) {
        event.data.arrayBuffer().then(buffer => {
          const uint8Array = new Uint8Array(buffer);
          const text = String.fromCharCode.apply(null, uint8Array);
          if (term) term.write(text);
        });
      }
    }
  };
  
  ws.onerror = function(error) {
    if (term) term.write('\r\n\u001b[1;31m✗ WebSocket Error: Connection failed\u001b[0m\r\n');
    setConnected(false);
    connectBtn.disabled = false;
    connectBtn.innerHTML = originalHTML;
  };
  
  ws.onclose = function() {
    if (isConnected && term) {
      term.write('\r\n\r\n\u001b[1;31m⛔ SSH Connection Closed\u001b[0m\r\n');
    }
    setConnected(false);
    connectBtn.disabled = false;
    connectBtn.innerHTML = originalHTML;
  };
}

function disconnect() {
  if (ws) ws.close();
  setConnected(false);
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeModal();
  if (e.ctrlKey && (e.key === 'o' || e.key === 'O')) {
    e.preventDefault();
    if (!isConnected) openModal();
  }
});

async function initializePage() {
  try {
    const response = await fetch('/api/vms/' + vmId);
    if (!response.ok) return;
    const vm = await response.json();
    
    if (vm.owner_id !== userId && '<%= user.role %>' !== 'admin') {
      window.location.href = '/vms';
      return;
    }
    
    const label = document.getElementById('vmNameLabel');
    if (label && vm.vm_name) label.textContent = `(${vm.vm_name})`;
    
    setTimeout(() => {
      if (vm.ipv4_address) document.getElementById('inputHost').value = vm.ipv4_address;
      if (vm.ssh_port) document.getElementById('inputPort').value = vm.ssh_port;
      else if (vm.ssh_port_static) document.getElementById('inputPort').value = vm.ssh_port_static;
      else document.getElementById('inputPort').value = 2222;
      if (vm.username) document.getElementById('inputUsername').value = vm.username;
      if (vm.password) document.getElementById('inputPassword').value = vm.password;
      
      openModal();
    }, 300);
  } catch (e) {
    console.error('[SSH] Init error:', e);
  }
}

window.addEventListener('load', function() {
  initTerminal();
  
  term.write('\r\n\u001b[1;36m┌────────────────────────────────────────────────────────┐\u001b[0m\r\n');
  term.write('\u001b[1;36m│  KineticMesh SSH Terminal                              │\u001b[0m\r\n');
  term.write('\u001b[1;36m│  Powered by xterm.js | Low-latency Web SSH Gateway    │\u001b[0m\r\n');
  term.write('\u001b[1;36m└────────────────────────────────────────────────────────┘\u001b[0m\r\n');
  term.write('\r\n\u001b[33m[*]\u001b[0m Press \u001b[1mConnect\u001b[0m or \u001b[1;33mCtrl+O\u001b[0m to initiate connection\r\n');
  term.write('\u001b[32m[✓]\u001b[0m Session handles full ANSI color & terminal controls\r\n\r\n');
  
  initializePage();
});
</script>
