<%- include('../components/header', { title: 'Add OS Template' }) %>

<div class="flex h-screen overflow-hidden">
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'OS Templates', href: '/admin/templates' },
      { label: 'Add Template' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-5xl w-full mx-auto space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h1 class="al-page-title">Add OS Template</h1>
          <p class="al-page-desc">Create a custom operating system template for your virtual machines.</p>
        </div>
        <div class="flex items-center gap-2">
          <a href="/admin/templates" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('arrow-left', { class: 'size-3.5', strokeWidth: 2 }) %>
            Back to Templates
          </a>
        </div>
      </div>

      <form id="addTemplateForm" onsubmit="submitForm(event)" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Left Column -->
          <div class="space-y-6">
            <!-- Template Basics -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('box', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Template Basics</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">
                    Template Key <span class="text-red-500">*</span>
                  </label>
                  <input type="text" class="al-input text-xs" id="templateKey" 
                         placeholder="ubuntu-22-custom" required 
                         pattern="[a-z0-9-]+" 
                         title="Use lowercase letters, numbers, and hyphens only">
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Unique identifier (e.g. ubuntu-22-custom, debian-12-server)</p>
                </div>

                <div>
                  <label class="al-label">
                    Template Name <span class="text-red-500">*</span>
                  </label>
                  <input type="text" class="al-input text-xs" id="templateName" 
                         placeholder="Ubuntu 22.04 Custom" required>
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Display name shown across the panel UI</p>
                </div>

                <div>
                  <label class="al-label">Description</label>
                  <textarea class="al-input text-xs" id="templateDesc" rows="3"
                            placeholder="Brief description of this template, pre-installed tools, etc."></textarea>
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Optional: Notes about this OS image</p>
                </div>

                <div>
                  <label class="al-label">Template Icon / Image URL</label>
                  <div class="flex items-center gap-3">
                    <div class="flex-1">
                      <input type="text" class="al-input text-xs" id="templateIcon" 
                             placeholder="https://example.com/icon.png or emoji like 📦" 
                             oninput="updateIconPreview()">
                    </div>
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 border border-[var(--theme-border)] text-xl overflow-hidden" 
                         id="iconPreview" style="background:var(--theme-bg-secondary)">
                      📦
                    </div>
                  </div>
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Direct image URL (PNG/SVG) or single emoji character</p>
                </div>
              </div>
            </div>

            <!-- Download Source -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('cloud-download', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Download Source</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">Download URL</label>
                  <input type="url" class="al-input text-xs" id="templateURL" 
                         placeholder="https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img">
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Direct HTTPS image link. KineticMesh can cache this image locally for fast deployments.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column -->
          <div class="space-y-6">
            <!-- Default Resources -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('cpu', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Default Resources</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">
                    Template Type <span class="text-red-500">*</span>
                  </label>
                  <select class="al-input text-xs" id="templateType" onchange="updateTemplateTypeUI()" required>
                    <option value="cloud-init" selected>Cloud-Init (Automatic provisioning)</option>
                    <option value="iso">ISO Installer (Manual installation)</option>
                  </select>
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Cloud-Init images configure network and user credentials automatically on boot.</p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="al-label">Memory (MB)</label>
                    <input type="number" class="al-input text-xs" id="templateMemory" 
                           value="2048" min="512" step="512">
                    <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">e.g. 2048, 4096</p>
                  </div>
                  <div>
                    <label class="al-label">vCPUs</label>
                    <input type="number" class="al-input text-xs" id="templateCPUs" 
                           value="2" min="1" max="32" step="1">
                    <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Cores (1-32)</p>
                  </div>
                </div>

                <div>
                  <label class="al-label">
                    Disk Size <span class="text-red-500">*</span>
                  </label>
                  <input type="text" class="al-input text-xs" id="templateDiskSize" 
                         value="20G" placeholder="20G" pattern="[0-9]+[KMGT]" required>
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Default disk size (e.g. 20G, 50G, 100G)</p>
                </div>
              </div>
            </div>

            <!-- Default Credentials -->
            <div class="al-card" id="credentialsSection">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('key', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Default Credentials</h2>
              </div>
              <div class="p-4 space-y-4">
                <p class="text-xs" style="color:var(--theme-text-muted)">
                  Default login credentials configured via Cloud-Init. Displayed to users upon VM deployment.
                </p>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="al-label">Default Username</label>
                    <input type="text" class="al-input text-xs" id="templateUser" 
                           value="ubuntu" placeholder="ubuntu">
                  </div>
                  <div>
                    <label class="al-label">Default Password</label>
                    <input type="text" class="al-input text-xs" id="templatePass" 
                           value="ubuntu" placeholder="password">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit & Actions -->
        <div class="al-card p-4 flex items-center justify-end gap-3">
          <a href="/admin/templates" class="al-btn-secondary text-xs py-2 px-4">Cancel</a>
          <button type="submit" id="submitBtn" class="al-btn-primary text-xs flex items-center gap-1.5 py-2 px-4">
            <%- icon('plus', { class: 'size-3.5', strokeWidth: 2 }) %>
            Create Template
          </button>
        </div>
      </form>
    </main>

    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
function updateIconPreview() {
  const value = document.getElementById('templateIcon').value.trim();
  const preview = document.getElementById('iconPreview');
  if (!value) {
    preview.innerHTML = '📦';
    return;
  }
  if (value.startsWith('http://') || value.startsWith('https://')) {
    preview.innerHTML = `<img src="${value}" alt="Icon" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='📦';">`;
  } else {
    preview.innerHTML = value.substring(0, 2);
  }
}

function updateTemplateTypeUI() {
  const type = document.getElementById('templateType').value;
  const creds = document.getElementById('credentialsSection');
  if (creds) {
    creds.style.display = type === 'iso' ? 'none' : 'block';
  }
}

async function submitForm(e) {
  e.preventDefault();
  const btn = document.getElementById('submitBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `<svg class="animate-spin size-3.5 mr-1" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Creating...`;

  try {
    const templateType = document.getElementById('templateType').value;
    const formData = {
      template_key: document.getElementById('templateKey').value.toLowerCase().trim(),
      template_name: document.getElementById('templateName').value.trim(),
      icon: document.getElementById('templateIcon').value.trim() || '📦',
      description: document.getElementById('templateDesc').value.trim(),
      memory: parseInt(document.getElementById('templateMemory').value) || 2048,
      cpus: parseInt(document.getElementById('templateCPUs').value) || 2,
      disk_size: document.getElementById('templateDiskSize').value.trim(),
      template_type: templateType,
      download_url: document.getElementById('templateURL').value.trim(),
      username: templateType === 'iso' ? '' : document.getElementById('templateUser').value.trim(),
      password: templateType === 'iso' ? '' : document.getElementById('templatePass').value.trim()
    };

    if (!formData.template_key || !/^[a-z0-9-]+$/.test(formData.template_key)) {
      throw new Error('Template key must contain only lowercase letters, numbers, and hyphens');
    }
    if (!formData.template_name) {
      throw new Error('Template name is required');
    }
    if (!formData.disk_size || !/^[0-9]+[KMGT]$/.test(formData.disk_size)) {
      throw new Error('Invalid disk size format (e.g., 20G, 50G)');
    }

    const response = await fetch('/api/admin/templates', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    });

    const result = await response.json();
    if (!response.ok) {
      throw new Error(result.error || 'Failed to create template');
    }

    if (window.toast) toast.success('Template created successfully');
    setTimeout(() => {
      window.location.href = '/admin/templates';
    }, 1000);
  } catch (error) {
    if (window.toast) toast.error(error.message);
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}

document.addEventListener('DOMContentLoaded', () => {
  updateIconPreview();
  updateTemplateTypeUI();
});
</script>