<%- include('../components/header', { title: 'Virtual Machines - Admin' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Virtual Machines' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
              Virtual Machines
            </h1>
            <span id="vmCountBadge" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-mono font-medium"
                  style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.08));">
              0 Total
            </span>
          </div>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Manage, configure, and supervise all provisioned virtualization instances across the fleet.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/vm-create" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('plus', { class: 'w-3.5 h-3.5' }) %>
            <span>Create VM</span>
          </a>
          <button type="button" onclick="loadVMs()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5', id: 'refreshIcon' }) %>
            <span>Refresh</span>
          </button>
        </div>
      </div>

      <!-- Filter / Search Controls Bar -->
      <div class="al-card p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
          <input
            type="text"
            id="searchInput"
            placeholder="Search by VM name, IP, OS, or ID..."
            oninput="handleSearch()"
            class="al-input text-xs w-full pl-8 py-1.5"
          />
          <div class="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none">
            <%- icon('search', { class: 'w-3.5 h-3.5' }) %>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <!-- Status Filters -->
          <div class="inline-flex p-0.5 rounded-lg border" style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
            <button type="button" onclick="setStatusFilter('')" id="filterAll" class="px-2.5 py-1 rounded-md text-xs font-medium transition-colors" style="background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);">
              All
            </button>
            <button type="button" onclick="setStatusFilter('running')" id="filterRunning" class="px-2.5 py-1 rounded-md text-xs font-medium transition-colors" style="color:var(--theme-text-muted, #8a8a8a);">
              Running
            </button>
            <button type="button" onclick="setStatusFilter('stopped')" id="filterStopped" class="px-2.5 py-1 rounded-md text-xs font-medium transition-colors" style="color:var(--theme-text-muted, #8a8a8a);">
              Stopped
            </button>
          </div>

          <!-- View Mode Toggle -->
          <div class="inline-flex p-0.5 rounded-lg border" style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
            <button type="button" onclick="setViewMode('list')" id="viewListBtn" class="p-1 rounded-md transition-colors" style="background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);" title="Table View">
              <%- icon('list', { class: 'w-3.5 h-3.5' }) %>
            </button>
            <button type="button" onclick="setViewMode('grid')" id="viewGridBtn" class="p-1 rounded-md transition-colors" style="color:var(--theme-text-muted, #8a8a8a);" title="Grid View">
              <%- icon('layout-grid', { class: 'w-3.5 h-3.5' }) %>
            </button>
          </div>
        </div>
      </div>

      <!-- VMs List Container -->
      <div id="vmContainer">
        <div class="al-card p-12 text-center">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center mx-auto mb-3 animate-spin text-zinc-500">
            <%- icon('rotate-cw', { class: 'w-4 h-4' }) %>
          </div>
          <p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">Loading virtual machines...</p>
        </div>
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
let allVMs = [];
let currentFilter = '';
let currentView = 'list';
let searchQuery = '';

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function setViewMode(mode) {
  currentView = mode;
  const listBtn = document.getElementById('viewListBtn');
  const gridBtn = document.getElementById('viewGridBtn');
  
  if (mode === 'list') {
    listBtn.style.background = 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))';
    listBtn.style.color = 'var(--theme-text-strong, #fafafa)';
    gridBtn.style.background = 'transparent';
    gridBtn.style.color = 'var(--theme-text-muted, #8a8a8a)';
  } else {
    gridBtn.style.background = 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))';
    gridBtn.style.color = 'var(--theme-text-strong, #fafafa)';
    listBtn.style.background = 'transparent';
    listBtn.style.color = 'var(--theme-text-muted, #8a8a8a)';
  }
  renderVMs();
}

function setStatusFilter(status) {
  currentFilter = status;
  const btnAll = document.getElementById('filterAll');
  const btnRun = document.getElementById('filterRunning');
  const btnStop = document.getElementById('filterStopped');
  
  [btnAll, btnRun, btnStop].forEach(b => {
    b.style.background = 'transparent';
    b.style.color = 'var(--theme-text-muted, #8a8a8a)';
  });

  const active = status === 'running' ? btnRun : (status === 'stopped' ? btnStop : btnAll);
  active.style.background = 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))';
  active.style.color = 'var(--theme-text-strong, #fafafa)';
  
  renderVMs();
}

function handleSearch() {
  searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
  renderVMs();
}

function getFilteredVMs() {
  return allVMs.filter(vm => {
    const matchStatus = !currentFilter || vm.status === currentFilter;
    const q = searchQuery;
    const matchSearch = !q ||
      vm.vm_name?.toLowerCase().includes(q) ||
      String(vm.vm_id).includes(q) ||
      vm.ipv4_address?.toLowerCase().includes(q) ||
      vm.template_name?.toLowerCase().includes(q) ||
      vm.owner_username?.toLowerCase().includes(q);
    return matchStatus && matchSearch;
  });
}

function renderVMs() {
  const container = document.getElementById('vmContainer');
  const filtered = getFilteredVMs();
  
  if (allVMs.length === 0) {
    container.innerHTML = `
      <div class="al-card p-12 text-center space-y-3">
        <p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">No virtual machines exist yet.</p>
        <a href="/admin/vm-create" class="al-btn-primary text-xs inline-flex items-center gap-1.5 py-1.5 px-3">Create First VM</a>
      </div>
    `;
    return;
  }

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="al-card p-10 text-center text-xs" style="color:var(--theme-text-muted, #8a8a8a)">
        No virtual machines matched the query "${escHtml(searchQuery)}".
      </div>
    `;
    return;
  }

  if (currentView === 'list') {
    renderListView(filtered, container);
  } else {
    renderGridView(filtered, container);
  }
}

function renderListView(vms, container) {
  container.innerHTML = `
    <div class="al-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b" style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06)); color:var(--theme-text-muted, #8a8a8a)">
              <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Instance</th>
              <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Status</th>
              <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Hardware</th>
              <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Network</th>
              <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Tenant</th>
              <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
            ${vms.map(vm => {
              const isRunning = vm.status === 'running';
              return `
                <tr class="hover:bg-[var(--theme-bg-hover,rgba(255,255,255,0.02))] transition-colors">
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 border"
                           style="background:var(--theme-bg-secondary, #212121); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08)); color:var(--theme-text-strong, #fafafa)">
                        ${escHtml((vm.vm_name || 'VM').substring(0, 2).toUpperCase())}
                      </div>
                      <div class="min-w-0">
                        <a href="/admin/vm/${vm.vm_id}" class="font-medium hover:underline block truncate" style="color:var(--theme-text-strong, #fafafa)">
                          ${escHtml(vm.vm_name)}
                        </a>
                        <div class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">
                          #${vm.vm_id} • ${escHtml(vm.template_name || vm.os_type || 'KVM')}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium"
                          style="${isRunning ? 'background:rgba(16, 185, 129, 0.12); color:#34d399; border:1px solid rgba(16, 185, 129, 0.2);' : 'background:rgba(113, 113, 122, 0.12); color:#a1a1aa; border:1px solid rgba(113, 113, 122, 0.2);'}">
                      <span class="w-1.5 h-1.5 rounded-full ${isRunning ? 'bg-emerald-400' : 'bg-zinc-400'}"></span>
                      <span class="capitalize">${escHtml(vm.status || 'stopped')}</span>
                    </span>
                  </td>
                  <td class="py-3 px-4 font-mono text-[11px]" style="color:var(--theme-text, #e4e4e7)">
                    ${vm.cpus ? vm.cpus + ' vCPU' : '—'} • ${vm.memory ? vm.memory + ' MB' : '—'} • ${escHtml(vm.disk_size || '—')}
                  </td>
                  <td class="py-3 px-4 font-mono text-[11px]" style="color:var(--theme-text, #e4e4e7)">
                    <div>${escHtml(vm.ipv4_address || 'DHCP')}</div>
                    <div class="text-[10px]" style="color:var(--theme-text-muted, #8a8a8a)">SSH Port: ${vm.ssh_port || vm.ssh_port_static || '22'}</div>
                  </td>
                  <td class="py-3 px-4 text-xs" style="color:var(--theme-text-muted, #8a8a8a)">
                    ${escHtml(vm.owner_username || 'Admin')}
                  </td>
                  <td class="py-3 px-4 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      ${isRunning
                        ? `<button type="button" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-danger text-xs px-2 py-1">Stop</button>`
                        : `<button type="button" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-success text-xs px-2 py-1">Start</button>`
                      }
                      <button type="button" onclick="vmAction('restart', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-secondary text-xs px-2 py-1">Reboot</button>
                      <a href="/admin/vm/${vm.vm_id}" class="al-btn-secondary text-xs px-2 py-1">Manage</a>
                      <button type="button" onclick="confirmDelete(${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-danger text-xs px-2 py-1">Delete</button>
                    </div>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;
}

function renderGridView(vms, container) {
  container.innerHTML = `
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      ${vms.map(vm => {
        const isRunning = vm.status === 'running';
        return `
          <div class="al-card p-4 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-3 mb-3">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 border"
                       style="background:var(--theme-bg-secondary, #212121); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08)); color:var(--theme-text-strong, #fafafa)">
                    ${escHtml((vm.vm_name || 'VM').substring(0, 2).toUpperCase())}
                  </div>
                  <div class="min-w-0">
                    <a href="/admin/vm/${vm.vm_id}" class="text-sm font-semibold truncate block hover:underline" style="color:var(--theme-text-strong, #fafafa)">
                      ${escHtml(vm.vm_name)}
                    </a>
                    <p class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">
                      #${vm.vm_id} • ${escHtml(vm.template_name || vm.os_type || 'KVM')}
                    </p>
                  </div>
                </div>

                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium shrink-0"
                      style="${isRunning ? 'background:rgba(16, 185, 129, 0.12); color:#34d399; border:1px solid rgba(16, 185, 129, 0.2);' : 'background:rgba(113, 113, 122, 0.12); color:#a1a1aa; border:1px solid rgba(113, 113, 122, 0.2);'}">
                  <span class="w-1.5 h-1.5 rounded-full ${isRunning ? 'bg-emerald-400' : 'bg-zinc-400'}"></span>
                  <span class="capitalize">${escHtml(vm.status || 'stopped')}</span>
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2 p-2.5 rounded-lg text-xs mb-3 font-mono"
                   style="background:var(--theme-bg-secondary, #1a1a1a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.06));">
                <div>
                  <div class="text-[10px] uppercase font-sans" style="color:var(--theme-text-muted, #8a8a8a)">Memory</div>
                  <div class="font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${vm.memory || '—'} MB</div>
                </div>
                <div>
                  <div class="text-[10px] uppercase font-sans" style="color:var(--theme-text-muted, #8a8a8a)">vCPUs</div>
                  <div class="font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${vm.cpus || '—'} vCPU</div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between gap-2 pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              ${isRunning
                ? `<button type="button" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-danger text-xs px-2.5 py-1">Stop</button>`
                : `<button type="button" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-success text-xs px-2.5 py-1">Start</button>`
              }
              <div class="flex items-center gap-1.5">
                <a href="/admin/vm/${vm.vm_id}" class="al-btn-secondary text-xs px-2.5 py-1">Manage</a>
                <button type="button" onclick="confirmDelete(${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-danger text-xs px-2.5 py-1">Delete</button>
              </div>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

async function vmAction(action, vmId, vmName) {
  if (!confirm(`Are you sure you want to ${action} VM "${vmName}"?`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) {
      setTimeout(loadVMs, 800);
    } else {
      alert('Failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

async function confirmDelete(vmId, vmName) {
  if (!confirm(`WARNING: Are you sure you want to PERMANENTLY DELETE VM "${vmName}" (#${vmId})?\nThis action cannot be undone.`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}`, { method: 'DELETE' });
    const data = await res.json();
    if (res.ok && data.success) {
      loadVMs();
    } else {
      alert('Delete failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

async function loadVMs() {
  const icon = document.getElementById('refreshIcon');
  if (icon) icon.classList.add('animate-spin');

  try {
    const res = await fetch('/api/admin/vms');
    if (!res.ok) throw new Error('Failed to fetch VMs');
    allVMs = await res.json();
    
    document.getElementById('vmCountBadge').textContent = `${allVMs.length} Total`;
    renderVMs();
  } catch(e) {
    document.getElementById('vmContainer').innerHTML = `
      <div class="al-card p-6 text-center text-xs text-red-400">
        Failed to load virtual machines: ${escHtml(e.message)}
      </div>
    `;
  } finally {
    if (icon) setTimeout(() => icon.classList.remove('animate-spin'), 600);
  }
}

loadVMs();
</script>