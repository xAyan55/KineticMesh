<%- include('../components/header', { title: 'Create VM - Admin' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Virtual Machines', href: '/admin/vms' },
      { label: 'Deploy Instance' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-5xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
            Provision Virtual Machine
          </h1>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Configure guest topology, cloud-init storage, network interfaces, and tenant assignment.
          </p>
        </div>

        <a href="/admin/vms" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
          <%- icon('arrow-left', { class: 'w-3.5 h-3.5' }) %>
          <span>Back to Fleet</span>
        </a>
      </div>

      <!-- Step Indicators Bar -->
      <div class="al-card p-3 flex items-center justify-between gap-2 overflow-x-auto">
        <button type="button" onclick="goToStep(1)" id="step-1-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] bg-indigo-500 text-white">1</span>
          <span>Template</span>
        </button>
        <span class="text-zinc-600">→</span>
        <button type="button" onclick="goToStep(2)" id="step-2-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="color:var(--theme-text-muted, #8a8a8a);">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] bg-zinc-800 text-zinc-400">2</span>
          <span>Hardware</span>
        </button>
        <span class="text-zinc-600">→</span>
        <button type="button" onclick="goToStep(3)" id="step-3-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="color:var(--theme-text-muted, #8a8a8a);">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] bg-zinc-800 text-zinc-400">3</span>
          <span>Network</span>
        </button>
        <span class="text-zinc-600">→</span>
        <button type="button" onclick="goToStep(4)" id="step-4-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="color:var(--theme-text-muted, #8a8a8a);">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] bg-zinc-800 text-zinc-400">4</span>
          <span>Security & BIOS</span>
        </button>
        <span class="text-zinc-600">→</span>
        <button type="button" onclick="goToStep(5)" id="step-5-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="color:var(--theme-text-muted, #8a8a8a);">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] bg-zinc-800 text-zinc-400">5</span>
          <span>Deploy</span>
        </button>
      </div>

      <div id="createAlert" class="hidden p-3.5 rounded-xl text-xs"></div>

      <!-- Creation Wizard Form -->
      <form id="createVMForm" onsubmit="event.preventDefault();">
        
        <!-- STEP 1: TEMPLATE & IDENTITY -->
        <div id="step-1" class="space-y-6">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Instance Identification & Base Image
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">
                  VM Name <span class="text-red-400">*</span>
                </label>
                <input type="text" id="vm_name" name="vm_name" placeholder="e.g. web-server-01" required class="al-input text-xs w-full">
                <p class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Lowercase letters, numbers, hyphens.</p>
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Hostname</label>
                <input type="text" id="hostname" name="hostname" placeholder="e.g. web-server" class="al-input text-xs w-full">
              </div>
            </div>

            <div class="space-y-1">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Assign to Tenant User</label>
              <select id="owner_id" name="owner_id" class="al-input text-xs w-full">
                <option value="">Loading users...</option>
              </select>
            </div>

            <div class="space-y-2 pt-2">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">
                Operating System Base Image <span class="text-red-400">*</span>
              </label>
              <div id="templateGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <div class="p-6 text-center text-xs col-span-full" style="color:var(--theme-text-muted, #8a8a8a)">Loading templates...</div>
              </div>
              <input type="hidden" id="os_template" name="os_template">
            </div>

            <div class="pt-2">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Or Select ISO File</label>
              <select id="iso_file" name="iso_file" onchange="handleIsoSelect()" class="al-input text-xs w-full">
                <option value="">— Use OS Template Instead —</option>
              </select>
            </div>
          </div>
        </div>

        <!-- STEP 2: HARDWARE RESOURCES -->
        <div id="step-2" class="hidden space-y-6">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Hardware Specifications
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Memory (MB) *</label>
                <input type="number" id="custom_memory" name="custom_memory" value="2048" min="512" step="512" required class="al-input text-xs w-full">
                <div class="flex gap-1 pt-1">
                  <button type="button" onclick="setMem(1024)" class="px-2 py-0.5 rounded text-[10px] border border-white/10 text-zinc-400 hover:text-white">1GB</button>
                  <button type="button" onclick="setMem(2048)" class="px-2 py-0.5 rounded text-[10px] border border-white/10 text-zinc-400 hover:text-white">2GB</button>
                  <button type="button" onclick="setMem(4096)" class="px-2 py-0.5 rounded text-[10px] border border-white/10 text-zinc-400 hover:text-white">4GB</button>
                  <button type="button" onclick="setMem(8192)" class="px-2 py-0.5 rounded text-[10px] border border-white/10 text-zinc-400 hover:text-white">8GB</button>
                </div>
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Storage Disk Size *</label>
                <div class="flex gap-2">
                  <input type="number" id="disk_size_num" value="20" min="5" max="2000" class="al-input text-xs flex-1">
                  <select id="disk_size_unit" class="al-input text-xs w-16">
                    <option value="G">GB</option>
                    <option value="T">TB</option>
                  </select>
                </div>
                <input type="hidden" id="disk_size" name="disk_size" value="20G">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">CPU Model</label>
                <select id="cpu_model" name="cpu_model" class="al-input text-xs w-full">
                  <option value="host">host (Pass-through)</option>
                </select>
              </div>
            </div>

            <!-- CPU Topology -->
            <div class="space-y-2 pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">vCPU Topology</span>
                <span class="text-xs font-mono text-indigo-400 font-semibold"><span id="totalCPUDisplay">2</span> Total vCPUs</span>
              </div>
              <div class="grid grid-cols-3 gap-3">
                <div class="space-y-1">
                  <label class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Sockets</label>
                  <input type="number" id="cpu_sockets" name="cpu_sockets" value="1" min="1" onchange="updateTotalCPU()" class="al-input text-xs w-full">
                </div>
                <div class="space-y-1">
                  <label class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Cores</label>
                  <input type="number" id="cpu_cores" name="cpu_cores" value="2" min="1" onchange="updateTotalCPU()" class="al-input text-xs w-full">
                </div>
                <div class="space-y-1">
                  <label class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Threads</label>
                  <input type="number" id="cpu_threads" name="cpu_threads" value="1" min="1" onchange="updateTotalCPU()" class="al-input text-xs w-full">
                </div>
              </div>
              <input type="hidden" id="custom_cpus" name="custom_cpus" value="2">
            </div>

            <!-- Custom CPU string -->
            <div class="pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="enable_custom_cpu_name" onchange="toggleCustomCPUName()" class="rounded text-indigo-600 focus:ring-0">
                <span class="text-xs" style="color:var(--theme-text, #e4e4e7)">Custom CPU Brand String (SMBIOS Spoofing)</span>
              </label>
              <div id="custom_cpu_name_section" class="hidden mt-2">
                <input type="text" id="custom_cpu_name" placeholder="e.g. AMD Ryzen 9 7950X 16-Core Processor" class="al-input text-xs w-full">
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: NETWORK -->
        <div id="step-3" class="hidden space-y-6">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Network Configuration
            </h2>

            <div class="space-y-3">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Network Mode</label>
              <div id="networkTypeGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
              <input type="hidden" id="network_type" name="network_type" value="nat">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">SSH Host Port</label>
                <input type="number" id="ssh_port" name="ssh_port" placeholder="Auto" class="al-input text-xs w-full">
              </div>
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">HTTP Host Port</label>
                <input type="number" id="http_port" name="http_port" placeholder="80" class="al-input text-xs w-full">
              </div>
              <div class="space-y-1">
                <div class="flex items-center justify-between">
                  <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">MAC Address</label>
                  <button type="button" onclick="genMAC()" class="text-[10px] text-indigo-400 hover:underline">Generate</button>
                </div>
                <input type="text" id="mac_address" name="mac_address" placeholder="fa:16:3e:xx:xx:xx" class="al-input text-xs w-full font-mono">
              </div>
            </div>

            <div id="staticIpCard" class="hidden pt-2">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Static IPv4 Address</label>
              <input type="text" id="ipv4_address" name="ipv4_address" placeholder="192.168.1.50" class="al-input text-xs w-full">
            </div>
          </div>
        </div>

        <!-- STEP 4: SECURITY & BIOS -->
        <div id="step-4" class="hidden space-y-6">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Credentials & BIOS Identity
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Guest Username</label>
                <input type="text" id="custom_username" name="custom_username" placeholder="ubuntu, root, or custom" class="al-input text-xs w-full">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Guest Password</label>
                <input type="password" id="custom_password" name="custom_password" placeholder="••••••••" class="al-input text-xs w-full">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">SMBIOS Manufacturer</label>
                <select id="smbios_manufacturer" name="smbios_manufacturer" onchange="toggleCustomManufacturer()" class="al-input text-xs w-full">
                  <option value="ASUS">ASUS</option>
                  <option value="Gigabyte">Gigabyte</option>
                  <option value="MSI">MSI</option>
                  <option value="Dell Inc.">Dell Inc.</option>
                  <option value="custom">Custom...</option>
                </select>
                <input type="text" id="custom_manufacturer" placeholder="Enter custom manufacturer" class="al-input text-xs w-full mt-2 hidden">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">SMBIOS Product Name</label>
                <select id="smbios_product" name="smbios_product" onchange="toggleCustomProduct()" class="al-input text-xs w-full">
                  <option value="ROG STRIX B550-F GAMING">ROG STRIX B550-F GAMING</option>
                  <option value="B450 AORUS PRO">B450 AORUS PRO</option>
                  <option value="PowerEdge R740">PowerEdge R740</option>
                  <option value="custom">Custom...</option>
                </select>
                <input type="text" id="custom_product" placeholder="Enter custom product" class="al-input text-xs w-full mt-2 hidden">
              </div>
            </div>

            <div class="pt-2">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="enable_acpi" name="enable_acpi" checked class="rounded text-indigo-600 focus:ring-0">
                <span class="text-xs" style="color:var(--theme-text, #e4e4e7)">Enable ACPI (Power management and clean shutdowns)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- STEP 5: REVIEW & DEPLOY -->
        <div id="step-5" class="hidden space-y-6">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Review Configuration & Provision Instance
            </h2>

            <div id="reviewContent" class="space-y-3"></div>

            <div id="createProgress" class="hidden space-y-2 pt-3">
              <div class="flex justify-between text-xs">
                <span id="createProgressText" style="color:var(--theme-text-strong, #fafafa)">Initializing deployment...</span>
              </div>
              <div class="w-full bg-zinc-800 h-1.5 rounded-full overflow-hidden">
                <div id="createProgressBar" class="bg-indigo-500 h-full rounded-full transition-all duration-300" style="width: 10%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Navigation Bar -->
        <div class="flex items-center justify-between pt-4">
          <button type="button" id="prevBtn" onclick="prevStep()" class="al-btn-secondary text-xs px-4 py-2 hidden flex items-center gap-1.5">
            <%- icon('arrow-left', { class: 'w-3.5 h-3.5' }) %>
            <span>Previous</span>
          </button>
          
          <div class="ml-auto flex items-center gap-2">
            <button type="button" id="nextBtn" onclick="nextStep()" class="al-btn-primary text-xs px-4 py-2 flex items-center gap-1.5">
              <span>Next</span>
              <%- icon('arrow-right', { class: 'w-3.5 h-3.5' }) %>
            </button>
            <button type="button" id="createBtn" onclick="submitCreate()" class="al-btn-success text-xs px-5 py-2 hidden flex items-center gap-1.5">
              <%- icon('rocket', { class: 'w-3.5 h-3.5' }) %>
              <span>Deploy Virtual Machine</span>
            </button>
          </div>
        </div>
      </form>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
let currentStep = 1;
const totalSteps = 5;
let osTemplates = {};

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

async function init() {
  await Promise.all([loadTemplates(), loadUsers(), loadCPUModels(), loadNetworkTypes(), loadISOList()]);
}

async function loadTemplates() {
  try {
    const res = await fetch('/api/os-templates');
    if (!res.ok) return;
    osTemplates = await res.json();
    const grid = document.getElementById('templateGrid');
    if (!grid) return;

    grid.innerHTML = Object.entries(osTemplates).map(([key, t]) => `
      <label class="al-card p-3 flex items-start gap-3 cursor-pointer transition-all border hover:border-indigo-500/50"
             style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08));">
        <input type="radio" name="_template" value="${key}" onchange="selectTemplate('${key}')" class="mt-0.5 text-indigo-600 focus:ring-0">
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">${escHtml(t.name || key)}</div>
          <div class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">${t.memory || 2048}MB RAM • ${t.disk_size || '20G'}</div>
        </div>
      </label>
    `).join('');

    const firstKey = Object.keys(osTemplates)[0];
    if (firstKey) selectTemplate(firstKey);
  } catch(e) {}
}

function selectTemplate(key) {
  document.getElementById('os_template').value = key;
  const tmpl = osTemplates[key];
  if (tmpl) {
    if (tmpl.memory) document.getElementById('custom_memory').value = tmpl.memory;
  }
}

async function loadUsers() {
  try {
    const res = await fetch('/api/users/list');
    if (!res.ok) return;
    const users = await res.json();
    const sel = document.getElementById('owner_id');
    if (!sel) return;
    sel.innerHTML = users.map(u => `<option value="${u.id}">${escHtml(u.username)} (${u.email || 'No email'})</option>`).join('');
  } catch(e) {}
}

async function loadCPUModels() {
  try {
    const res = await fetch('/api/cpu-models');
    if (!res.ok) return;
    const models = await res.json();
    const sel = document.getElementById('cpu_model');
    if (!sel) return;
    sel.innerHTML = Object.entries(models).map(([key, m]) =>
      `<option value="${key}" ${key === 'host' ? 'selected' : ''}>${m.name} — ${m.description}</option>`
    ).join('');
  } catch(e) {}
}

async function loadNetworkTypes() {
  try {
    const res = await fetch('/api/network-types');
    if (!res.ok) return;
    const types = await res.json();
    const grid = document.getElementById('networkTypeGrid');
    if (!grid) return;
    grid.innerHTML = Object.entries(types).map(([key, t], i) => `
      <label class="al-card p-3 flex items-start gap-3 cursor-pointer border"
             style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08));">
        <input type="radio" name="_network_type" value="${key}" ${i === 0 ? 'checked' : ''} onchange="selectNetwork('${key}')" class="mt-0.5 text-indigo-600 focus:ring-0">
        <div>
          <div class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">${escHtml(t.name)}</div>
          <div class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">${escHtml(t.description || '')}</div>
        </div>
      </label>
    `).join('');
  } catch(e) {}
}

function selectNetwork(key) {
  document.getElementById('network_type').value = key;
  const staticCard = document.getElementById('staticIpCard');
  if (staticCard) staticCard.style.display = (key === 'static_public') ? 'block' : 'none';
}

async function loadISOList() {
  try {
    const res = await fetch('/api/iso-list');
    if (!res.ok) return;
    const isos = await res.json();
    const sel = document.getElementById('iso_file');
    if (!sel) return;
    if (isos.length === 0) {
      sel.innerHTML = '<option value="">— No ISO files available on node —</option>';
    } else {
      sel.innerHTML = '<option value="">— Use OS Template Instead —</option>' +
        isos.map(iso => `<option value="${iso}">${iso}</option>`).join('');
    }
  } catch(e) {}
}

function handleIsoSelect() {
  const iso = document.getElementById('iso_file').value;
  if (iso) {
    document.getElementById('os_template').value = '';
    document.querySelectorAll('input[name="_template"]').forEach(r => r.checked = false);
  }
}

function setMem(val) {
  document.getElementById('custom_memory').value = val;
}

function updateTotalCPU() {
  const s = parseInt(document.getElementById('cpu_sockets')?.value) || 1;
  const c = parseInt(document.getElementById('cpu_cores')?.value) || 1;
  const t = parseInt(document.getElementById('cpu_threads')?.value) || 1;
  const total = s * c * t;
  document.getElementById('totalCPUDisplay').textContent = total;
  document.getElementById('custom_cpus').value = total;
}

function toggleCustomCPUName() {
  const checked = document.getElementById('enable_custom_cpu_name').checked;
  const sec = document.getElementById('custom_cpu_name_section');
  sec.classList.toggle('hidden', !checked);
}

function toggleCustomManufacturer() {
  const val = document.getElementById('smbios_manufacturer').value;
  const input = document.getElementById('custom_manufacturer');
  input.classList.toggle('hidden', val !== 'custom');
}

function toggleCustomProduct() {
  const val = document.getElementById('smbios_product').value;
  const input = document.getElementById('custom_product');
  input.classList.toggle('hidden', val !== 'custom');
}

function genMAC() {
  const mac = 'fa:16:3e:' + [0,1,2].map(() => Math.floor(Math.random()*256).toString(16).padStart(2,'0')).join(':');
  document.getElementById('mac_address').value = mac;
}

function goToStep(step) {
  for (let i = 1; i <= totalSteps; i++) {
    const pane = document.getElementById(`step-${i}`);
    const btn = document.getElementById(`step-${i}-btn`);
    if (pane) pane.classList.toggle('hidden', i !== step);
    if (btn) {
      if (i === step) {
        btn.style.background = 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))';
        btn.style.color = 'var(--theme-text-strong, #fafafa)';
      } else {
        btn.style.background = 'transparent';
        btn.style.color = 'var(--theme-text-muted, #8a8a8a)';
      }
    }
  }
  currentStep = step;
  document.getElementById('prevBtn').classList.toggle('hidden', step === 1);
  document.getElementById('nextBtn').classList.toggle('hidden', step === totalSteps);
  document.getElementById('createBtn').classList.toggle('hidden', step !== totalSteps);
  if (step === totalSteps) buildReview();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function nextStep() {
  if (currentStep === 1) {
    const name = document.getElementById('vm_name').value.trim();
    if (!name) { alert('VM Name is required'); return; }
  }
  if (currentStep < totalSteps) goToStep(currentStep + 1);
}

function prevStep() {
  if (currentStep > 1) goToStep(currentStep - 1);
}

function collectFormData() {
  const form = document.getElementById('createVMForm');
  const fd = new FormData(form);
  const data = {};
  fd.forEach((v, k) => { if (!k.startsWith('_')) data[k] = v; });
  
  data.enable_kvm = 1;
  data.enable_acpi = document.getElementById('enable_acpi')?.checked ? 1 : 0;
  
  const num = document.getElementById('disk_size_num')?.value || '20';
  const unit = document.getElementById('disk_size_unit')?.value || 'G';
  data.disk_size = num + unit;

  if (document.getElementById('enable_custom_cpu_name')?.checked) {
    data.custom_cpu_name = document.getElementById('custom_cpu_name')?.value.trim();
  }
  if (document.getElementById('smbios_manufacturer')?.value === 'custom') {
    data.smbios_manufacturer = document.getElementById('custom_manufacturer')?.value.trim();
  }
  if (document.getElementById('smbios_product')?.value === 'custom') {
    data.smbios_product = document.getElementById('custom_product')?.value.trim();
  }
  return data;
}

function buildReview() {
  const data = collectFormData();
  const el = document.getElementById('reviewContent');
  el.innerHTML = `
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
      <div class="p-3 rounded-lg border space-y-1.5" style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div class="text-[10px] font-sans uppercase text-indigo-400 font-semibold">Instance Details</div>
        <div>Name: <strong>${escHtml(data.vm_name)}</strong></div>
        <div>Hostname: ${escHtml(data.hostname || data.vm_name)}</div>
        <div>Base Image: ${escHtml(data.os_template || data.iso_file || 'Custom')}</div>
      </div>
      <div class="p-3 rounded-lg border space-y-1.5" style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div class="text-[10px] font-sans uppercase text-emerald-400 font-semibold">Hardware Allocation</div>
        <div>RAM: ${data.custom_memory} MB</div>
        <div>vCPUs: ${data.custom_cpus} Cores</div>
        <div>Disk: ${data.disk_size}</div>
      </div>
    </div>
  `;
}

async function submitCreate() {
  const btn = document.getElementById('createBtn');
  const alert = document.getElementById('createAlert');
  const prog = document.getElementById('createProgress');
  const bar = document.getElementById('createProgressBar');
  
  btn.disabled = true;
  alert.classList.add('hidden');
  prog.classList.remove('hidden');
  bar.style.width = '30%';

  try {
    const data = collectFormData();
    const res = await fetch('/api/vms', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    bar.style.width = '80%';
    const result = await res.json();
    if (res.ok && result.success) {
      bar.style.width = '100%';
      alert.classList.remove('hidden');
      alert.style.cssText = 'background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);';
      alert.textContent = `VM "${data.vm_name}" provisioned successfully! Redirecting...`;
      setTimeout(() => {
        window.location.href = `/admin/vm/${result.vm_id}`;
      }, 1200);
    } else {
      throw new Error(result.error || 'Provisioning failed');
    }
  } catch(e) {
    prog.classList.add('hidden');
    alert.classList.remove('hidden');
    alert.style.cssText = 'background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2);';
    alert.textContent = e.message;
    btn.disabled = false;
  }
}

init();
</script>
