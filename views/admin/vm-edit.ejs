<%- include('../components/header', { title: 'Edit VM #' + vmId }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Virtual Machines', href: '/admin/vms' },
      { label: 'VM #' + vmId, href: '/admin/vm/' + vmId },
      { label: 'Edit Configuration' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-5xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
            Edit VM Configuration <span class="text-sm font-normal" style="color:var(--theme-text-muted, #8a8a8a)">(<%= vm ? vm.vm_name : vmId %>)</span>
          </h1>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Update hardware quotas, network parameters, and hypervisor SMBIOS properties.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/vm/<%= vmId %>" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('arrow-left', { class: 'w-3.5 h-3.5' }) %>
            <span>Back to VM</span>
          </a>
        </div>
      </div>

      <% if (vm && vm.status !== 'stopped') { %>
        <div class="p-3.5 rounded-xl border flex items-center gap-2.5 text-xs"
             style="background:rgba(245, 158, 11, 0.12); color:#fbbf24; border-color:rgba(245, 158, 11, 0.2);">
          <%- icon('triangle-alert', { class: 'w-4 h-4 shrink-0 text-amber-400' }) %>
          <div>
            <strong>Instance is currently running!</strong> Guest OS should be stopped before editing hardware or network topology.
          </div>
        </div>
      <% } %>

      <div id="editAlert" class="hidden p-3.5 rounded-xl text-xs"></div>

      <!-- Tab Navigation -->
      <div class="flex gap-1.5 border-b pb-2" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <button type="button" onclick="switchEditTab('basic', this)" class="edit-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium"
                style="background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);">
          Basic Settings
        </button>
        <button type="button" onclick="switchEditTab('hardware', this)" class="edit-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Hardware
        </button>
        <button type="button" onclick="switchEditTab('network', this)" class="edit-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Network
        </button>
        <button type="button" onclick="switchEditTab('bios', this)" class="edit-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium"
                style="color:var(--theme-text-muted, #8a8a8a);">
          BIOS / Identity
        </button>
      </div>

      <!-- Edit Form -->
      <form id="editForm" onsubmit="saveChanges(event)" class="space-y-6">
        
        <!-- BASIC TAB -->
        <div id="tab-basic" class="edit-tab-pane space-y-4">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              General Properties
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">VM Name *</label>
                <input type="text" name="vm_name" value="<%= vm ? vm.vm_name : '' %>" required class="al-input text-xs w-full">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Hostname</label>
                <input type="text" name="hostname" value="<%= vm ? (vm.hostname || '') : '' %>" class="al-input text-xs w-full">
              </div>
            </div>

            <div class="space-y-1">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Owner Account</label>
              <select id="ownerSelect" name="owner_id" class="al-input text-xs w-full">
                <option value="">Loading users...</option>
              </select>
            </div>
          </div>
        </div>

        <!-- HARDWARE TAB -->
        <div id="tab-hardware" class="edit-tab-pane hidden space-y-4">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Memory & Processor Quotas
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Memory (MB) *</label>
                <input type="number" name="memory" value="<%= vm ? vm.memory : 2048 %>" min="512" step="256" required class="al-input text-xs w-full">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">CPU Model</label>
                <select id="edit_cpu_model" name="cpu_model" class="al-input text-xs w-full">
                  <option value="host">host (Pass-through)</option>
                </select>
              </div>
            </div>

            <div class="space-y-2 pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <div class="text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">CPU Topology</div>
              <div class="grid grid-cols-3 gap-3">
                <div class="space-y-1">
                  <label class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Sockets</label>
                  <input type="number" name="cpu_sockets" value="<%= vm ? (vm.cpu_sockets || 1) : 1 %>" min="1" onchange="updateEditCPU()" class="al-input text-xs w-full">
                </div>
                <div class="space-y-1">
                  <label class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Cores</label>
                  <input type="number" name="cpu_cores" value="<%= vm ? (vm.cpu_cores || 2) : 2 %>" min="1" onchange="updateEditCPU()" class="al-input text-xs w-full">
                </div>
                <div class="space-y-1">
                  <label class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Threads</label>
                  <input type="number" name="cpu_threads" value="<%= vm ? (vm.cpu_threads || 1) : 1 %>" min="1" onchange="updateEditCPU()" class="al-input text-xs w-full">
                </div>
              </div>
              <input type="hidden" id="edit_cpus" name="cpus" value="<%= vm ? vm.cpus : 2 %>">
            </div>

            <div class="pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="enable_custom_cpu_name_edit" onchange="toggleEditCustomCPUName()" <%= vm && vm.custom_cpu_name ? 'checked' : '' %> class="rounded text-indigo-600 focus:ring-0">
                <span class="text-xs" style="color:var(--theme-text, #e4e4e7)">Custom CPU Brand String</span>
              </label>
              <div id="custom_cpu_name_section_edit" class="<%= vm && vm.custom_cpu_name ? '' : 'hidden' %> mt-2">
                <input type="text" id="custom_cpu_name_edit" name="custom_cpu_name" value="<%= vm ? (vm.custom_cpu_name || '') : '' %>" placeholder="e.g. Intel Core i9-14900K" class="al-input text-xs w-full">
              </div>
            </div>
          </div>
        </div>

        <!-- NETWORK TAB -->
        <div id="tab-network" class="edit-tab-pane hidden space-y-4">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Network Properties
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Network Type</label>
                <select id="networkTypeSelect" name="network_type" onchange="updateNetworkFields()" class="al-input text-xs w-full">
                  <option value="nat" <%= vm && vm.network_type === 'nat' ? 'selected' : '' %>>NAT (User Mode)</option>
                  <option value="static_public" <%= vm && vm.network_type === 'static_public' ? 'selected' : '' %>>Static Public IP (Bridge)</option>
                </select>
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">MAC Address</label>
                <input type="text" name="mac_address" value="<%= vm ? (vm.mac_address || '') : '' %>" class="al-input text-xs w-full font-mono">
              </div>
            </div>

            <div id="portForwardingCard" class="<%= vm && vm.network_type === 'static_public' ? 'hidden' : '' %> grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">SSH Host Port</label>
                <input type="number" name="ssh_port" value="<%= vm ? (vm.ssh_port || vm.ssh_port_static || '') : '' %>" class="al-input text-xs w-full">
              </div>
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">HTTP Host Port</label>
                <input type="number" name="http_port" value="<%= vm ? (vm.http_port || '') : '' %>" class="al-input text-xs w-full">
              </div>
            </div>

            <div id="staticIpFields" class="<%= vm && vm.network_type === 'static_public' ? '' : 'hidden' %> grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">IPv4 Address</label>
                <input type="text" name="ipv4_address" value="<%= vm ? (vm.ipv4_address || '') : '' %>" class="al-input text-xs w-full">
              </div>
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">IPv4 Gateway</label>
                <input type="text" name="ipv4_gateway" value="<%= vm ? (vm.ipv4_gateway || '') : '' %>" class="al-input text-xs w-full">
              </div>
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">IPv4 Netmask</label>
                <input type="text" name="ipv4_netmask" value="<%= vm ? (vm.ipv4_netmask || '') : '' %>" class="al-input text-xs w-full">
              </div>
            </div>
          </div>
        </div>

        <!-- BIOS / IDENTITY TAB -->
        <div id="tab-bios" class="edit-tab-pane hidden space-y-4">
          <div class="al-card p-5 space-y-4">
            <h2 class="text-sm font-semibold border-b pb-3" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Hypervisor SMBIOS Properties
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Manufacturer</label>
                <input type="text" name="smbios_manufacturer" value="<%= vm ? (vm.smbios_manufacturer || 'ASUS') : 'ASUS' %>" class="al-input text-xs w-full">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Product Name</label>
                <input type="text" name="smbios_product" value="<%= vm ? (vm.smbios_product || 'System Product') : 'System Product' %>" class="al-input text-xs w-full">
              </div>
            </div>

            <div class="pt-2">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="edit_acpi" name="enable_acpi" <%= !vm || vm.enable_acpi ? 'checked' : '' %> class="rounded text-indigo-600 focus:ring-0">
                <span class="text-xs" style="color:var(--theme-text, #e4e4e7)">Enable ACPI</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Submit Controls -->
        <div class="flex items-center justify-end gap-3 pt-2">
          <a href="/admin/vm/<%= vmId %>" class="al-btn-secondary text-xs px-4 py-2">Cancel</a>
          <button type="submit" id="saveBtn" class="al-btn-primary text-xs px-5 py-2 flex items-center gap-1.5">
            <%- icon('save', { class: 'w-3.5 h-3.5' }) %>
            <span>Save Configuration</span>
          </button>
        </div>
      </form>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
const vmId = <%= vmId %>;

function switchEditTab(tab, btn) {
  document.querySelectorAll('.edit-tab-btn').forEach(b => {
    b.style.background = 'transparent';
    b.style.color = 'var(--theme-text-muted, #8a8a8a)';
  });
  btn.style.background = 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))';
  btn.style.color = 'var(--theme-text-strong, #fafafa)';

  document.querySelectorAll('.edit-tab-pane').forEach(p => {
    p.classList.toggle('hidden', p.id !== `tab-${tab}`);
  });
}

function toggleEditCustomCPUName() {
  const checked = document.getElementById('enable_custom_cpu_name_edit').checked;
  document.getElementById('custom_cpu_name_section_edit').classList.toggle('hidden', !checked);
}

function updateEditCPU() {
  const s = parseInt(document.querySelector('input[name="cpu_sockets"]')?.value || 1);
  const c = parseInt(document.querySelector('input[name="cpu_cores"]')?.value || 2);
  const t = parseInt(document.querySelector('input[name="cpu_threads"]')?.value || 1);
  const total = s * c * t;
  const f = document.getElementById('edit_cpus');
  if (f) f.value = total;
}

function updateNetworkFields() {
  const type = document.getElementById('networkTypeSelect').value;
  document.getElementById('portForwardingCard').classList.toggle('hidden', type !== 'nat');
  document.getElementById('staticIpFields').classList.toggle('hidden', type !== 'static_public');
}

async function loadUsers() {
  try {
    const res = await fetch('/api/users/list');
    if (!res.ok) return;
    const users = await res.json();
    const sel = document.getElementById('ownerSelect');
    if (!sel) return;
    sel.innerHTML = users.map(u => `<option value="${u.id}" ${u.id === <%= vm ? vm.owner_id : 0 %> ? 'selected' : ''}>${u.username} (${u.role})</option>`).join('');
  } catch(e) {}
}

async function loadCPUModels() {
  try {
    const res = await fetch('/api/cpu-models');
    if (!res.ok) return;
    const models = await res.json();
    const sel = document.getElementById('edit_cpu_model');
    if (!sel) return;
    const curr = '<%= vm ? vm.cpu_model : "host" %>';
    sel.innerHTML = Object.entries(models).map(([k, m]) => `<option value="${k}" ${k === curr ? 'selected' : ''}>${m.name}</option>`).join('');
  } catch(e) {}
}

async function saveChanges(e) {
  e.preventDefault();
  const btn = document.getElementById('saveBtn');
  const alert = document.getElementById('editAlert');
  alert.classList.add('hidden');
  btn.disabled = true;

  try {
    const form = document.getElementById('editForm');
    const fd = new FormData(form);
    const data = {};
    fd.forEach((v, k) => { data[k] = v; });
    data.enable_kvm = 1;
    data.enable_acpi = document.getElementById('edit_acpi')?.checked ? 1 : 0;

    const res = await fetch(`/api/vms/${vmId}/edit`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    const result = await res.json();
    if (res.ok && result.success) {
      alert.classList.remove('hidden');
      alert.style.cssText = 'background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);';
      alert.textContent = 'Configuration saved successfully!';
      setTimeout(() => {
        window.location.href = `/admin/vm/${vmId}`;
      }, 1000);
    } else {
      throw new Error(result.error || 'Failed to save');
    }
  } catch(err) {
    alert.classList.remove('hidden');
    alert.style.cssText = 'background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2);';
    alert.textContent = err.message;
    btn.disabled = false;
  }
}

loadUsers();
loadCPUModels();
</script>
