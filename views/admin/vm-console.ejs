<%- include('../components/header', { title: 'Admin Console #' + vmId }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Virtual Machines', href: '/admin/vms' },
      { label: 'VM #' + vmId, href: '/admin/vm/' + vmId },
      { label: 'Console' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto flex flex-col space-y-4">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
              VM Console <span id="vmNameLabel" class="text-sm font-normal" style="color:var(--theme-text-muted, #8a8a8a)"></span>
            </h1>
            <span id="wsStatus" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium"
              style="background:rgba(245, 158, 11, 0.12); color:#fbbf24; border:1px solid rgba(245, 158, 11, 0.2);">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span>Connecting...</span>
            </span>
          </div>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Administrative serial console stream for instance #<%= vmId %>.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/vm/<%= vmId %>" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('arrow-left', { class: 'w-3.5 h-3.5' }) %>
            <span>Back to VM</span>
          </a>
          <button type="button" onclick="clearTerminal()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3" title="Clear console">
            <%- icon('trash-2', { class: 'w-3.5 h-3.5' }) %>
            <span>Clear</span>
          </button>
          <button type="button" onclick="scrollToBottom()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3" title="Scroll to bottom">
            <%- icon('arrow-down', { class: 'w-3.5 h-3.5' }) %>
            <span>Bottom</span>
          </button>
          <button type="button" onclick="toggleWrap()" id="wrapBtn" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3" title="Toggle word wrap">
            <%- icon('wrap-text', { class: 'w-3.5 h-3.5' }) %>
            <span>Wrap</span>
          </button>
        </div>
      </div>

      <!-- Terminal Card -->
      <div class="al-card flex-1 flex flex-col min-h-[520px] rounded-xl overflow-hidden shadow-lg"
           style="border:1px solid var(--theme-border, rgba(255,255,255,0.1)); background:var(--theme-bg-card, #141414);">
        
        <!-- Terminal Header Bar -->
        <div class="flex items-center justify-between px-4 py-2.5 shrink-0 border-b"
             style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border, rgba(255,255,255,0.1));">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            <span class="ml-2 text-xs font-mono select-none" style="color:var(--theme-text-muted, #8a8a8a)">admin@node: serial0 (VM #<%= vmId %>)</span>
          </div>
          <div class="text-[11px] font-mono" style="color:var(--theme-text-muted, #8a8a8a)">
            WebSocket Session
          </div>
        </div>

        <!-- Terminal Output Area -->
        <div id="terminal"
             class="flex-1 p-4 font-mono text-[13px] leading-relaxed overflow-y-auto whitespace-pre-wrap break-all select-text"
             style="background:#09090b; color:#e4e4e7; font-family:'JetBrains Mono', 'Fira Code', 'Courier New', monospace; min-height:420px;">
          <span style="color:var(--theme-primary, #6366f1);"><%= siteName %></span> - Administrative VM Console (ID: <%= vmId %>)
          <span style="color:#71717a;">Connecting to WebSocket stream...</span>
        </div>

        <!-- Terminal Input Bar -->
        <div class="flex items-center gap-2 p-2.5 border-t shrink-0"
             style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border, rgba(255,255,255,0.1));">
          <span class="font-mono text-xs font-semibold px-2" style="color:var(--theme-primary, #6366f1); white-space:nowrap;">
            vm@<%= vmId %>:~$
          </span>
          <input
            type="text"
            id="cmdInput"
            placeholder="Type a command and press Enter..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            class="al-input flex-1 font-mono text-xs py-2 bg-transparent border-0 focus:ring-0"
            style="color:var(--theme-text-strong, #fafafa);"
          />
          <button type="button" onclick="sendCommand()" class="al-btn-primary text-xs px-3.5 py-2 shrink-0 flex items-center gap-1.5">
            <span>Send</span>
            <%- icon('corner-down-left', { class: 'w-3 h-3' }) %>
          </button>
        </div>
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<style>
  #terminal::-webkit-scrollbar { width: 6px; }
  #terminal::-webkit-scrollbar-track { background: #09090b; }
  #terminal::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }
  #terminal::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.25); }

  .ansi-green { color: #10b981; }
  .ansi-red { color: #ef4444; }
  .ansi-yellow { color: #f59e0b; }
  .ansi-blue { color: #60a5fa; }
  .ansi-cyan { color: #22d3ee; }
  .ansi-white { color: #f1f5f9; }
  .ansi-gray { color: #71717a; }
  .ansi-bold { font-weight: bold; }
</style>

<script>
const vmId = <%= vmId %>;
let ws = null;
let commandHistory = [];
let historyIndex = -1;
let autoScroll = true;
let wordWrap = true;

// Load VM name
fetch(`/api/vms/${vmId}`)
  .then(r => r.json())
  .then(vm => {
    const label = document.getElementById('vmNameLabel');
    if (label && vm.vm_name) label.textContent = `(${vm.vm_name})`;
  })
  .catch(() => {});

// Connect WebSocket
function connectWS() {
  const wsUrl = `${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/console/${vmId}`;
  updateWSStatus('connecting');
  
  try {
    ws = new WebSocket(wsUrl);
    ws.binaryType = 'arraybuffer';
    
    ws.onopen = () => {
      updateWSStatus('connected');
      appendOutput('\r\n\x1b[32m✓ WebSocket connected\x1b[0m\r\n');
    };
    
    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.type === 'output' && msg.data) {
          appendOutput(msg.data);
        }
      } catch(e) {
        if (typeof event.data === 'string') {
          appendOutput(event.data);
        }
      }
    };
    
    ws.onclose = () => {
      updateWSStatus('disconnected');
      appendOutput('\r\n\x1b[31m✗ Connection closed\x1b[0m\r\n');
      setTimeout(connectWS, 3000);
    };
    
    ws.onerror = () => {
      updateWSStatus('error');
      appendOutput('\r\n\x1b[31m✗ WebSocket error\x1b[0m\r\n');
    };
  } catch(e) {
    updateWSStatus('error');
    appendOutput(`\r\n\x1b[31m✗ Connection error: ${e.message}\x1b[0m\r\n`);
    setTimeout(connectWS, 3000);
  }
}

function updateWSStatus(state) {
  const el = document.getElementById('wsStatus');
  if (!el) return;
  const states = {
    connecting: { 
      html: '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span><span>Connecting...</span>', 
      style: 'background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.2);' 
    },
    connected: { 
      html: '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span>Connected</span>', 
      style: 'background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);' 
    },
    disconnected: { 
      html: '<span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span><span>Disconnected</span>', 
      style: 'background: rgba(113, 113, 122, 0.12); color: #a1a1aa; border: 1px solid rgba(113, 113, 122, 0.2);' 
    },
    error: { 
      html: '<span class="w-1.5 h-1.5 rounded-full bg-red-400"></span><span>Error</span>', 
      style: 'background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2);' 
    }
  };
  const s = states[state] || states.disconnected;
  el.innerHTML = s.html;
  el.style.cssText = s.style;
}

function parseAnsi(text) {
  return text
    .replace(/\x1b\[32m/g, '<span class="ansi-green">')
    .replace(/\x1b\[31m/g, '<span class="ansi-red">')
    .replace(/\x1b\[33m/g, '<span class="ansi-yellow">')
    .replace(/\x1b\[34m/g, '<span class="ansi-blue">')
    .replace(/\x1b\[36m/g, '<span class="ansi-cyan">')
    .replace(/\x1b\[37m/g, '<span class="ansi-white">')
    .replace(/\x1b\[0m/g, '</span>')
    .replace(/\x1b\[1m/g, '<span class="ansi-bold">')
    .replace(/\x1b\[\d+m/g, '')
    .replace(/\x1b\[\d+;\d+m/g, '')
    .replace(/\x1b\[\d+;\d+;\d+m/g, '')
    .replace(/\x1b\[[\d;]*[A-Za-z]/g, '');
}

function appendOutput(text) {
  const terminal = document.getElementById('terminal');
  if (!terminal) return;
  
  const parsed = parseAnsi(escTerminal(text));
  const span = document.createElement('span');
  span.innerHTML = parsed;
  terminal.appendChild(span);
  
  if (autoScroll) {
    terminal.scrollTop = terminal.scrollHeight;
  }
  
  const children = terminal.children;
  if (children.length > 5000) {
    terminal.removeChild(children[0]);
  }
}

function escTerminal(str) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\r\n/g, '\n')
    .replace(/\n/g, '<br>');
}

function clearTerminal() {
  const terminal = document.getElementById('terminal');
  terminal.innerHTML = '';
  appendOutput('\x1b[36m[Console cleared]\x1b[0m\r\n');
}

function scrollToBottom() {
  const terminal = document.getElementById('terminal');
  terminal.scrollTop = terminal.scrollHeight;
  autoScroll = true;
}

function toggleWrap() {
  const terminal = document.getElementById('terminal');
  const btn = document.getElementById('wrapBtn');
  wordWrap = !wordWrap;
  terminal.style.whiteSpace = wordWrap ? 'pre-wrap' : 'pre';
  terminal.style.wordBreak = wordWrap ? 'break-all' : 'normal';
  if (btn) {
    btn.style.color = wordWrap ? 'var(--theme-primary, #6366f1)' : '';
  }
}

document.getElementById('terminal')?.addEventListener('scroll', function() {
  const el = this;
  autoScroll = el.scrollTop + el.clientHeight >= el.scrollHeight - 10;
});

function sendCommand() {
  const input = document.getElementById('cmdInput');
  const cmd = input.value;
  
  if (!cmd.trim() && cmd !== '') return;
  
  if (cmd.trim()) {
    commandHistory.unshift(cmd);
    if (commandHistory.length > 100) commandHistory.pop();
    historyIndex = -1;
  }
  
  appendOutput(`\r\n<span class="ansi-green">vm@${vmId}:~$</span> ${escTerminal(cmd)}\r\n`);
  
  if (ws && ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify({ type: 'input', data: cmd + '\n' }));
  } else {
    fetch(`/api/vms/${vmId}/console/command`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: cmd })
    }).catch(() => {});
  }
  
  input.value = '';
}

document.getElementById('cmdInput')?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    sendCommand();
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    historyIndex = Math.min(historyIndex + 1, commandHistory.length - 1);
    if (commandHistory[historyIndex]) {
      document.getElementById('cmdInput').value = commandHistory[historyIndex];
    }
  } else if (e.key === 'ArrowDown') {
    e.preventDefault();
    historyIndex = Math.max(historyIndex - 1, -1);
    document.getElementById('cmdInput').value = historyIndex >= 0 ? (commandHistory[historyIndex] || '') : '';
  } else if (e.key === 'l' && e.ctrlKey) {
    e.preventDefault();
    clearTerminal();
  }
});

connectWS();
document.getElementById('cmdInput')?.focus();

setTimeout(() => {
  const t = document.getElementById('terminal');
  if (t) t.scrollTop = t.scrollHeight;
}, 500);
</script>
