<%- include('../components/header', { title: 'VM Details #' + vmId }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Virtual Machines', href: '/admin/vms' },
      { label: 'VM #' + vmId }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Top VM Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)" id="vmTitle">
              VM #<%= vmId %>
            </h1>
            <span id="statusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium"
                  style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.08));">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
              <span id="statusText">Loading...</span>
            </span>
          </div>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)" id="vmSubtitle">
            Managing virtualization guest instance.
          </p>
        </div>

        <!-- Power & Management Controls -->
        <div class="flex items-center flex-wrap gap-2">
          <button type="button" id="startBtn" onclick="doAction('start')" class="al-btn-success text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('play', { class: 'w-3.5 h-3.5' }) %>
            <span>Start</span>
          </button>
          <button type="button" id="stopBtn" onclick="doAction('stop')" class="al-btn-danger text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('square', { class: 'w-3.5 h-3.5' }) %>
            <span>Stop</span>
          </button>
          <button type="button" id="restartBtn" onclick="doAction('restart')" class="al-btn-secondary text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5' }) %>
            <span>Reboot</span>
          </button>
          
          <div class="h-4 w-px bg-white/10 mx-0.5"></div>

          <a href="/admin/vm/<%= vmId %>/console" class="al-btn-secondary text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('terminal', { class: 'w-3.5 h-3.5' }) %>
            <span>Console</span>
          </a>
          <a href="/admin/vm/<%= vmId %>/ssh" class="al-btn-secondary text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('link', { class: 'w-3.5 h-3.5' }) %>
            <span>SSH</span>
          </a>
          <a href="/admin/vm/<%= vmId %>/edit" class="al-btn-secondary text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('settings', { class: 'w-3.5 h-3.5' }) %>
            <span>Edit Config</span>
          </a>
        </div>
      </div>

      <!-- Quick Metrics Row -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="al-card p-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Memory</span>
            <%- icon('hard-drive', { class: 'w-4 h-4 text-emerald-400' }) %>
          </div>
          <p id="statMemory" class="text-xl font-bold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <span class="text-[11px] mt-1 block" style="color:var(--theme-text-muted, #8a8a8a)">Allocated RAM</span>
        </div>

        <div class="al-card p-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">vCPUs</span>
            <%- icon('cpu', { class: 'w-4 h-4 text-pink-400' }) %>
          </div>
          <p id="statCPUs" class="text-xl font-bold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <span class="text-[11px] mt-1 block" style="color:var(--theme-text-muted, #8a8a8a)">Core Topology</span>
        </div>

        <div class="al-card p-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Disk Size</span>
            <%- icon('disc', { class: 'w-4 h-4 text-cyan-400' }) %>
          </div>
          <p id="statDisk" class="text-xl font-bold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <span class="text-[11px] mt-1 block" style="color:var(--theme-text-muted, #8a8a8a)">Virtual Storage</span>
        </div>

        <div class="al-card p-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">IP Address</span>
            <%- icon('globe', { class: 'w-4 h-4 text-blue-400' }) %>
          </div>
          <p id="statIP" class="text-xl font-bold mt-2 tabular-nums truncate font-mono text-sm" style="color:var(--theme-text-strong, #fafafa)">—</p>
          <span class="text-[11px] mt-1 block" style="color:var(--theme-text-muted, #8a8a8a)" id="statSSHPort">Port: 22</span>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex gap-1.5 border-b pb-2" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <button type="button" onclick="switchTab('overview')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium active" data-tab="overview"
                style="background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);">
          Overview
        </button>
        <button type="button" onclick="switchTab('hardware')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium" data-tab="hardware"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Hardware
        </button>
        <button type="button" onclick="switchTab('network')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium" data-tab="network"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Network
        </button>
        <button type="button" onclick="switchTab('snapshots')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium" data-tab="snapshots"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Snapshots
        </button>
        <button type="button" onclick="switchTab('iso')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium" data-tab="iso"
                style="color:var(--theme-text-muted, #8a8a8a);">
          ISO Drive
        </button>
        <button type="button" onclick="switchTab('logs')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium" data-tab="logs"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Audit Logs
        </button>
        <button type="button" onclick="switchTab('danger')" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-red-400" data-tab="danger">
          Danger Zone
        </button>
      </div>

      <!-- Tab Panes -->
      <div>
        <!-- OVERVIEW TAB -->
        <div id="tab-overview" class="tab-pane space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="al-card p-5 space-y-3">
              <h3 class="text-sm font-semibold border-b pb-2" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
                System Identification
              </h3>
              <div class="space-y-2 text-xs">
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">Instance Name</span>
                  <span id="detailName" class="font-medium" style="color:var(--theme-text, #e4e4e7)">—</span>
                </div>
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">Operating System</span>
                  <span id="detailOS" class="font-medium" style="color:var(--theme-text, #e4e4e7)">—</span>
                </div>
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">Owner Account</span>
                  <span id="detailOwner" class="font-medium" style="color:var(--theme-text, #e4e4e7)">—</span>
                </div>
                <div class="flex justify-between py-1">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">Created Date</span>
                  <span id="detailCreated" class="font-mono" style="color:var(--theme-text, #e4e4e7)">—</span>
                </div>
              </div>
            </div>

            <div class="al-card p-5 space-y-3">
              <h3 class="text-sm font-semibold border-b pb-2" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
                Quick Access SSH
              </h3>
              <div class="p-3 rounded-lg font-mono text-xs select-all flex items-center justify-between"
                   style="background:var(--theme-bg-secondary, #1a1a1a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.06)); color:var(--theme-text, #e4e4e7)">
                <span id="sshCmd">ssh user@host -p 22</span>
                <button type="button" onclick="copySSH()" class="text-zinc-400 hover:text-white p-1">
                  <%- icon('copy', { class: 'w-3.5 h-3.5' }) %>
                </button>
              </div>
              <p class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">
                Use this command to connect directly from terminal or OpenSSH client.
              </p>
            </div>
          </div>
        </div>

        <!-- HARDWARE TAB -->
        <div id="tab-hardware" class="tab-pane hidden space-y-6">
          <div class="al-card p-5 space-y-3">
            <h3 class="text-sm font-semibold border-b pb-2" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Processor & Memory Details
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div class="space-y-2">
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">Sockets × Cores × Threads</span>
                  <span id="hwTopology" class="font-mono" style="color:var(--theme-text, #e4e4e7)">1S × 2C × 1T</span>
                </div>
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">CPU Architecture / Model</span>
                  <span id="hwCPUModel" class="font-mono" style="color:var(--theme-text, #e4e4e7)">host-passthrough</span>
                </div>
              </div>
              <div class="space-y-2">
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">RAM Size</span>
                  <span id="hwMemory" class="font-mono" style="color:var(--theme-text, #e4e4e7)">2048 MB</span>
                </div>
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">ACPI Support</span>
                  <span id="hwACPI" class="font-mono" style="color:var(--theme-text, #e4e4e7)">Enabled</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- NETWORK TAB -->
        <div id="tab-network" class="tab-pane hidden space-y-6">
          <div class="al-card p-5 space-y-3">
            <h3 class="text-sm font-semibold border-b pb-2" style="color:var(--theme-text-strong, #fafafa); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              Network Interfaces & Ports
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div class="space-y-2">
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">Network Mode</span>
                  <span id="netType" class="font-mono capitalize" style="color:var(--theme-text, #e4e4e7)">nat</span>
                </div>
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">MAC Address</span>
                  <span id="netMAC" class="font-mono" style="color:var(--theme-text, #e4e4e7)">—</span>
                </div>
              </div>
              <div class="space-y-2">
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">IPv4 Address</span>
                  <span id="netIP" class="font-mono" style="color:var(--theme-text, #e4e4e7)">DHCP</span>
                </div>
                <div class="flex justify-between py-1 border-b" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
                  <span style="color:var(--theme-text-muted, #8a8a8a)">SSH Host Port</span>
                  <span id="netSSHPort" class="font-mono" style="color:var(--theme-text, #e4e4e7)">22</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SNAPSHOTS TAB -->
        <div id="tab-snapshots" class="tab-pane hidden space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">Virtual Machine Snapshots</h3>
            <button type="button" onclick="openModal('snapshotModal')" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
              <%- icon('camera', { class: 'w-3.5 h-3.5' }) %>
              <span>Take Snapshot</span>
            </button>
          </div>
          <div id="snapshotsList" class="al-card p-6 text-center text-xs" style="color:var(--theme-text-muted, #8a8a8a)">
            Loading snapshots...
          </div>
        </div>

        <!-- ISO TAB -->
        <div id="tab-iso" class="tab-pane hidden space-y-4">
          <div class="al-card p-5 space-y-4">
            <div class="flex items-center justify-between border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <div>
                <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">Virtual Optical Drive (CD-ROM)</h3>
                <p class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Insert or eject ISO installation media</p>
              </div>
              <div id="isoStatusBadge" class="text-xs font-mono"></div>
            </div>
            
            <div class="flex items-center gap-3">
              <select id="isoSelect" class="al-input text-xs flex-1">
                <option value="">Loading available ISOs...</option>
              </select>
              <button type="button" id="attachIsoBtn" onclick="attachISO()" class="al-btn-primary text-xs px-3.5 py-2">Attach</button>
              <button type="button" id="detachIsoBtn" onclick="detachISO()" class="al-btn-danger text-xs px-3.5 py-2">Eject</button>
            </div>
          </div>
        </div>

        <!-- LOGS TAB -->
        <div id="tab-logs" class="tab-pane hidden space-y-4">
          <div id="logsList" class="al-card p-6 text-center text-xs" style="color:var(--theme-text-muted, #8a8a8a)">
            Loading audit records...
          </div>
        </div>

        <!-- DANGER ZONE TAB -->
        <div id="tab-danger" class="tab-pane hidden space-y-4">
          <div class="al-card p-5 space-y-4 border" style="border-color:rgba(239, 68, 68, 0.25);">
            <h3 class="text-sm font-semibold text-red-400">Danger Zone Operations</h3>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-lg border"
                 style="background:rgba(239, 68, 68, 0.05); border-color:rgba(239, 68, 68, 0.15);">
              <div>
                <div class="text-xs font-semibold text-red-400">Reinstall Operating System</div>
                <div class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Re-creates disk image from template. All existing data is erased.</div>
              </div>
              <button type="button" onclick="doAction('reinstall')" class="al-btn-danger text-xs px-3.5 py-1.5 shrink-0">Reinstall VM</button>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-lg border"
                 style="background:rgba(239, 68, 68, 0.05); border-color:rgba(239, 68, 68, 0.15);">
              <div>
                <div class="text-xs font-semibold text-red-400">Destroy Virtual Machine</div>
                <div class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Permanently deletes this guest instance and storage disk.</div>
              </div>
              <button type="button" onclick="deleteVM()" class="al-btn-danger text-xs px-3.5 py-1.5 shrink-0">Destroy Instance</button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<!-- Snapshot Modal -->
<div id="snapshotModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4">
  <div class="al-card w-full max-w-md rounded-2xl shadow-2xl p-5 space-y-4">
    <div class="flex items-center justify-between border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.08));">
      <h3 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">Create Snapshot</h3>
      <button type="button" onclick="closeModal('snapshotModal')" class="text-zinc-400 hover:text-white">✕</button>
    </div>
    <div class="space-y-3">
      <div class="space-y-1">
        <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Snapshot Name *</label>
        <input type="text" id="snapshotName" placeholder="e.g. backup-pre-update" class="al-input text-xs w-full">
      </div>
      <div class="space-y-1">
        <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Description</label>
        <textarea id="snapshotDesc" placeholder="Optional notes..." class="al-input text-xs w-full" rows="2"></textarea>
      </div>
    </div>
    <div class="flex justify-end gap-2 pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.08));">
      <button type="button" onclick="closeModal('snapshotModal')" class="al-btn-secondary text-xs px-3 py-1.5">Cancel</button>
      <button type="button" onclick="createSnapshot()" class="al-btn-primary text-xs px-3.5 py-1.5">Take Snapshot</button>
    </div>
  </div>
</div>

<script>
const vmId = <%= vmId %>;
let vmData = null;

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function switchTab(tab) {
  document.querySelectorAll('.tab-btn').forEach(btn => {
    const isActive = btn.dataset.tab === tab;
    btn.style.background = isActive ? 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))' : 'transparent';
    btn.style.color = isActive ? 'var(--theme-text-strong, #fafafa)' : 'var(--theme-text-muted, #8a8a8a)';
  });
  document.querySelectorAll('.tab-pane').forEach(pane => {
    pane.classList.toggle('hidden', pane.id !== `tab-${tab}`);
  });

  if (tab === 'snapshots') loadSnapshots();
  if (tab === 'logs') loadLogs();
  if (tab === 'iso') loadISOs();
}

function openModal(id) {
  const el = document.getElementById(id);
  if (el) { el.classList.remove('hidden'); el.classList.add('flex'); }
}

function closeModal(id) {
  const el = document.getElementById(id);
  if (el) { el.classList.add('hidden'); el.classList.remove('flex'); }
}

async function loadVM() {
  try {
    const res = await fetch(`/api/vms/${vmId}`);
    if (!res.ok) throw new Error('VM not found');
    vmData = await res.json();

    const isRunning = vmData.status === 'running';
    document.getElementById('vmTitle').textContent = `VM #${vmData.vm_id} (${vmData.vm_name})`;
    document.getElementById('vmSubtitle').textContent = `Template: ${vmData.template_name || vmData.os_type || 'KVM'} • Tenant: ${vmData.owner_username || 'Admin'}`;
    
    // Status Badge
    const badge = document.getElementById('statusBadge');
    badge.style.cssText = isRunning
      ? 'background:rgba(16, 185, 129, 0.12); color:#34d399; border:1px solid rgba(16, 185, 129, 0.2);'
      : 'background:rgba(113, 113, 122, 0.12); color:#a1a1aa; border:1px solid rgba(113, 113, 122, 0.2);';
    badge.firstElementChild.className = `w-1.5 h-1.5 rounded-full ${isRunning ? 'bg-emerald-400' : 'bg-zinc-400'}`;
    document.getElementById('statusText').textContent = vmData.status || 'stopped';

    // Quick Metrics
    document.getElementById('statMemory').textContent = `${vmData.memory || '—'} MB`;
    document.getElementById('statCPUs').textContent = `${vmData.cpus || '—'} vCPU`;
    document.getElementById('statDisk').textContent = vmData.disk_size || '—';
    document.getElementById('statIP').textContent = vmData.ipv4_address || 'DHCP';
    document.getElementById('statSSHPort').textContent = `SSH Port: ${vmData.ssh_port || vmData.ssh_port_static || '22'}`;

    // Overview Tab
    document.getElementById('detailName').textContent = vmData.vm_name || '—';
    document.getElementById('detailOS').textContent = vmData.template_name || vmData.os_type || '—';
    document.getElementById('detailOwner').textContent = vmData.owner_username || 'Admin';
    document.getElementById('detailCreated').textContent = vmData.created_at ? new Date(vmData.created_at).toLocaleDateString() : '—';
    
    // SSH Command
    const ip = vmData.ipv4_address || 'localhost';
    const port = vmData.ssh_port || vmData.ssh_port_static || '22';
    const user = vmData.username || 'root';
    document.getElementById('sshCmd').textContent = `ssh ${user}@${ip} -p ${port}`;

    // Hardware Tab
    document.getElementById('hwTopology').textContent = `${vmData.cpu_sockets || 1}S × ${vmData.cpu_cores || 2}C × ${vmData.cpu_threads || 1}T`;
    document.getElementById('hwCPUModel').textContent = vmData.cpu_model || 'host';
    document.getElementById('hwMemory').textContent = `${vmData.memory || '—'} MB`;
    document.getElementById('hwACPI').textContent = vmData.enable_acpi ? 'Enabled' : 'Disabled';

    // Network Tab
    document.getElementById('netType').textContent = vmData.network_type || 'nat';
    document.getElementById('netMAC').textContent = vmData.mac_address || '—';
    document.getElementById('netIP').textContent = vmData.ipv4_address || 'DHCP';
    document.getElementById('netSSHPort').textContent = vmData.ssh_port || vmData.ssh_port_static || '22';

  } catch(e) {
    alert('Error loading VM: ' + e.message);
  }
}

async function doAction(action) {
  if (action === 'reinstall') {
    if (!confirm('Reinstall VM? All disk data will be replaced!')) return;
    try {
      const res = await fetch(`/api/vms/${vmId}/reinstall`, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ confirm: true, new_os_template: vmData.os_template }) });
      const d = await res.json();
      if (res.ok && d.success) { alert('Reinstall started!'); setTimeout(loadVM, 2000); }
      else alert('Failed: ' + (d.error || 'Error'));
    } catch(e) { alert(e.message); }
    return;
  }

  if (!confirm(`Are you sure you want to ${action} this VM?`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) {
      setTimeout(loadVM, 1500);
    } else {
      alert('Action failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

async function deleteVM() {
  if (!confirm(`PERMANENT ACTION: Delete VM "${vmData?.vm_name || vmId}"? All disks will be permanently deleted.`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}`, { method: 'DELETE' });
    const d = await res.json();
    if (res.ok && d.success) {
      window.location.href = '/admin/vms';
    } else {
      alert('Failed: ' + (d.error || 'Unknown error'));
    }
  } catch(e) { alert(e.message); }
}

async function loadSnapshots() {
  const el = document.getElementById('snapshotsList');
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots`);
    if (!res.ok) throw new Error('Failed to load snapshots');
    const snaps = await res.json();

    if (!snaps || snaps.length === 0) {
      el.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">No snapshots saved yet.</p>';
      return;
    }

    el.innerHTML = snaps.map(s => `
      <div class="flex items-center justify-between p-3 rounded-lg border mb-2 text-xs"
           style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div>
          <div class="font-semibold" style="color:var(--theme-text-strong, #fafafa)">${escHtml(s.snapshot_name)}</div>
          <div class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">
            ${s.created_at ? new Date(s.created_at).toLocaleString() : '—'} • ${escHtml(s.description || '')}
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <button type="button" onclick="revertSnapshot('${escHtml(s.snapshot_name)}')" class="al-btn-secondary text-xs px-2.5 py-1">Revert</button>
          <button type="button" onclick="deleteSnapshot('${escHtml(s.snapshot_name)}')" class="al-btn-danger text-xs px-2.5 py-1">Delete</button>
        </div>
      </div>
    `).join('');
  } catch(e) {
    el.innerHTML = `<p class="text-xs text-red-400">Failed: ${escHtml(e.message)}</p>`;
  }
}

async function createSnapshot() {
  const name = document.getElementById('snapshotName').value.trim();
  const desc = document.getElementById('snapshotDesc').value.trim();
  if (!name) { alert('Snapshot name is required'); return; }

  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ snapshot_name: name, description: desc })
    });
    const d = await res.json();
    if (res.ok && d.success) {
      closeModal('snapshotModal');
      loadSnapshots();
    } else {
      alert('Failed: ' + (d.error || 'Unknown error'));
    }
  } catch(e) { alert(e.message); }
}

async function revertSnapshot(name) {
  if (!confirm(`Revert VM to snapshot "${name}"? Current state will be overwritten!`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots/${name}/revert`, { method: 'POST' });
    const d = await res.json();
    if (res.ok && d.success) { alert('Reverted successfully!'); loadVM(); }
    else alert('Failed: ' + (d.error || 'Error'));
  } catch(e) { alert(e.message); }
}

async function deleteSnapshot(name) {
  if (!confirm(`Delete snapshot "${name}"?`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots/${name}`, { method: 'DELETE' });
    const d = await res.json();
    if (res.ok && d.success) loadSnapshots();
    else alert('Failed: ' + (d.error || 'Error'));
  } catch(e) { alert(e.message); }
}

async function loadISOs() {
  try {
    const res = await fetch('/api/iso-list');
    if (!res.ok) return;
    const isos = await res.json();
    const sel = document.getElementById('isoSelect');
    if (isos.length === 0) {
      sel.innerHTML = '<option value="">No ISO images found on node</option>';
    } else {
      sel.innerHTML = '<option value="">Select an ISO image...</option>' +
        isos.map(iso => `<option value="${iso}">${iso}</option>`).join('');
    }
  } catch(e) {}
}

async function attachISO() {
  const file = document.getElementById('isoSelect').value;
  if (!file) { alert('Please select an ISO image'); return; }
  try {
    const res = await fetch(`/api/vms/${vmId}/iso/attach`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ iso_file: file })
    });
    const d = await res.json();
    if (res.ok && d.success) alert('ISO attached successfully');
    else alert('Failed: ' + (d.error || 'Error'));
  } catch(e) { alert(e.message); }
}

async function detachISO() {
  if (!confirm('Eject ISO drive?')) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/iso/detach`, { method: 'POST' });
    const d = await res.json();
    if (res.ok && d.success) alert('ISO ejected successfully');
    else alert('Failed: ' + (d.error || 'Error'));
  } catch(e) { alert(e.message); }
}

async function loadLogs() {
  const el = document.getElementById('logsList');
  try {
    const res = await fetch(`/api/vms/${vmId}/logs`);
    if (!res.ok) throw new Error('Failed to load logs');
    const logs = await res.json();
    if (!logs || logs.length === 0) {
      el.innerHTML = '<p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">No audit logs recorded for this instance.</p>';
      return;
    }
    el.innerHTML = logs.map(l => `
      <div class="flex items-start justify-between p-2.5 rounded-lg border mb-2 text-xs"
           style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div>
          <span class="font-semibold uppercase tracking-wider font-mono text-[10px] text-indigo-400">[${escHtml(l.action)}]</span>
          <span class="ml-2 font-medium" style="color:var(--theme-text-strong, #fafafa)">${escHtml(l.message || '')}</span>
        </div>
        <span class="text-[10px] font-mono shrink-0" style="color:var(--theme-text-muted, #8a8a8a)">
          ${l.timestamp ? new Date(l.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : ''}
        </span>
      </div>
    `).join('');
  } catch(e) {
    el.innerHTML = `<p class="text-xs text-red-400">Failed: ${escHtml(e.message)}</p>`;
  }
}

function copySSH() {
  const text = document.getElementById('sshCmd')?.textContent;
  if (text) {
    navigator.clipboard.writeText(text);
    alert('SSH command copied to clipboard!');
  }
}

loadVM();
</script>