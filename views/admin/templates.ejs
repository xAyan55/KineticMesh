<%- include('../components/header', { title: 'OS Templates - Admin' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Templates' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
            Operating System Templates
          </h1>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Manage cloud-init and ISO virtualization base images for VM provisioning.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/templates/add" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('plus', { class: 'w-3.5 h-3.5' }) %>
            <span>Add Template</span>
          </a>
          <button type="button" onclick="loadTemplates()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5', id: 'refreshIcon' }) %>
            <span>Refresh</span>
          </button>
        </div>
      </div>

      <!-- Cache Telemetry Bar -->
      <div class="al-card p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border"
           style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center text-indigo-400" style="background:rgba(99, 102, 241, 0.12)">
            <%- icon('hard-drive', { class: 'w-4 h-4' }) %>
          </div>
          <div>
            <div class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">Local Image Cache</div>
            <div class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">
              <span id="cacheCount">0</span> cached images • <span id="cacheSize">0 GB</span> total footprint
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" onclick="confirmClearCache()" class="al-btn-danger text-xs px-3 py-1.5 flex items-center gap-1.5">
            <%- icon('trash-2', { class: 'w-3.5 h-3.5' }) %>
            <span>Clear Cache</span>
          </button>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div class="flex gap-1.5 border-b pb-2" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <button type="button" onclick="switchTab('all', this)" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);">
          All Templates
        </button>
        <button type="button" onclick="switchTab('builtin', this)" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Built-in
        </button>
        <button type="button" onclick="switchTab('custom', this)" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                style="color:var(--theme-text-muted, #8a8a8a);">
          Custom
        </button>
      </div>

      <!-- Templates Grid -->
      <div id="templatesContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="al-card p-10 text-center col-span-full">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center mx-auto mb-2.5 animate-spin text-zinc-500">
            <%- icon('rotate-cw', { class: 'w-4 h-4' }) %>
          </div>
          <p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">Loading templates...</p>
        </div>
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
let currentTab = 'all';
let allTemplates = [];

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

async function loadTemplates() {
  const icon = document.getElementById('refreshIcon');
  if (icon) icon.classList.add('animate-spin');

  try {
    const res = await fetch('/api/admin/templates');
    if (!res.ok) throw new Error('Failed to load templates');
    allTemplates = await res.json();
    renderTemplates();
    loadCacheInfo();
  } catch(e) {
    document.getElementById('templatesContainer').innerHTML = `
      <div class="al-card p-8 text-center text-xs text-red-400 col-span-full">
        Failed to load templates: ${escHtml(e.message)}
      </div>
    `;
  } finally {
    if (icon) setTimeout(() => icon.classList.remove('animate-spin'), 600);
  }
}

function switchTab(tab, btn) {
  currentTab = tab;
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.style.background = 'transparent';
    b.style.color = 'var(--theme-text-muted, #8a8a8a)';
  });
  btn.style.background = 'var(--theme-bg-active-nav, rgba(255,255,255,0.1))';
  btn.style.color = 'var(--theme-text-strong, #fafafa)';
  renderTemplates();
}

function renderTemplates() {
  let templates = allTemplates;
  if (currentTab === 'builtin') templates = templates.filter(t => !t.is_custom);
  if (currentTab === 'custom') templates = templates.filter(t => t.is_custom);

  const container = document.getElementById('templatesContainer');

  if (templates.length === 0) {
    container.innerHTML = `
      <div class="al-card p-10 text-center text-xs col-span-full" style="color:var(--theme-text-muted, #8a8a8a)">
        No templates found in this category.
      </div>
    `;
    return;
  }

  container.innerHTML = templates.map(t => {
    const isCached = !!t.local_path;
    const isCustom = !!t.is_custom;

    return `
      <div class="al-card p-4 flex flex-col justify-between">
        <div>
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 border"
                   style="background:var(--theme-bg-secondary, #212121); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08)); color:var(--theme-text-strong, #fafafa)">
                ${escHtml((t.template_name || 'OS').substring(0, 2).toUpperCase())}
              </div>
              <div class="min-w-0">
                <div class="font-semibold text-sm truncate" style="color:var(--theme-text-strong, #fafafa)">
                  ${escHtml(t.template_name || 'Unknown')}
                </div>
                <div class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">
                  ${escHtml(t.template_type || 'cloud-init')}
                </div>
              </div>
            </div>

            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border shrink-0"
                  style="${isCustom ? 'background:rgba(99, 102, 241, 0.12); color:#818cf8; border-color:rgba(99, 102, 241, 0.2);' : 'background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a); border-color:var(--theme-border-subtle);'}">
              ${isCustom ? 'Custom' : 'Built-in'}
            </span>
          </div>

          <p class="text-xs line-clamp-2 mb-3" style="color:var(--theme-text-muted, #8a8a8a)">
            ${escHtml(t.description || 'No description provided for this base image.')}
          </p>

          <div class="grid grid-cols-3 gap-2 p-2 rounded-lg text-xs font-mono mb-3"
               style="background:var(--theme-bg-secondary, #1a1a1a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.06));">
            <div>
              <div class="text-[9px] uppercase font-sans" style="color:var(--theme-text-muted, #8a8a8a)">Memory</div>
              <div class="font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${t.memory || 0}MB</div>
            </div>
            <div>
              <div class="text-[9px] uppercase font-sans" style="color:var(--theme-text-muted, #8a8a8a)">vCPUs</div>
              <div class="font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${t.cpus || 0}</div>
            </div>
            <div>
              <div class="text-[9px] uppercase font-sans" style="color:var(--theme-text-muted, #8a8a8a)">Disk</div>
              <div class="font-medium mt-0.5 truncate" style="color:var(--theme-text, #e4e4e7)">${escHtml(t.disk_size || '—')}</div>
            </div>
          </div>

          <div class="mb-3">
            ${isCached
              ? `<span class="inline-flex items-center gap-1.5 text-xs text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Cached locally
                </span>`
              : `<span class="inline-flex items-center gap-1.5 text-xs text-zinc-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> Remote image (on-demand download)
                </span>`
            }
          </div>
        </div>

        <div class="flex items-center justify-between gap-2 pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
          <div class="flex items-center gap-1.5">
            ${!isCached && t.download_url
              ? `<button type="button" onclick="downloadTemplate('${t.template_key}')" class="al-btn-secondary text-xs px-2.5 py-1">Download</button>`
              : ''
            }
          </div>
          <div class="flex items-center gap-1.5">
            <button type="button" onclick="editTemplate(${t.template_id || 0}, '${t.template_key}')" class="al-btn-secondary text-xs px-2.5 py-1">Edit</button>
            ${isCustom
              ? `<button type="button" onclick="deleteTemplate(${t.template_id || 0})" class="al-btn-danger text-xs px-2.5 py-1">Delete</button>`
              : ''
            }
          </div>
        </div>
      </div>
    `;
  }).join('');
}

async function downloadTemplate(key) {
  if (!confirm('Download this template to local cache?')) return;
  try {
    const res = await fetch(`/api/admin/templates/${key}/download`, { method: 'POST' });
    if (!res.ok) throw new Error('Download failed');
    alert('Download initiated successfully!');
    loadTemplates();
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

async function deleteTemplate(id) {
  if (!confirm('Are you sure you want to delete this custom template?')) return;
  try {
    const res = await fetch(`/api/admin/templates/${id}`, { method: 'DELETE' });
    if (!res.ok) throw new Error('Delete failed');
    loadTemplates();
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

function editTemplate(id, key) {
  if (id === 0 && key) {
    window.location.href = `/admin/templates/builtin/${key}/edit`;
  } else {
    window.location.href = `/admin/templates/${id}/edit`;
  }
}

async function loadCacheInfo() {
  try {
    const res = await fetch('/api/admin/templates/cache/info');
    if (!res.ok) return;
    const data = await res.json();
    document.getElementById('cacheCount').textContent = data.total_count || 0;
    document.getElementById('cacheSize').textContent = data.total_size_readable || '0 GB';
  } catch(e) {}
}

async function confirmClearCache() {
  if (!confirm('Clear all cached templates from disk? Future VM creation may require re-downloading images.')) return;
  try {
    const res = await fetch('/api/admin/templates/cache/clear', { method: 'POST' });
    if (!res.ok) throw new Error('Clear cache failed');
    loadTemplates();
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

loadTemplates();
</script>