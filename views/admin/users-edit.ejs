<%- include('../components/header', { title: 'Edit User #' + userId }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Users', href: '/admin/users' },
      { label: 'Edit User #' + userId }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-4xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
            Edit User Account <span id="headerUsername" class="text-sm font-normal" style="color:var(--theme-text-muted, #8a8a8a)"></span>
          </h1>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Modify tenant information, account access status, and credentials.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/users" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('arrow-left', { class: 'w-3.5 h-3.5' }) %>
            <span>Back to Users</span>
          </a>
          <button type="button" onclick="deleteCurrentUser()" class="al-btn-danger text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('trash-2', { class: 'w-3.5 h-3.5' }) %>
            <span>Delete User</span>
          </button>
        </div>
      </div>

      <div id="alertBox" class="hidden p-3.5 rounded-xl text-xs"></div>

      <!-- Form Grid -->
      <form id="editUserForm" onsubmit="submitEditUser(event)" class="space-y-6">
        
        <!-- User Information Card -->
        <div class="al-card p-5 space-y-4">
          <div class="flex items-center gap-2 border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
            <%- icon('user', { class: 'w-4 h-4 text-indigo-400' }) %>
            <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">Account Details</h2>
          </div>

          <div class="space-y-3.5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Username</label>
                <input type="text" id="username" disabled class="al-input text-xs w-full opacity-60 cursor-not-allowed">
                <p class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a)">Username is immutable.</p>
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Email Address</label>
                <input type="email" id="email" placeholder="user@example.com" class="al-input text-xs w-full">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Full Name</label>
                <input type="text" id="fullName" placeholder="John Doe" class="al-input text-xs w-full">
              </div>

              <div class="space-y-1">
                <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Account Status</label>
                <div class="flex items-center gap-3 pt-1">
                  <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="isActive" class="rounded text-indigo-600 focus:ring-0">
                    <span class="text-xs" style="color:var(--theme-text, #e4e4e7)">Active (Login Permitted)</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Security / Password Update -->
        <div class="al-card p-5 space-y-4">
          <div class="flex items-center gap-2 border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
            <%- icon('lock', { class: 'w-4 h-4 text-amber-400' }) %>
            <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">Update Password</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div class="space-y-1">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">New Password</label>
              <input type="password" id="password" placeholder="Leave empty to keep current" class="al-input text-xs w-full">
            </div>

            <div class="space-y-1">
              <label class="al-label text-xs font-medium" style="color:var(--theme-text, #e4e4e7)">Confirm New Password</label>
              <input type="password" id="confirmPassword" placeholder="Re-enter to confirm" class="al-input text-xs w-full">
            </div>
          </div>
        </div>

        <!-- Role & Privilege -->
        <div class="al-card p-5 space-y-4">
          <div class="flex items-center gap-2 border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
            <%- icon('shield', { class: 'w-4 h-4 text-emerald-400' }) %>
            <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">Role & Permissions</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="al-card p-3.5 flex items-start gap-3 cursor-pointer transition-colors border"
                   style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08));">
              <input type="radio" name="role" id="roleUser" value="user" class="mt-0.5 text-indigo-600 focus:ring-0">
              <div>
                <div class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">Standard User</div>
                <div class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">Tenant with basic instance access.</div>
              </div>
            </label>

            <label class="al-card p-3.5 flex items-start gap-3 cursor-pointer transition-colors border"
                   style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08));">
              <input type="radio" name="role" id="roleAdmin" value="admin" class="mt-0.5 text-indigo-600 focus:ring-0">
              <div>
                <div class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">Administrator</div>
                <div class="text-[11px] mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">Full cluster administration access.</div>
              </div>
            </label>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <a href="/admin/users" class="al-btn-secondary text-xs px-4 py-2">Cancel</a>
          <button type="submit" id="submitBtn" class="al-btn-primary text-xs px-5 py-2 flex items-center gap-1.5">
            <%- icon('check', { class: 'w-3.5 h-3.5' }) %>
            <span>Save Changes</span>
          </button>
        </div>
      </form>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
const userId = <%= userId %>;

async function loadUser() {
  try {
    const res = await fetch(`/api/admin/users/${userId}`);
    if (!res.ok) throw new Error('Failed to load user profile');
    const u = await res.json();
    
    document.getElementById('username').value = u.username || '';
    document.getElementById('headerUsername').textContent = `(${u.username || ''})`;
    document.getElementById('email').value = u.email || '';
    document.getElementById('fullName').value = u.full_name || '';
    document.getElementById('isActive').checked = u.is_active !== 0;
    
    if (u.role === 'admin') {
      document.getElementById('roleAdmin').checked = true;
    } else {
      document.getElementById('roleUser').checked = true;
    }
  } catch(e) {
    showAlert(e.message, 'error');
  }
}

async function submitEditUser(e) {
  e.preventDefault();
  
  const email = document.getElementById('email').value.trim();
  const fullName = document.getElementById('fullName').value.trim();
  const isActive = document.getElementById('isActive').checked ? 1 : 0;
  const role = document.querySelector('input[name="role"]:checked')?.value || 'user';
  const password = document.getElementById('password').value;
  const confirmPassword = document.getElementById('confirmPassword').value;
  
  const alertBox = document.getElementById('alertBox');
  const btn = document.getElementById('submitBtn');
  alertBox.classList.add('hidden');
  
  if (password) {
    if (password.length < 6) {
      showAlert('Password must be at least 6 characters', 'error');
      return;
    }
    if (password !== confirmPassword) {
      showAlert('Passwords do not match', 'error');
      return;
    }
  }
  
  btn.disabled = true;
  btn.innerHTML = 'Saving...';
  
  try {
    const payload = {
      email: email || undefined,
      full_name: fullName || undefined,
      is_active: isActive,
      role: role
    };
    if (password) payload.password = password;
    
    const res = await fetch(`/api/admin/users/${userId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    
    const data = await res.json();
    if (res.ok && data.success) {
      showAlert('User updated successfully!', 'success');
      setTimeout(() => {
        window.location.href = '/admin/users';
      }, 1000);
    } else {
      throw new Error(data.error || 'Failed to update user');
    }
  } catch(err) {
    showAlert(err.message, 'error');
    btn.disabled = false;
    btn.innerHTML = 'Save Changes';
  }
}

async function deleteCurrentUser() {
  const username = document.getElementById('username').value;
  if (!confirm(`Are you sure you want to permanently delete user "${username}" (#${userId})?`)) return;
  try {
    const res = await fetch(`/api/admin/users/${userId}`, { method: 'DELETE' });
    const data = await res.json();
    if (res.ok && data.success) {
      window.location.href = '/admin/users';
    } else {
      alert('Delete failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

function showAlert(msg, type) {
  const el = document.getElementById('alertBox');
  el.classList.remove('hidden');
  if (type === 'success') {
    el.style.cssText = 'background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2);';
  } else {
    el.style.cssText = 'background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2);';
  }
  el.textContent = msg;
}

loadUser();
</script>
