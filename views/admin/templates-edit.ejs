<%- include('../components/header', { title: title || 'View Template' }) %>

<div class="flex h-screen overflow-hidden">
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'OS Templates', href: '/admin/templates' },
      { label: isBuiltin ? 'View Template' : 'Edit Template' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-5xl w-full mx-auto space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h1 class="al-page-title"><%= (template && template.template_name) ? template.template_name : 'Template Details' %></h1>
              <% if (isBuiltin) { %>
                <span class="al-badge-neutral text-[11px] px-2 py-0.5">Built-in • Read-only</span>
              <% } else { %>
                <span class="al-badge-online text-[11px] px-2 py-0.5">Custom Template</span>
              <% } %>
            </div>
            <p class="al-page-desc"><%= isBuiltin ? 'View built-in system template configuration and presets.' : 'Manage custom OS template settings.' %></p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a href="/admin/templates" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('arrow-left', { class: 'size-3.5', strokeWidth: 2 }) %>
            Back to Templates
          </a>
        </div>
      </div>

      <% if (isBuiltin) { %>
        <div class="al-card p-4 flex items-start gap-3 border-l-4" style="border-left-color: var(--theme-accent);">
          <span style="color:var(--theme-accent)"><%- icon('info', { class: 'size-4 shrink-0 mt-0.5', strokeWidth: 2 }) %></span>
          <div class="text-xs space-y-1">
            <div class="font-medium" style="color:var(--theme-text-strong)">Built-in System Template</div>
            <div style="color:var(--theme-text-muted)">
              This template is part of the KineticMesh default distribution. Its default values and download sources are maintained by the platform and cannot be directly modified.
            </div>
          </div>
        </div>
      <% } %>

      <form id="editTemplateForm" onsubmit="submitEdit(event)" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Left Column -->
          <div class="space-y-6">
            <!-- Template Basics -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('box', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Template Information</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">Template Name</label>
                  <input type="text" class="al-input text-xs" id="templateName" 
                         value="<%= template.template_name || '' %>" <%= isBuiltin ? 'disabled' : '' %> required>
                </div>

                <div>
                  <label class="al-label">Template Key</label>
                  <input type="text" class="al-input text-xs font-mono" id="templateKey" 
                         value="<%= template.template_key || '' %>" disabled>
                </div>

                <div>
                  <label class="al-label">Description</label>
                  <textarea class="al-input text-xs" id="templateDesc" rows="3" 
                            <%= isBuiltin ? 'disabled' : '' %>><%= template.description || '' %></textarea>
                </div>

                <div>
                  <label class="al-label">Template Icon / Image URL</label>
                  <div class="flex items-center gap-3">
                    <div class="flex-1">
                      <input type="text" class="al-input text-xs" id="templateIcon" 
                             value="<%= template.icon || '📦' %>" <%= isBuiltin ? 'disabled' : '' %>
                             oninput="updateIconPreview()">
                    </div>
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 border border-[var(--theme-border)] text-xl overflow-hidden" 
                         id="iconPreview" style="background:var(--theme-bg-secondary)">
                      <%= template.icon && template.icon.startsWith('http') ? '' : (template.icon || '📦') %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Download Source -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('cloud-download', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Download Source</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">Download URL</label>
                  <input type="url" class="al-input text-xs" id="templateURL" 
                         value="<%= template.download_url || '' %>" <%= isBuiltin ? 'disabled' : '' %>>
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Remote image download location for VM base disk caching.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column -->
          <div class="space-y-6">
            <!-- Default Resources -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('cpu', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Default Resources</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">Template Type</label>
                  <select class="al-input text-xs" id="templateType" <%= isBuiltin ? 'disabled' : '' %>>
                    <option value="cloud-init" <%= template.template_type === 'cloud-init' ? 'selected' : '' %>>Cloud-Init (Automatic provisioning)</option>
                    <option value="iso" <%= template.template_type === 'iso' ? 'selected' : '' %>>ISO Installer (Manual installation)</option>
                  </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="al-label">Memory (MB)</label>
                    <input type="number" class="al-input text-xs" id="templateMemory" 
                           value="<%= template.memory || 2048 %>" <%= isBuiltin ? 'disabled' : '' %>>
                  </div>
                  <div>
                    <label class="al-label">vCPUs</label>
                    <input type="number" class="al-input text-xs" id="templateCPUs" 
                           value="<%= template.cpus || 2 %>" <%= isBuiltin ? 'disabled' : '' %>>
                  </div>
                </div>

                <div>
                  <label class="al-label">Disk Size</label>
                  <input type="text" class="al-input text-xs" id="templateDiskSize" 
                         value="<%= template.disk_size || '20G' %>" <%= isBuiltin ? 'disabled' : '' %>>
                </div>
              </div>
            </div>

            <!-- Credentials -->
            <div class="al-card" id="credentialsSection">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('key', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Default Credentials</h2>
              </div>
              <div class="p-4 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="al-label">Default Username</label>
                    <input type="text" class="al-input text-xs" id="templateUser" 
                           value="<%= template.username || '' %>" <%= isBuiltin ? 'disabled' : '' %>>
                  </div>
                  <div>
                    <label class="al-label">Default Password</label>
                    <input type="text" class="al-input text-xs" id="templatePass" 
                           value="<%= template.password || '' %>" <%= isBuiltin ? 'disabled' : '' %>>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer Actions -->
        <div class="al-card p-4 flex items-center justify-end gap-3">
          <a href="/admin/templates" class="al-btn-secondary text-xs py-2 px-4">
            <%- isBuiltin ? 'Back to Templates' : 'Cancel' %>
          </a>
          <% if (!isBuiltin) { %>
            <button type="submit" id="saveBtn" class="al-btn-primary text-xs flex items-center gap-1.5 py-2 px-4">
              <%- icon('save', { class: 'size-3.5', strokeWidth: 2 }) %>
              Save Changes
            </button>
          <% } %>
        </div>
      </form>
    </main>

    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
const isBuiltin = <%- JSON.stringify(isBuiltin || false) %>;
const templateData = <%- JSON.stringify(template || {}) %>;

function updateIconPreview() {
  const value = document.getElementById('templateIcon').value.trim();
  const preview = document.getElementById('iconPreview');
  if (!value) {
    preview.innerHTML = '📦';
    return;
  }
  if (value.startsWith('http://') || value.startsWith('https://')) {
    preview.innerHTML = `<img src="${value}" alt="Icon" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='📦';">`;
  } else {
    preview.innerHTML = value.substring(0, 2);
  }
}

async function submitEdit(e) {
  e.preventDefault();
  if (isBuiltin) return;

  const btn = document.getElementById('saveBtn');
  const origHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `<svg class="animate-spin size-3.5 mr-1" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Saving...`;

  try {
    const payload = {
      template_name: document.getElementById('templateName').value.trim(),
      description: document.getElementById('templateDesc').value.trim(),
      icon: document.getElementById('templateIcon').value.trim() || '📦',
      memory: parseInt(document.getElementById('templateMemory').value) || 2048,
      cpus: parseInt(document.getElementById('templateCPUs').value) || 2,
      disk_size: document.getElementById('templateDiskSize').value.trim(),
      template_type: document.getElementById('templateType').value,
      download_url: document.getElementById('templateURL').value.trim(),
      username: document.getElementById('templateUser').value.trim(),
      password: document.getElementById('templatePass').value.trim()
    };

    const templateId = templateData.template_id || templateData.id;
    const res = await fetch(`/api/admin/templates/${templateId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    if (!res.ok) throw new Error(result.error || 'Failed to update template');

    if (window.toast) toast.success('Template updated successfully');
    setTimeout(() => {
      window.location.href = '/admin/templates';
    }, 1000);
  } catch (err) {
    if (window.toast) toast.error(err.message);
    btn.disabled = false;
    btn.innerHTML = origHtml;
  }
}

document.addEventListener('DOMContentLoaded', () => {
  updateIconPreview();
});
</script>
