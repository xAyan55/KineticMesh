<%- include('../components/header', { title: 'Admin Overview' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin' },
      { label: 'Overview' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
            System Overview
          </h1>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Administrative control plane, cluster node statistics, and virtualization telemetry.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/vm-create" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('plus', { class: 'w-3.5 h-3.5' }) %>
            <span>Create VM</span>
          </a>
          <button type="button" id="refreshBtn" onclick="loadAdminData()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5', id: 'refreshIcon' }) %>
            <span>Refresh</span>
          </button>
        </div>
      </div>

      <!-- Stat Cards Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="al-card p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Total VMs</span>
            <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a)">
              <%- icon('server', { class: 'w-4 h-4' }) %>
            </div>
          </div>
          <p id="totalVMs" class="text-2xl font-bold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">0</p>
          <span class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">Across all owners</span>
        </div>

        <div class="al-card p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Running VMs</span>
            <div class="w-8 h-8 rounded-xl flex items-center justify-center text-emerald-400" style="background:rgba(16, 185, 129, 0.1)">
              <%- icon('play', { class: 'w-4 h-4' }) %>
            </div>
          </div>
          <p id="runningVMs" class="text-2xl font-bold mt-2 tabular-nums text-emerald-400">0</p>
          <span class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">Active virtualization instances</span>
        </div>

        <div class="al-card p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Stopped VMs</span>
            <div class="w-8 h-8 rounded-xl flex items-center justify-center text-zinc-400" style="background:var(--theme-bg-secondary, #212121)">
              <%- icon('power-off', { class: 'w-4 h-4' }) %>
            </div>
          </div>
          <p id="stoppedVMs" class="text-2xl font-bold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">0</p>
          <span class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">Suspended or powered off</span>
        </div>

        <div class="al-card p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Registered Users</span>
            <div class="w-8 h-8 rounded-xl flex items-center justify-center text-indigo-400" style="background:rgba(99, 102, 241, 0.1)">
              <%- icon('users', { class: 'w-4 h-4' }) %>
            </div>
          </div>
          <p id="totalUsers" class="text-2xl font-bold mt-2 tabular-nums" style="color:var(--theme-text-strong, #fafafa)">0</p>
          <span class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a)">Active tenant accounts</span>
        </div>
      </div>

      <!-- Main Layout: VMs on left, Node telemetry on right -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left: All VMs Section (2 columns) -->
        <div class="lg:col-span-2 space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <%- icon('cpu', { class: 'w-4 h-4 text-indigo-400' }) %>
              <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong, #fafafa)">
                All Virtual Machines (<span id="vmCount">0</span>)
              </h2>
            </div>
            <span id="lastUpdate" class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)"></span>
          </div>

          <div id="allVMContainer">
            <div class="al-card p-12 text-center">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center mx-auto mb-3 animate-spin text-zinc-500" style="background:var(--theme-bg-secondary, #212121)">
                <%- icon('rotate-cw', { class: 'w-5 h-5' }) %>
              </div>
              <p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">Loading virtualization instances...</p>
            </div>
          </div>
        </div>

        <!-- Right: System Telemetry & Activity -->
        <div class="space-y-6">
          <!-- System Status Card -->
          <div class="al-card p-4 space-y-3.5">
            <div class="flex items-center justify-between border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <div class="flex items-center gap-2">
                <%- icon('activity', { class: 'w-4 h-4 text-emerald-400' }) %>
                <h3 class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">Node Host Telemetry</h3>
              </div>
              <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Online
              </span>
            </div>

            <div class="space-y-2.5 text-xs">
              <div class="flex items-center justify-between">
                <span style="color:var(--theme-text-muted, #8a8a8a)">Host CPU Usage</span>
                <span id="statusCpu" class="font-mono font-medium" style="color:var(--theme-text, #e4e4e7)">Calculating...</span>
              </div>
              <div class="flex items-center justify-between">
                <span style="color:var(--theme-text-muted, #8a8a8a)">Host Memory</span>
                <span id="statusMemory" class="font-mono font-medium" style="color:var(--theme-text, #e4e4e7)">Calculating...</span>
              </div>
              <div class="flex items-center justify-between">
                <span style="color:var(--theme-text-muted, #8a8a8a)">Total Managed VMs</span>
                <span id="statusTotalVMs" class="font-mono font-medium" style="color:var(--theme-text, #e4e4e7)">0</span>
              </div>
            </div>
          </div>

          <!-- Recent Audit Activity Card -->
          <div class="al-card p-4 space-y-3.5">
            <div class="flex items-center justify-between border-b pb-3" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
              <div class="flex items-center gap-2">
                <%- icon('clock', { class: 'w-4 h-4 text-amber-400' }) %>
                <h3 class="text-xs font-semibold" style="color:var(--theme-text-strong, #fafafa)">
                  Audit Feed (<span id="activityCount">0</span>)
                </h3>
              </div>
            </div>

            <div id="activityList" class="space-y-2.5 max-h-[360px] overflow-y-auto pr-1">
              <p class="text-xs text-center py-4" style="color:var(--theme-text-muted, #8a8a8a)">Loading activity stream...</p>
            </div>
          </div>
        </div>

      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function formatTime() {
  const d = new Date();
  return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

function animateNumber(id, target) {
  const el = document.getElementById(id);
  if (!el) return;
  const current = parseInt(el.textContent) || 0;
  const duration = 500;
  const start = performance.now();
  function step(now) {
    const p = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.round(current + (target - current) * eased);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function renderVMCard(vm) {
  const isRunning = vm.status === 'running';
  const statusColor = isRunning ? 'emerald' : 'zinc';
  const owner = vm.owner_username || 'Unassigned';

  return `
    <div class="al-card p-4 flex flex-col justify-between transition-all hover:border-[var(--theme-border-hover,rgba(255,255,255,0.2))] mb-3">
      <div>
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm shrink-0 border"
                 style="background:var(--theme-bg-secondary, #212121); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08)); color:var(--theme-text-strong, #fafafa);">
              ${escHtml((vm.vm_name || 'VM').substring(0, 2).toUpperCase())}
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <a href="/admin/vm/${vm.vm_id}" class="text-sm font-semibold truncate hover:underline" style="color:var(--theme-text-strong, #fafafa);">
                  ${escHtml(vm.vm_name)}
                </a>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded border" style="background:var(--theme-bg-secondary, #212121); border-color:var(--theme-border-subtle); color:var(--theme-text-muted);">
                  #${vm.vm_id}
                </span>
              </div>
              <div class="flex items-center gap-2 text-xs mt-0.5" style="color:var(--theme-text-muted, #8a8a8a);">
                <span>${escHtml(vm.template_name || vm.os_type || 'KVM')}</span>
                <span>•</span>
                <span>User: <strong class="font-normal" style="color:var(--theme-text);">${escHtml(owner)}</strong></span>
              </div>
            </div>
          </div>

          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium shrink-0"
                style="${isRunning ? 'background:rgba(16, 185, 129, 0.12); color:#34d399; border:1px solid rgba(16, 185, 129, 0.2);' : 'background:rgba(113, 113, 122, 0.12); color:#a1a1aa; border:1px solid rgba(113, 113, 122, 0.2);'}">
            <span class="w-1.5 h-1.5 rounded-full ${isRunning ? 'bg-emerald-400' : 'bg-zinc-400'}"></span>
            <span class="capitalize">${escHtml(vm.status || 'stopped')}</span>
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-2.5 rounded-lg text-xs mb-3"
             style="background:var(--theme-bg-secondary, #1a1a1a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.06));">
          <div>
            <div class="text-[10px] uppercase font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Memory</div>
            <div class="font-mono font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${vm.memory ? vm.memory + ' MB' : '—'}</div>
          </div>
          <div>
            <div class="text-[10px] uppercase font-medium" style="color:var(--theme-text-muted, #8a8a8a)">vCPUs</div>
            <div class="font-mono font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${vm.cpus ? vm.cpus + ' vCPU' : '—'}</div>
          </div>
          <div>
            <div class="text-[10px] uppercase font-medium" style="color:var(--theme-text-muted, #8a8a8a)">Disk</div>
            <div class="font-mono font-medium mt-0.5" style="color:var(--theme-text, #e4e4e7)">${escHtml(vm.disk_size || '—')}</div>
          </div>
          <div>
            <div class="text-[10px] uppercase font-medium" style="color:var(--theme-text-muted, #8a8a8a)">IP / Net</div>
            <div class="font-mono font-medium mt-0.5 truncate" style="color:var(--theme-text, #e4e4e7)">${escHtml(vm.ipv4_address || 'DHCP')}</div>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between gap-2 pt-1 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div class="flex items-center gap-1.5">
          ${isRunning
            ? `<button type="button" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-danger text-xs px-2.5 py-1">Stop</button>`
            : `<button type="button" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')" class="al-btn-success text-xs px-2.5 py-1">Start</button>`
          }
        </div>
        <div class="flex items-center gap-1.5">
          <a href="/admin/vm/${vm.vm_id}/console" class="al-btn-secondary text-xs px-2.5 py-1">Console</a>
          <a href="/admin/vm/${vm.vm_id}/ssh" class="al-btn-secondary text-xs px-2.5 py-1">SSH</a>
          <a href="/admin/vm/${vm.vm_id}" class="al-btn-secondary text-xs px-2.5 py-1">Manage</a>
        </div>
      </div>
    </div>
  `;
}

async function vmAction(action, vmId, vmName) {
  if (!confirm(`Are you sure you want to ${action} VM "${vmName}"?`)) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) {
      setTimeout(loadAdminData, 800);
    } else {
      alert('Failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

async function loadAdminData() {
  const icon = document.getElementById('refreshIcon');
  if (icon) icon.classList.add('animate-spin');

  try {
    const statsRes = await fetch('/api/admin/dashboard');
    if (statsRes.ok) {
      const stats = await statsRes.json();
      animateNumber('totalVMs', stats.totalVMs || 0);
      animateNumber('runningVMs', stats.runningVMs || 0);
      animateNumber('stoppedVMs', (stats.totalVMs || 0) - (stats.runningVMs || 0));
      animateNumber('totalUsers', stats.totalUsers || 0);
      document.getElementById('statusTotalVMs').textContent = stats.totalVMs || 0;
    }

    const vmsRes = await fetch('/api/admin/vms');
    if (!vmsRes.ok) throw new Error('Failed to load VMs');
    const vms = await vmsRes.json();
    
    document.getElementById('vmCount').textContent = vms.length;
    document.getElementById('lastUpdate').textContent = `Updated ${formatTime()}`;
    
    const container = document.getElementById('allVMContainer');
    if (vms.length === 0) {
      container.innerHTML = `
        <div class="al-card p-8 text-center space-y-3">
          <p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">No virtual machines deployed yet.</p>
          <a href="/admin/vm-create" class="al-btn-primary text-xs inline-flex items-center gap-1.5 py-1.5 px-3">Create First VM</a>
        </div>
      `;
    } else {
      container.innerHTML = vms.map(vm => renderVMCard(vm)).join('');
    }
  } catch(e) {
    document.getElementById('allVMContainer').innerHTML = `
      <div class="al-card p-6 text-center text-xs text-red-400">
        Failed to load virtual machines: ${escHtml(e.message)}
      </div>
    `;
  } finally {
    if (icon) setTimeout(() => icon.classList.remove('animate-spin'), 600);
  }

  loadRecentActivity();
}

async function loadRecentActivity() {
  try {
    const res = await fetch('/api/admin/activity?limit=10');
    if (res.ok) {
      const activities = await res.json();
      document.getElementById('activityCount').textContent = activities.length;
      const container = document.getElementById('activityList');
      
      if (!activities || activities.length === 0) {
        container.innerHTML = `<p class="text-xs text-center py-4" style="color:var(--theme-text-muted, #8a8a8a)">No recent activity recorded</p>`;
        return;
      }
      
      container.innerHTML = activities.map(act => `
        <div class="p-2.5 rounded-lg border flex items-start justify-between gap-2 text-xs"
             style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
          <div>
            <div class="font-medium" style="color:var(--theme-text-strong, #fafafa);">${escHtml(act.message || act.action)}</div>
            <div class="text-[11px]" style="color:var(--theme-text-muted, #8a8a8a);">VM #${act.vm_id} • ${escHtml(act.status || '')}</div>
          </div>
          <span class="text-[10px] font-mono shrink-0" style="color:var(--theme-text-muted, #8a8a8a);">
            ${act.timestamp ? new Date(act.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : ''}
          </span>
        </div>
      `).join('');
    }
  } catch(e) {}
}

async function loadSystemStatus() {
  try {
    const res = await fetch('/api/system/status');
    if (res.ok) {
      const data = await res.json();
      if (data.cpu) document.getElementById('statusCpu').textContent = data.cpu;
      if (data.memory) document.getElementById('statusMemory').textContent = data.memory;
    }
  } catch(e) {}
}

loadAdminData();
loadSystemStatus();
setInterval(loadAdminData, 30000);
setInterval(loadSystemStatus, 60000);
</script>