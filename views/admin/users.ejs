<%- include('../components/header', { title: 'Users - Admin' }) %>

<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar -->
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>

  <!-- Main Content Container -->
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Breadcrumb -->
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Users' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Page Header -->
      <div class="al-page-header flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="al-page-title text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong, #fafafa)">
              User Management
            </h1>
            <span id="userCountBadge" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-mono font-medium"
                  style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.08));">
              0 Users
            </span>
          </div>
          <p class="al-page-desc text-xs mt-1" style="color:var(--theme-text-muted, #8a8a8a)">
            Manage tenant accounts, permissions, and administrative privilege assignments.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a href="/admin/users/create" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('user-plus', { class: 'w-3.5 h-3.5' }) %>
            <span>Add User</span>
          </a>
          <button type="button" onclick="loadUsers()" class="al-btn-secondary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('rotate-cw', { class: 'w-3.5 h-3.5', id: 'refreshIcon' }) %>
            <span>Refresh</span>
          </button>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
        <div class="al-card p-4">
          <h2 class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted, #8a8a8a);">Total Users</h2>
          <p class="text-2xl font-bold tabular-nums" style="color:var(--theme-text-strong, #fafafa);" id="totalUsersCount">0</p>
          <p class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a);">All registered tenants</p>
        </div>
        <div class="al-card p-4">
          <h2 class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted, #8a8a8a);">Administrators</h2>
          <p class="text-2xl font-bold tabular-nums text-indigo-400" id="adminCount">0</p>
          <p class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a);">Full cluster privileges</p>
        </div>
        <div class="al-card p-4">
          <h2 class="text-[11px] font-medium uppercase tracking-wide mb-1" style="color:var(--theme-text-muted, #8a8a8a);">Active Accounts</h2>
          <p class="text-2xl font-bold tabular-nums text-emerald-400" id="activeUsersCount">0</p>
          <p class="text-[11px] mt-1" style="color:var(--theme-text-muted, #8a8a8a);">Enabled login access</p>
        </div>
      </div>

      <!-- Filters & Search -->
      <div class="al-card p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
          <input
            type="text"
            id="userSearch"
            placeholder="Search by username, email, or ID..."
            oninput="filterUsers()"
            class="al-input text-xs w-full pl-8 py-1.5"
          />
          <div class="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none">
            <%- icon('search', { class: 'w-3.5 h-3.5' }) %>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <select id="roleFilter" onchange="filterUsers()" class="al-input text-xs py-1.5 px-3">
            <option value="">All Roles</option>
            <option value="admin">Administrators</option>
            <option value="user">Regular Users</option>
          </select>
        </div>
      </div>

      <!-- Users Table Card -->
      <div class="al-card overflow-hidden">
        <div id="usersTable">
          <div class="p-10 text-center">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center mx-auto mb-2.5 animate-spin text-zinc-500">
              <%- icon('rotate-cw', { class: 'w-4 h-4' }) %>
            </div>
            <p class="text-xs" style="color:var(--theme-text-muted, #8a8a8a)">Loading user accounts...</p>
          </div>
        </div>
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
let allUsers = [];

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

async function loadUsers() {
  const icon = document.getElementById('refreshIcon');
  if (icon) icon.classList.add('animate-spin');

  try {
    const res = await fetch('/api/admin/users');
    if (!res.ok) throw new Error('Failed to load users');
    allUsers = await res.json();
    
    // Update stats
    const total = allUsers.length;
    const admins = allUsers.filter(u => u.role === 'admin').length;
    const active = allUsers.filter(u => u.is_active !== 0).length;
    
    document.getElementById('totalUsersCount').textContent = total;
    document.getElementById('adminCount').textContent = admins;
    document.getElementById('activeUsersCount').textContent = active;
    document.getElementById('userCountBadge').textContent = `${total} Users`;
    
    filterUsers();
  } catch(e) {
    document.getElementById('usersTable').innerHTML = `
      <div class="p-8 text-center text-xs text-red-400">
        Failed to load users: ${escHtml(e.message)}
      </div>
    `;
  } finally {
    if (icon) setTimeout(() => icon.classList.remove('animate-spin'), 600);
  }
}

function filterUsers() {
  const q = document.getElementById('userSearch')?.value.toLowerCase().trim() || '';
  const role = document.getElementById('roleFilter')?.value || '';
  
  const filtered = allUsers.filter(u => {
    const matchRole = !role || u.role === role;
    const matchSearch = !q ||
      u.username?.toLowerCase().includes(q) ||
      u.email?.toLowerCase().includes(q) ||
      String(u.id).includes(q);
    return matchRole && matchSearch;
  });

  renderUsers(filtered);
}

function renderUsers(users) {
  const container = document.getElementById('usersTable');
  
  if (users.length === 0) {
    container.innerHTML = `
      <div class="p-8 text-center text-xs" style="color:var(--theme-text-muted, #8a8a8a)">
        No users match the search filter.
      </div>
    `;
    return;
  }

  container.innerHTML = `
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b" style="background:var(--theme-bg-secondary, #1a1a1a); border-color:var(--theme-border-subtle, rgba(255,255,255,0.06)); color:var(--theme-text-muted, #8a8a8a)">
            <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">User</th>
            <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Role</th>
            <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Status</th>
            <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider">Registered</th>
            <th class="py-3 px-4 font-medium uppercase text-[10px] tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.04));">
          ${users.map(u => {
            const isAdmin = u.role === 'admin';
            const isActive = u.is_active !== 0;
            return `
              <tr class="hover:bg-[var(--theme-bg-hover,rgba(255,255,255,0.02))] transition-colors">
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 border"
                         style="background:var(--theme-bg-secondary, #212121); border-color:var(--theme-border-subtle, rgba(255,255,255,0.08)); color:var(--theme-text-strong, #fafafa)">
                      ${escHtml((u.username || 'U').substring(0, 2).toUpperCase())}
                    </div>
                    <div class="min-w-0">
                      <div class="font-medium" style="color:var(--theme-text-strong, #fafafa)">
                        ${escHtml(u.username)}
                      </div>
                      <div class="text-[11px] font-mono mt-0.5" style="color:var(--theme-text-muted, #8a8a8a)">
                        ${escHtml(u.email || 'No email')} • #${u.id}
                      </div>
                    </div>
                  </div>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium"
                        style="${isAdmin ? 'background:rgba(99, 102, 241, 0.12); color:#818cf8; border:1px solid rgba(99, 102, 241, 0.2);' : 'background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a); border:1px solid var(--theme-border-subtle);'}">
                    ${isAdmin ? 'Administrator' : 'User'}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-medium"
                        style="${isActive ? 'background:rgba(16, 185, 129, 0.12); color:#34d399; border:1px solid rgba(16, 185, 129, 0.2);' : 'background:rgba(239, 68, 68, 0.12); color:#f87171; border:1px solid rgba(239, 68, 68, 0.2);'}">
                    <span class="w-1.5 h-1.5 rounded-full ${isActive ? 'bg-emerald-400' : 'bg-red-400'}"></span>
                    <span>${isActive ? 'Active' : 'Disabled'}</span>
                  </span>
                </td>
                <td class="py-3 px-4 text-xs font-mono" style="color:var(--theme-text-muted, #8a8a8a)">
                  ${u.created_at ? new Date(u.created_at).toLocaleDateString() : '—'}
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <a href="/admin/users/${u.id}/edit" class="al-btn-secondary text-xs px-2.5 py-1">Edit</a>
                    <button type="button" onclick="deleteUser(${u.id}, '${escHtml(u.username)}')" class="al-btn-danger text-xs px-2.5 py-1">Delete</button>
                  </div>
                </td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    </div>
  `;
}

async function deleteUser(id, username) {
  if (!confirm(`Are you sure you want to delete user "${username}" (#${id})?`)) return;
  try {
    const res = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (res.ok && data.success) {
      loadUsers();
    } else {
      alert('Delete failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

loadUsers();
</script>
