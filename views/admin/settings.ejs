<%- include('../components/header', { title: title || 'System Settings' }) %>

<div class="flex h-screen overflow-hidden">
  <div class="hidden lg:block w-56 h-full shrink-0">
    <%- include('../components/sidebar') %>
  </div>
  <div id="page-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <%- include('../components/ui/breadcrumb', { items: [
      { label: 'Admin', href: '/admin/dashboard' },
      { label: 'Settings' }
    ] }) %>

    <main class="flex-1 p-4 lg:p-6 max-w-6xl w-full mx-auto space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h1 class="al-page-title">System Settings</h1>
          <p class="al-page-desc">Configure KineticMesh platform preferences, authentication, and virtualization defaults.</p>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="saveAllSettings()" id="saveAllBtn" class="al-btn-primary text-xs flex items-center gap-1.5 py-1.5 px-3">
            <%- icon('save', { class: 'size-3.5', strokeWidth: 2 }) %>
            Save All Settings
          </button>
        </div>
      </div>

      <!-- Tab Navigation -->
      <div class="flex gap-1 border-b border-[var(--theme-border)] pb-2 overflow-x-auto no-scrollbar">
        <button type="button" onclick="switchTab('general', this)" class="tab-btn active px-3.5 py-2 rounded-lg text-xs font-medium transition-colors flex items-center gap-2"
                style="color:var(--theme-accent); background:var(--theme-bg-secondary)">
          <%- icon('settings', { class: 'size-3.5', strokeWidth: 2 }) %>
          General
        </button>
        <button type="button" onclick="switchTab('branding', this)" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-medium transition-colors flex items-center gap-2"
                style="color:var(--theme-text-muted)">
          <%- icon('palette', { class: 'size-3.5', strokeWidth: 2 }) %>
          Branding
        </button>
        <button type="button" onclick="switchTab('discord', this)" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-medium transition-colors flex items-center gap-2"
                style="color:var(--theme-text-muted)">
          <%- icon('message-square', { class: 'size-3.5', strokeWidth: 2 }) %>
          Discord OAuth
        </button>
        <button type="button" onclick="switchTab('security', this)" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-medium transition-colors flex items-center gap-2"
                style="color:var(--theme-text-muted)">
          <%- icon('shield', { class: 'size-3.5', strokeWidth: 2 }) %>
          Security
        </button>
        <button type="button" onclick="switchTab('system', this)" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-medium transition-colors flex items-center gap-2"
                style="color:var(--theme-text-muted)">
          <%- icon('server', { class: 'size-3.5', strokeWidth: 2 }) %>
          System & Maintenance
        </button>
      </div>

      <!-- ==================== TAB: GENERAL ==================== -->
      <div id="tab-general" class="tab-panel space-y-6">
        <!-- Site Branding -->
        <div class="al-card">
          <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
            <span style="color:var(--theme-accent)"><%- icon('layout', { class: 'size-4', strokeWidth: 2 }) %></span>
            <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Site Identity</h2>
          </div>
          <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="al-label">Site Name</label>
              <input type="text" class="al-input text-xs" id="setting_site_name" data-key="site_name" placeholder="KineticMesh">
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Primary brand title shown throughout navigation</p>
            </div>
            <div>
              <label class="al-label">Site Description</label>
              <input type="text" class="al-input text-xs" id="setting_site_description" data-key="site_description" placeholder="Virtual Machine Management System">
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Subheading used in auth headers and metadata</p>
            </div>
            <div>
              <label class="al-label">Panel Title</label>
              <input type="text" class="al-input text-xs" id="setting_panel_title" data-key="panel_title" placeholder="KineticMesh V1.0">
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Browser tab window title</p>
            </div>
            <div>
              <label class="al-label">Panel Version Label</label>
              <input type="text" class="al-input text-xs" id="setting_panel_version" data-key="panel_version" placeholder="V1.0">
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Version identifier shown in footer and sidebar</p>
            </div>
          </div>
        </div>

        <!-- Session Configuration -->
        <div class="al-card">
          <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
            <span style="color:var(--theme-accent)"><%- icon('clock', { class: 'size-4', strokeWidth: 2 }) %></span>
            <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Session & Access Defaults</h2>
          </div>
          <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="al-label">Session Timeout (hours)</label>
              <input type="number" class="al-input text-xs" id="setting_session_timeout" data-key="session_timeout" min="1" max="720" placeholder="24">
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Inactivity timeout before automatic re-authentication</p>
            </div>
            <div>
              <label class="al-label">Max Concurrent Sessions</label>
              <input type="number" class="al-input text-xs" id="setting_max_sessions" data-key="max_sessions" min="1" max="100" placeholder="10">
              <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Simultaneous active logins permitted per user</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== TAB: BRANDING ==================== -->
      <div id="tab-branding" class="tab-panel space-y-6 hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 space-y-6">
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('image', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Brand Assets</h2>
              </div>
              <div class="p-4 space-y-4">
                <div>
                  <label class="al-label">Site Icon / Logo URL</label>
                  <input type="text" class="al-input text-xs" id="setting_site_icon_url_branding" data-key="site_icon_url" 
                         placeholder="https://example.com/logo.png or /images/logo.png" oninput="updateBrandPreview()">
                  <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Public URL or internal asset path to the logo (PNG, SVG, JPG)</p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <!-- Live Preview Card -->
            <div class="al-card">
              <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('eye', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Live Preview</h2>
              </div>
              <div class="p-6 flex flex-col items-center justify-center text-center space-y-3" style="background:var(--theme-bg-secondary)">
                <div class="w-14 h-14 rounded-xl border border-[var(--theme-border)] flex items-center justify-center overflow-hidden" 
                     style="background:var(--theme-card-bg)">
                  <img id="previewIcon" src="" class="w-full h-full object-cover hidden" alt="Brand Logo" 
                       onerror="this.classList.add('hidden'); document.getElementById('previewIconFallback').classList.remove('hidden');">
                  <div id="previewIconFallback" class="text-2xl" style="color:var(--theme-accent)">
                    <%- icon('box', { class: 'size-8', strokeWidth: 1.5 }) %>
                  </div>
                </div>
                <div>
                  <div class="font-bold text-sm" id="previewTitle" style="color:var(--theme-text-strong)">KineticMesh</div>
                  <div class="text-xs" id="previewDesc" style="color:var(--theme-text-muted)">Virtual Machine Management System</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== TAB: DISCORD OAUTH ==================== -->
      <div id="tab-discord" class="tab-panel space-y-6 hidden">
        <div class="al-card">
          <div class="p-4 border-b border-[var(--theme-border)] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span style="color:#5865F2"><%- icon('message-square', { class: 'size-4', strokeWidth: 2 }) %></span>
              <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Discord Single Sign-On (OAuth2)</h2>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="discord_enabled" class="sr-only peer" onchange="updateDiscordFormState()">
              <div class="w-9 h-5 bg-gray-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--theme-accent)]"></div>
            </label>
          </div>
          <div class="p-4 space-y-4">
            <p class="text-xs" style="color:var(--theme-text-muted)">
              Allow users to link their Discord profile and sign into KineticMesh with a single click.
            </p>

            <div id="discordCredsSection" class="space-y-4 pt-2">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="al-label">Client ID</label>
                  <input type="text" class="al-input text-xs" id="discord_client_id" placeholder="Discord Application Client ID">
                </div>
                <div>
                  <label class="al-label">Client Secret</label>
                  <input type="password" class="al-input text-xs" id="discord_client_secret" placeholder="Discord Application Client Secret">
                </div>
              </div>

              <div>
                <label class="al-label">OAuth2 Redirect URI</label>
                <input type="text" class="al-input text-xs font-mono" id="discord_redirect_uri" placeholder="https://panel.example.com/auth/discord/callback">
                <p class="text-[11px] mt-1" style="color:var(--theme-text-muted)">Must match the exact Redirect URI configured in the Discord Developer Portal.</p>
              </div>

              <div class="border-t border-[var(--theme-border)] pt-4 mt-4">
                <h3 class="text-xs font-semibold mb-3" style="color:var(--theme-text-strong)">Bot & Guild Sync (Optional)</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label class="al-label">Bot Token</label>
                    <input type="password" class="al-input text-xs" id="discord_bot_token" placeholder="Bot Token">
                  </div>
                  <div>
                    <label class="al-label">Guild ID (Server ID)</label>
                    <input type="text" class="al-input text-xs" id="discord_guild_id" placeholder="123456789012345678">
                  </div>
                  <div>
                    <label class="al-label">Auto-Role ID</label>
                    <input type="text" class="al-input text-xs" id="discord_auto_role_id" placeholder="Role ID for new users">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Discord Setup Instructions -->
        <div class="al-card p-4 space-y-2 border-l-4" style="border-left-color: #5865F2;">
          <div class="text-xs font-semibold" style="color:var(--theme-text-strong)">Discord OAuth Setup Guide</div>
          <ol class="text-xs list-decimal list-inside space-y-1" style="color:var(--theme-text-muted)">
            <li>Open the <a href="https://discord.com/developers/applications" target="_blank" class="underline hover:text-[var(--theme-accent)]">Discord Developer Portal</a> and create or select an Application.</li>
            <li>Navigate to <strong>OAuth2 &rarr; General</strong> and copy the <strong>Client ID</strong> and <strong>Client Secret</strong>.</li>
            <li>Add the <strong>Redirect URI</strong> matching the field above (e.g. <code class="px-1 py-0.5 rounded bg-[var(--theme-bg-secondary)]">https://your-domain.com/auth/discord/callback</code>).</li>
            <li>Save changes in both Discord and KineticMesh.</li>
          </ol>
        </div>
      </div>

      <!-- ==================== TAB: SECURITY ==================== -->
      <div id="tab-security" class="tab-panel space-y-6 hidden">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="al-card p-4 space-y-2">
            <span style="color:var(--theme-success)"><%- icon('lock', { class: 'size-5', strokeWidth: 2 }) %></span>
            <div class="text-xs font-semibold" style="color:var(--theme-text-strong)">Session Authentication</div>
            <p class="text-[11px]" style="color:var(--theme-text-muted)">bcrypt hashing with secure cookie-backed express session isolation.</p>
          </div>
          <div class="al-card p-4 space-y-2">
            <span style="color:var(--theme-accent)"><%- icon('users', { class: 'size-5', strokeWidth: 2 }) %></span>
            <div class="text-xs font-semibold" style="color:var(--theme-text-strong)">Role-Based Access (RBAC)</div>
            <p class="text-[11px]" style="color:var(--theme-text-muted)">Strict administrator vs standard user privilege enforcement across all API endpoints.</p>
          </div>
          <div class="al-card p-4 space-y-2">
            <span style="color:var(--theme-warning)"><%- icon('shield-check', { class: 'size-5', strokeWidth: 2 }) %></span>
            <div class="text-xs font-semibold" style="color:var(--theme-text-strong)">VM Ownership Boundary</div>
            <p class="text-[11px]" style="color:var(--theme-text-muted)">Users are isolated exclusively to VMs assigned to their account ID.</p>
          </div>
        </div>
      </div>

      <!-- ==================== TAB: SYSTEM & MAINTENANCE ==================== -->
      <div id="tab-system" class="tab-panel space-y-6 hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- System Information -->
          <div class="al-card">
            <div class="p-4 border-b border-[var(--theme-border)] flex items-center gap-2">
              <span style="color:var(--theme-accent)"><%- icon('info', { class: 'size-4', strokeWidth: 2 }) %></span>
              <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Platform Architecture</h2>
            </div>
            <div class="p-4 divide-y divide-[var(--theme-border)] text-xs">
              <div class="flex justify-between py-2.5">
                <span style="color:var(--theme-text-muted)">Hypervisor</span>
                <span class="font-medium" style="color:var(--theme-text-strong)">QEMU / KVM</span>
              </div>
              <div class="flex justify-between py-2.5">
                <span style="color:var(--theme-text-muted)">Core Framework</span>
                <span class="font-medium" style="color:var(--theme-text-strong)">Node.js + Express.js</span>
              </div>
              <div class="flex justify-between py-2.5">
                <span style="color:var(--theme-text-muted)">Database</span>
                <span class="font-medium" style="color:var(--theme-text-strong)">SQLite3</span>
              </div>
              <div class="flex justify-between py-2.5">
                <span style="color:var(--theme-text-muted)">Cloud-Init Engine</span>
                <span class="al-badge-online text-[10px] px-2 py-0.5">Enabled</span>
              </div>
            </div>
          </div>

          <!-- Live Telemetry -->
          <div class="al-card">
            <div class="p-4 border-b border-[var(--theme-border)] flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span style="color:var(--theme-accent)"><%- icon('activity', { class: 'size-4', strokeWidth: 2 }) %></span>
                <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)">Live Telemetry</h2>
              </div>
              <button type="button" onclick="loadSystemStats()" class="al-btn-secondary text-[11px] py-1 px-2.5 flex items-center gap-1">
                <%- icon('refresh-cw', { class: 'size-3', strokeWidth: 2 }) %>
                Refresh
              </button>
            </div>
            <div class="p-4 divide-y divide-[var(--theme-border)] text-xs" id="systemLiveStats">
              <div class="py-4 text-center" style="color:var(--theme-text-muted)">Loading platform telemetry...</div>
            </div>
          </div>
        </div>

        <!-- Danger Zone -->
        <div class="al-card border border-red-500/30">
          <div class="p-4 border-b border-red-500/20 flex items-center gap-2">
            <span class="text-red-500"><%- icon('alert-triangle', { class: 'size-4', strokeWidth: 2 }) %></span>
            <h2 class="text-sm font-semibold text-red-500">Danger Zone</h2>
          </div>
          <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="text-xs font-semibold" style="color:var(--theme-text-strong)">Emergency Mass Stop</div>
              <p class="text-[11px]" style="color:var(--theme-text-muted)">Send ACPI / forceful stop signals to all active virtual machines across the cluster.</p>
            </div>
            <button type="button" onclick="stopAllVMs()" class="al-btn-danger text-xs flex items-center gap-1.5 py-1.5 px-3 shrink-0">
              <%- icon('power', { class: 'size-3.5', strokeWidth: 2 }) %>
              Stop All VMs
            </button>
          </div>
        </div>
      </div>
    </main>

    <%- include('../components/bottomNav') %>
  </div>
</div>

<script>
function switchTab(tab, btn) {
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.classList.remove('active');
    b.style.color = 'var(--theme-text-muted)';
    b.style.background = 'transparent';
  });
  if (btn) {
    btn.classList.add('active');
    btn.style.color = 'var(--theme-accent)';
    btn.style.background = 'var(--theme-bg-secondary)';
  }

  document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
  const target = document.getElementById(`tab-${tab}`);
  if (target) target.classList.remove('hidden');

  if (tab === 'system') loadSystemStats();
  if (tab === 'discord') loadDiscordSettings();
}

function updateBrandPreview() {
  const name = document.getElementById('setting_site_name')?.value || 'KineticMesh';
  const desc = document.getElementById('setting_site_description')?.value || 'Virtual Machine Management System';
  const icon = document.getElementById('setting_site_icon_url_branding')?.value || '';

  const pt = document.getElementById('previewTitle');
  const pd = document.getElementById('previewDesc');
  const pi = document.getElementById('previewIcon');
  const pif = document.getElementById('previewIconFallback');

  if (pt) pt.textContent = name;
  if (pd) pd.textContent = desc;

  if (icon) {
    if (pi) {
      pi.src = icon;
      pi.classList.remove('hidden');
    }
    if (pif) pif.classList.add('hidden');
  } else {
    if (pi) pi.classList.add('hidden');
    if (pif) pif.classList.remove('hidden');
  }
}

async function loadSettings() {
  try {
    const res = await fetch('/api/settings');
    if (!res.ok) return;
    const settings = await res.json();
    Object.entries(settings).forEach(([key, val]) => {
      const els = document.querySelectorAll(`[data-key="${key}"]`);
      els.forEach(el => { if (el) el.value = val || ''; });
    });
    updateBrandPreview();
  } catch (err) {
    console.error('Failed to load settings:', err);
  }
}

async function loadDiscordSettings() {
  try {
    const res = await fetch('/api/admin/discord-settings');
    if (!res.ok) return;
    const d = await res.json();
    const enabledEl = document.getElementById('discord_enabled');
    if (enabledEl) enabledEl.checked = !!d.enabled;
    const fields = {
      discord_client_id: d.client_id,
      discord_client_secret: d.client_secret,
      discord_redirect_uri: d.redirect_uri,
      discord_bot_token: d.bot_token,
      discord_guild_id: d.guild_id,
      discord_auto_role_id: d.auto_role_id
    };
    Object.entries(fields).forEach(([id, v]) => {
      const el = document.getElementById(id);
      if (el) el.value = v || '';
    });
    updateDiscordFormState();
  } catch (err) {
    console.error('Failed to load Discord settings:', err);
  }
}

function updateDiscordFormState() {
  const enabled = document.getElementById('discord_enabled')?.checked;
  const section = document.getElementById('discordCredsSection');
  if (section) {
    section.style.opacity = enabled ? '1' : '0.4';
    section.style.pointerEvents = enabled ? 'auto' : 'none';
  }
}

async function loadSystemStats() {
  const container = document.getElementById('systemLiveStats');
  if (!container) return;
  try {
    const res = await fetch('/api/vms');
    const vms = res.ok ? await res.json() : [];
    const running = vms.filter(v => v.status === 'running').length;
    const stopped = vms.length - running;

    container.innerHTML = `
      <div class="flex justify-between py-2.5">
        <span style="color:var(--theme-text-muted)">Total Deployed VMs</span>
        <span class="font-medium" style="color:var(--theme-text-strong)">${vms.length}</span>
      </div>
      <div class="flex justify-between py-2.5">
        <span style="color:var(--theme-text-muted)">Running Virtual Machines</span>
        <span class="font-medium text-emerald-400">${running}</span>
      </div>
      <div class="flex justify-between py-2.5">
        <span style="color:var(--theme-text-muted)">Offline / Suspended</span>
        <span class="font-medium" style="color:var(--theme-text-muted)">${stopped}</span>
      </div>
      <div class="flex justify-between py-2.5">
        <span style="color:var(--theme-text-muted)">Panel Service</span>
        <span class="al-badge-online text-[10px] px-2 py-0.5">Online</span>
      </div>
    `;
  } catch (e) {
    container.innerHTML = `<div class="py-4 text-center text-red-400">Failed to load system stats</div>`;
  }
}

async function saveAllSettings() {
  const btn = document.getElementById('saveAllBtn');
  const origHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `<svg class="animate-spin size-3.5 mr-1" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Saving...`;

  try {
    const settings = {};
    document.querySelectorAll('[data-key]').forEach(el => {
      const k = el.getAttribute('data-key');
      if (k && el.value !== undefined) settings[k] = el.value;
    });

    if (Object.keys(settings).length > 0) {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(settings)
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.errors ? data.errors.map(e => e.error).join(', ') : 'Failed to save general settings');
      }
    }

    // Save Discord Settings
    const enabled = document.getElementById('discord_enabled')?.checked || false;
    const clientId = document.getElementById('discord_client_id')?.value.trim() || '';
    const clientSecret = document.getElementById('discord_client_secret')?.value.trim() || '';
    const redirectUri = document.getElementById('discord_redirect_uri')?.value.trim() || '';

    if (enabled && (!clientId || !clientSecret || !redirectUri)) {
      throw new Error('Client ID, Client Secret, and Redirect URI are required when Discord OAuth is enabled');
    }

    const discordRes = await fetch('/api/admin/discord-settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        enabled,
        client_id: clientId,
        client_secret: clientSecret,
        redirect_uri: redirectUri,
        bot_token: document.getElementById('discord_bot_token')?.value.trim() || '',
        guild_id: document.getElementById('discord_guild_id')?.value.trim() || '',
        auto_role_id: document.getElementById('discord_auto_role_id')?.value.trim() || ''
      })
    });

    const discordData = await discordRes.json();
    if (!discordRes.ok || !discordData.success) {
      throw new Error(discordData.error || 'Failed to save Discord settings');
    }

    if (window.toast) toast.success('All settings saved successfully');
  } catch (err) {
    if (window.toast) toast.error(err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = origHtml;
  }
}

async function stopAllVMs() {
  if (!confirm('Are you sure you want to stop ALL running virtual machines?')) return;
  try {
    const res = await fetch('/api/vms');
    const vms = await res.json();
    const running = vms.filter(v => v.status === 'running');
    if (running.length === 0) {
      if (window.toast) toast.info('No running VMs to stop');
      return;
    }
    let stopped = 0;
    for (const vm of running) {
      try {
        await fetch(`/api/vms/${vm.vm_id}/stop`, { method: 'POST' });
        stopped++;
      } catch (e) {}
    }
    if (window.toast) toast.success(`Sent stop signal to ${stopped} VM(s)`);
    loadSystemStats();
  } catch (err) {
    if (window.toast) toast.error('Error stopping VMs: ' + err.message);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadSettings();
  loadDiscordSettings();
  ['setting_site_name', 'setting_site_description', 'setting_site_icon_url_branding'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', updateBrandPreview);
  });
});
