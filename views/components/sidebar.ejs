<!-- Sidebar (Airlink Visual Language) -->
<%
  const currentPath = (typeof req !== 'undefined' && req.path) ? req.path : (typeof currentPage !== 'undefined' ? '/' + currentPage : '');
  const currentUser = (typeof user !== 'undefined' && user) ? user : null;
  const isAdmin = currentUser && (currentUser.role === 'admin' || currentUser.isAdmin === true);
  const panelTitle = (typeof settings !== 'undefined' && settings.title) ? settings.title : (typeof siteName !== 'undefined' ? siteName : 'KineticMesh');
  const panelLogo = (typeof settings !== 'undefined' && settings.logo) ? settings.logo : (typeof siteLogo !== 'undefined' ? siteLogo : '/public/images/logo.png');
%>

<div id="pc-sidebar" class="sidebar hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-56 lg:flex-col left-0 border-r"
  style="background:var(--theme-nav-bg, #1a1a1a); border-color:var(--theme-border, rgba(255,255,255,0.1));">
  <div class="flex flex-col h-full">

    <!-- Static top: logo -->
    <div id="sidebar-logo-block" class="px-4 py-3.5 flex items-center min-w-0 shrink-0 border-b"
      style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
      <a href="/" class="flex items-center min-w-0 gap-2.5">
        <img src="<%= panelLogo %>" alt="Logo"
          class="h-8 w-8 rounded-xl shrink-0 p-1 object-contain"
          style="background:var(--theme-logo-bg, rgba(255,255,255,0.06)); border:1px solid var(--theme-border-subtle, rgba(255,255,255,0.1));">
        <span class="font-medium tracking-tight text-[15px] truncate"
          style="color:var(--theme-text-strong, #fafafa);">
          <%= panelTitle %>
        </span>
      </a>
    </div>

    <!-- User profile summary -->
    <% if (currentUser) { %>
      <a href="/profile" id="sidebar-account-link"
        class="flex items-center space-x-3 py-2.5 px-4 border-b shrink-0 transition-colors group hover:bg-[var(--theme-bg-hover)]"
        style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
        <div class="h-8 w-8 rounded-xl shrink-0 flex items-center justify-center font-medium text-xs text-[var(--theme-text-strong)]"
             style="background:var(--theme-bg-input, rgba(255,255,255,0.08)); border:1px solid var(--theme-border, rgba(255,255,255,0.1));">
          <%= (currentUser.username || 'U').substring(0, 2).toUpperCase() %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-[13px] font-medium truncate flex items-center justify-between" style="color:var(--theme-text-strong, #fafafa);">
            <span class="truncate"><%= currentUser.username %></span>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono uppercase"
                  style="background:var(--theme-bg-secondary, #212121); color:var(--theme-text-muted, #8a8a8a); border:1px solid var(--theme-border-subtle);">
              <%= currentUser.role || 'user' %>
            </span>
          </p>
          <p class="text-[11px] truncate mt-0.5" style="color:var(--theme-text-muted, #8a8a8a);">
            Account Settings
          </p>
        </div>
      </a>
    <% } %>

    <!-- Scrollable Navigation -->
    <nav class="flex-1 overflow-y-auto px-2 py-3 space-y-4">
      <!-- Main Menu -->
      <div>
        <p class="px-3 text-[11px] font-medium uppercase tracking-wider mb-1.5" style="color:var(--theme-text-muted, #8a8a8a);">
          Platform
        </p>
        <ul role="list" class="space-y-1">
          <li>
            <a href="/dashboard"
               class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= (currentPath === '/dashboard' || currentPath === '/') ? 'font-semibold' : '' %>"
               style="<%= (currentPath === '/dashboard' || currentPath === '/') ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
              <%- icon('layout-dashboard', { class: 'w-4 h-4 shrink-0' }) %>
              <span>Dashboard</span>
            </a>
          </li>
          <li>
            <a href="/vms"
               class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath.startsWith('/vm') && !currentPath.startsWith('/admin') ? 'font-semibold' : '' %>"
               style="<%= currentPath.startsWith('/vm') && !currentPath.startsWith('/admin') ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
              <%- icon('server', { class: 'w-4 h-4 shrink-0' }) %>
              <span>Virtual Machines</span>
            </a>
          </li>
          <li>
            <a href="/profile"
               class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath === '/profile' ? 'font-semibold' : '' %>"
               style="<%= currentPath === '/profile' ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
              <%- icon('user', { class: 'w-4 h-4 shrink-0' }) %>
              <span>Account</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Admin Panel Menu -->
      <% if (isAdmin) { %>
        <div class="pt-2 border-t" style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06));">
          <p class="px-3 text-[11px] font-medium uppercase tracking-wider mb-1.5" style="color:var(--theme-text-muted, #8a8a8a);">
            Administration
          </p>
          <ul role="list" class="space-y-1">
            <li>
              <a href="/admin/dashboard"
                 class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath === '/admin/dashboard' ? 'font-semibold' : '' %>"
                 style="<%= currentPath === '/admin/dashboard' ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
                <%- icon('gauge', { class: 'w-4 h-4 shrink-0' }) %>
                <span>Overview</span>
              </a>
            </li>
            <li>
              <a href="/admin/vms"
                 class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath === '/admin/vms' ? 'font-semibold' : '' %>"
                 style="<%= currentPath === '/admin/vms' ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
                <%- icon('layers', { class: 'w-4 h-4 shrink-0' }) %>
                <span>All Virtual Machines</span>
              </a>
            </li>
            <li>
              <a href="/admin/vm/create"
                 class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath === '/admin/vm/create' ? 'font-semibold' : '' %>"
                 style="<%= currentPath === '/admin/vm/create' ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
                <%- icon('plus-circle', { class: 'w-4 h-4 shrink-0' }) %>
                <span>Deploy VM</span>
              </a>
            </li>
            <li>
              <a href="/admin/users"
                 class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath.startsWith('/admin/user') ? 'font-semibold' : '' %>"
                 style="<%= currentPath.startsWith('/admin/user') ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
                <%- icon('users', { class: 'w-4 h-4 shrink-0' }) %>
                <span>Users</span>
              </a>
            </li>
            <li>
              <a href="/admin/templates"
                 class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath.startsWith('/admin/template') ? 'font-semibold' : '' %>"
                 style="<%= currentPath.startsWith('/admin/template') ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
                <%- icon('disc', { class: 'w-4 h-4 shrink-0' }) %>
                <span>Templates & ISOs</span>
              </a>
            </li>
            <li>
              <a href="/admin/settings"
                 class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-150 <%= currentPath === '/admin/settings' ? 'font-semibold' : '' %>"
                 style="<%= currentPath === '/admin/settings' ? 'background:var(--theme-bg-active-nav, rgba(255,255,255,0.1)); color:var(--theme-text-strong, #fafafa);' : 'color:var(--theme-text, #e0e0e0);' %>">
                <%- icon('settings', { class: 'w-4 h-4 shrink-0' }) %>
                <span>Settings</span>
              </a>
            </li>
          </ul>
        </div>
      <% } %>
    </nav>

    <!-- Bottom Controls -->
    <div class="px-4 py-3 border-t flex items-center justify-between shrink-0"
         style="border-color:var(--theme-border-subtle, rgba(255,255,255,0.06)); background:var(--theme-bg-secondary, #1e1e1e);">
      <button type="button" onclick="document.documentElement.classList.toggle('dark')"
              class="p-1.5 rounded-lg text-[var(--theme-text-muted)] hover:text-[var(--theme-text-strong)] hover:bg-[var(--theme-bg-hover)] transition-colors"
              title="Toggle theme">
        <%- icon('sun', { class: 'w-4 h-4 hidden dark:block' }) %>
        <%- icon('moon', { class: 'w-4 h-4 block dark:hidden' }) %>
      </button>

      <a href="/logout"
         class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-[var(--theme-text-muted)] hover:text-red-400 hover:bg-red-500/10 transition-colors"
         title="Sign out">
        <%- icon('log-out', { class: 'w-4 h-4' }) %>
        <span>Sign out</span>
      </a>
    </div>

  </div>
</div>