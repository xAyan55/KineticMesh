<!DOCTYPE html>
<html class="h-full js-loading" lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <title><%= (typeof settings !== 'undefined' && settings.title) ? settings.title : (typeof siteName !== 'undefined' ? siteName : 'KineticMesh') %> - <%= typeof title !== 'undefined' ? title : 'Panel' %></title>
    <script>
      (function(){
        document.documentElement.classList.add('dark');
      })();
    </script>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/styles/layout-animations.css">
    <link rel="stylesheet" href="/styles/motion.css">
    <link rel="icon" href="<%= (typeof settings !== 'undefined' && settings.favicon) ? settings.favicon : (typeof siteLogo !== 'undefined' ? siteLogo : '/public/images/logo.png') %>" type="image/png">
    
    <!-- Default Airlink themes -->
    <link rel="stylesheet" href="/themes/default-light.css">
    <link rel="stylesheet" href="/themes/default-dark.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <% if (Array.isArray(typeof extraStyles !== 'undefined' ? extraStyles : undefined)) { %>
      <% for (const stylesheet of extraStyles) { %>
    <link rel="stylesheet" href="<%= stylesheet %>">
      <% } %>
    <% } %>

    <!-- Shared UI scripts -->
    <script defer src="/javascript/shared/al-icon.js"></script>
    <script defer src="/javascript/shared/layout-animations.js"></script>
    <script defer src="/javascript/shared/al-tabs.js"></script>
    <script defer src="/javascript/shared/al-dialog.js"></script>
    <script defer src="/javascript/shared/al-action.js"></script>

    <style>
      * { scrollbar-width: thin; scrollbar-color: var(--theme-border) transparent; }
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      html, body { 
        transition: background-color 0.2s ease-in, color 0.2s ease-in; 
        background: var(--theme-bg, #161616); 
        color: var(--theme-text, #e0e0e0); 
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      body { 
        padding-top: env(safe-area-inset-top);
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
      }
      @media (max-width: 1023px) {
        #page-content { padding-bottom: 70px; padding-top: 56px; }
      }
    </style>
</head>
<body class="h-full">
<a href="#page-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[99999] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--theme-text-strong)] focus:text-[var(--theme-bg)] focus:text-sm focus:font-medium focus:shadow-lg">Skip to main content</a>

<script src="/javascript/shared/theme-init.js"></script>
<%- include("./bottomNav") %>
<%- include("./modal") %>
<script src="/javascript/shared/toast-store.js"></script>
<%- include("./toast") %>
<script src="/javascript/shared/escape.js"></script>
