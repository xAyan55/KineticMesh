<%- include('components/header', { title: 'License Activation' }) %>

<div class="min-h-screen flex flex-col items-center justify-center p-4" style="background:var(--theme-bg, #111111)">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-2">
      <div class="inline-flex p-3 rounded-2xl border border-[var(--theme-border)]" style="background:var(--theme-bg-secondary)">
        <%- icon('shield-check', { class: 'size-8 text-[var(--theme-accent)]', strokeWidth: 1.5 }) %>
      </div>
      <h1 class="text-xl font-bold" style="color:var(--theme-text-strong)"><%= siteName || 'KineticMesh' %></h1>
      <p class="text-xs" style="color:var(--theme-text-muted)">License Activation</p>
    </div>

    <div class="al-card p-6 space-y-4">
      <div class="p-3.5 rounded-xl border border-emerald-500/20 bg-emerald-500/10 flex items-start gap-2.5">
        <span class="text-emerald-400 mt-0.5"><%- icon('check-circle', { class: 'size-4', strokeWidth: 2 }) %></span>
        <div class="text-xs space-y-0.5">
          <div class="font-semibold text-emerald-400">Open-Source Edition</div>
          <p style="color:var(--theme-text-muted)">This panel runs on open-source licensing. No activation key is required.</p>
        </div>
      </div>

      <div class="pt-2">
        <a href="/login" class="al-btn-primary w-full text-xs py-2.5 flex items-center justify-center gap-2">
          <%- icon('arrow-right', { class: 'size-3.5', strokeWidth: 2 }) %>
          Proceed to Login
        </a>
      </div>
    </div>
  </div>
</div>
